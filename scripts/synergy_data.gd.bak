class_name SynergyData

const ELEMENT_SYNERGIES = {
	0: {"2x": {"dmg_mult": 1.15, "desc": "15% Damage"}, "3x": {"dmg_mult": 1.30, "desc": "30% Damage"}},
	1: {"2x": {"def_mult": 1.15, "desc": "15% Defense"}, "3x": {"def_mult": 1.30, "desc": "30% Defense"}},
	2: {"2x": {"hp_mult": 1.10, "desc": "10% HP"}, "3x": {"hp_mult": 1.20, "desc": "20% HP"}},
	3: {"2x": {"spd_mult": 1.15, "desc": "15% Speed"}, "3x": {"spd_mult": 1.30, "desc": "30% Speed"}},
	4: {"2x": {"crit": 0.25, "desc": "+25% Crit"}, "3x": {"crit": 0.50, "desc": "+50% Crit"}},
	5: {"2x": {"dmg_mult": 1.10, "desc": "10% Damage"}, "3x": {"dmg_mult": 1.20, "desc": "20% Damage"}}
}

const TRAIT_SYNERGIES = {
	0: {"2x": {"def_mult": 1.15, "desc": "15% Defense"}, "3x": {"def_mult": 1.35, "desc": "35% Defense"}},
	1: {"2x": {"int_mult": 1.15, "desc": "15% Magic Power"}, "3x": {"int_mult": 1.35, "desc": "35% Magic Power"}},
	2: {"2x": {"dmg_mult": 1.15, "desc": "15% Damage"}, "3x": {"dmg_mult": 1.35, "desc": "35% Damage"}},
	3: {"2x": {"rng_mult": 1.20, "desc": "+20% Range"}, "3x": {"rng_mult": 1.40, "desc": "+40% Range"}},
	4: {"2x": {"heal_mult": 1.20, "desc": "+20% Healing"}, "3x": {"heal_mult": 1.50, "desc": "+50% Healing"}}
}

static func get_element_color(elem):
	match elem:
		1: return Color(1.0, 0.45, 0.1)
		2: return Color(0.3, 0.7, 1.0)
		3: return Color(0.75, 0.55, 0.25)
		4: return Color(0.75, 1.0, 1.0)
		5: return Color(1.0, 1.0, 0.25)
		_: return Color(0.85, 0.85, 0.92)

static func get_trait_color(trait):
	match trait:
		0: return Color(0.8, 0.2, 0.2)
		1: return Color(0.5, 0.3, 1.0)
		2: return Color(1.0, 0.7, 0.2)
		3: return Color(0.2, 0.8, 0.2)
		4: return Color(1.0, 0.8, 0.3)
		_: return Color(0.7, 0.7, 0.7)

static func get_trait_name(trait):
	match trait:
		0: return "Tank"
		1: return "Mage"
		2: return "Fighter"
		3: return "Ranged"
		4: return "Healer"
		_: return "Unknown"

static func get_element_name(element):
	match element:
		0: return "Normal"
		1: return "Fire"
		2: return "Water"
		3: return "Earth"
		4: return "Air"
		5: return "Lightning"
		_: return "Unknown"
