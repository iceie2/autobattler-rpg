func _on_shop_screen_reroll() -> void:
	var cost := _shop_screen.current_reroll_cost()
	if not game_state.spend_gold(cost):
		info_label.text = "Not enough gold to reroll."
		_shop_screen.purchase_rejected("Not enough gold to reroll.")
		return
	_shop_stock = ShopGenerator.roll_stock(game_state.battle_round, _relic_inventory.owned_ids())
	_telemetry_decision("merchant_stock_rerolled", {
		"cost": cost, "stock_size": _shop_stock.size()})
	_shop_screen.set_stock(game_state.gold, _shop_stock)
	update_ui()

func _merchant_service_context() -> Dictionary:
	var heroes: Array = []
	for unit in player_units + bench_units:
		if is_instance_valid(unit) and not unit in heroes: heroes.append(unit)
	return {"items": _equipment_inventory.items.duplicate(), "heroes": heroes,
		"round": game_state.battle_round, "gold": game_state.gold,
		"supplies_pending": bool(_run_flags.get("merchant_supplies", false))}

func _on_merchant_service(kind: String, target: Variant, modifier: String) -> void:
	if not _shop_screen.visible or not kind in ["exchange", "enchant"]:
		return
	var rarity := 0
	if kind in ["exchange", "enchant"]:
		if not target is EquipmentItem or not _equipment_inventory.items.has(target):
			_shop_screen.services.report("That item is no longer in your bag. No gold spent.")
			return
		rarity = target.rarity
	var price := MerchantServices.cost(kind, game_state.battle_round, rarity)
	if game_state.gold < price:
		_shop_screen.services.report("Not enough gold. Nothing changed.")
		return
	var result: EquipmentItem
	if kind == "exchange": result = MerchantServices.exchange(target, game_state.battle_round)
	if kind == "enchant": result = MerchantServices.enchant(target, modifier)
	if result == null:
		_shop_screen.services.report("Choose an available modifier. No gold spent.")
		return
	if not game_state.spend_gold(price): return
	var message := ""
	match kind:
		"exchange", "enchant":
			# Replace atomically in the same bag slot; even a full bag is valid.
			# Do not auto-combine away the result before the player can inspect it.
			var index: int = _equipment_inventory.items.find(target)
			_equipment_inventory.items[index] = result
			_equipment_inventory.inventory_changed.emit()
			message = "Received %s (%s). Inspect it in your bag or the selection above." % [result.name, result.get_rarity_name()]
	_shop_screen.refresh(game_state.gold)
	_shop_screen.services.report(message)
	_shop_screen._keeper_react()
	_telemetry_decision("merchant_service", {"kind": kind, "price": price})
	update_ui()
	save_run()

func _camp_context() -> Dictionary:
	var context := _merchant_service_context()
	context["actions"] = int(_run_flags.get("camp_actions", 0))
	context["history"] = _run_flags.get("camp_history", [])
	context["supplies_count"] = int(_run_flags.get("camp_supplies", 0)) + int(bool(_run_flags.get("merchant_supplies", false)))
	return context

func _on_camp_activity(kind: String, target: Variant, _modifier: String) -> void:
	if not _camp_screen.visible or not bool(_run_flags.get("camp_active", false)):
		return
	if int(_run_flags.get("camp_actions", 0)) <= 0 or not kind in ["rest", "training", "reforge", "supplies"]:
		_camp_screen.refresh("No actions remaining. Leave camp when ready.")
		return
	var context := _camp_context()
	if kind == "training":
		if not is_instance_valid(target) or not target in context["heroes"] or target.level >= Progression.hero_level_cap():
			_camp_screen.refresh("Choose a hero below the level cap. No action used.")
			return
	if kind == "reforge" and (not target is EquipmentItem or not _equipment_inventory.items.has(target)):
		_camp_screen.refresh("Choose an item currently in your bag. No action used.")
		return
	if kind == "rest" and context["heroes"].is_empty():
		_camp_screen.refresh("There are no heroes to rest. No action used.")
		return
	var result: EquipmentItem
	if kind == "reforge":
		result = MerchantServices.reforge(target, game_state.battle_round)
		if result == null:
			_camp_screen.refresh("That item cannot be reforged. No action used.")
			return
	var message := ""
	match kind:
		"rest":
			for hero in context["heroes"]:
				hero.current_hp = mini(hero.max_hp, hero.current_hp + maxi(1, roundi(hero.max_hp * Balance.CAMP_REST_HP_FRACTION)))
				# VD-23: mana is a run resource now, so resting restores it too.
				hero.current_mana = mini(hero.max_mana, hero.current_mana + maxi(1, roundi(hero.max_mana * Balance.CAMP_REST_MANA_FRACTION)))
			message = "Rested: restored 50% of maximum HP and mana to each hero."
		"training":
			var xp := MerchantServices.training_xp(target)
			target.grant_xp(xp)
			message = "%s gained %d XP." % [target.unit_name, xp]
		"reforge":
			var index: int = _equipment_inventory.items.find(target)
			_equipment_inventory.items[index] = result
			_equipment_inventory.inventory_changed.emit()
			message = "Reforged %s. Inspect the new stats above." % result.name
		"supplies":
			_run_flags["camp_supplies"] = int(_run_flags.get("camp_supplies", 0)) + 1
			message = "Supplies ready: +%d%% ATK and MAG next battle." % (10 * (int(_run_flags["camp_supplies"]) + int(bool(_run_flags.get("merchant_supplies", false)))))
	_run_flags["camp_actions"] = int(_run_flags["camp_actions"]) - 1
	var history: Array = _run_flags.get("camp_history", [])
	history.append(message)
	_run_flags["camp_history"] = history
	_camp_screen.refresh(message)
	update_team_health_bars()
	update_ui()
	_telemetry_decision("camp_activity", {"kind": kind, "actions_left": _run_flags["camp_actions"]})
	save_run()
	if kind == "training" and target.perk_points > 0:
		_camp_screen.visible = false
		_level_up_screen.present([target])
		await _level_up_screen.all_done
		_camp_screen.open()
		save_run()

func _on_camp_closed() -> void:
	_run_flags.erase("camp_active")
	update_ui()
	save_run()
	await _present_pending_perks()
	_open_run_map()

func _on_shop_closed() -> void:
	update_ui()
	save_run()
	# Leaving a merchant NODE returns to the map (it cost you no wave); leaving
	# the scheduled prep-phase shop just drops you back into prep.
	if _shop_from_map:
		_shop_from_map = false
		await _present_pending_perks()
		_open_run_map()

# Levels from _grant_skipped_wave_rewards leave perk points behind; pick them on
# the way back to the map instead of after the next fight (events already do
# this in _on_event_resolved). Returns synchronously when nothing is pending.
func _present_pending_perks() -> void:
	var leveled: Array = player_units.filter(
		func(u): return u and is_instance_valid(u) and u.perk_points > 0)
	if not leveled.is_empty():
		_level_up_screen.present(leveled)
		await _level_up_screen.all_done

func _on_spawn_hero_pressed() -> void:
	if not shop_open:
		info_label.text = "Shop is closed!"
		return
	# Cancel doesn't discard your paid roll anymore (2026-07-24 user request):
	# if you already rolled this prep phase and just backed out to check your
	# field/bag, pressing Buy Hero again re-shows those SAME 3 offers for free
	# instead of charging you again or silently re-rolling. Only a genuinely
	# fresh roll (no pending offer) charges HERO_COST. clear_offers() (called
	# from _on_hero_chosen and on prep-phase start) is what ends a pending
	# roll, so it can't be reused across a pick or into the next round.
	if _hero_shop.has_pending_offer():
		_hero_shop.reopen(game_state.gold)
		return
	if not game_state.spend_gold(HeroShop.HERO_COST):
		info_label.text = "Not enough gold! Need %d gold." % HeroShop.HERO_COST
		return
	var shop_slots: int = 3 + (_relic_inventory.shop_slot_bonus() if _relic_inventory else 0)
	_hero_shop.favored_verbs = _relic_inventory.seed_verbs() if _relic_inventory else []
	_hero_shop.owned_classes = _owned_hero_classes()
	_hero_shop.open(game_state.gold, shop_slots)
	update_ui()

func _apply_progression_bonuses(unit: VisualUnit) -> void:
	# 2026-08-01: every stat below now sums its tier-1 AND tier-2 (independent
	# second copy, see progression.gd's "_2" upgrade family) upgrade levels —
	# the two tracks stack additively rather than one extending the other.
	var hp_bonus: int = Progression.get_bonus("team_hp") + Progression.get_bonus("team_hp_2")
	if hp_bonus > 0:
		unit.max_hp += hp_bonus
		unit.current_hp += hp_bonus

	# Stat tree (2026-07-10) — same "apply once at recruit time" shape as
	# team_hp above. elemental_attunement is the one exception: it's read live
	# from UnitFactory.natural_aspect() instead of applied here, since that's
	# a multiplier computed fresh every time a skill fires, not a base stat.
	var mana_bonus: int = Progression.get_bonus("mana_well") + Progression.get_bonus("mana_well_2")
	if mana_bonus > 0:
		unit.max_mana += mana_bonus
		unit.current_mana += mana_bonus
	unit.magic_power    += Progression.get_bonus("spellpower") + Progression.get_bonus("spellpower_2")
	unit.attack_damage   += Progression.get_bonus("might") + Progression.get_bonus("might_2")
	unit.resistance       += Progression.get_bonus("bulwark") + Progression.get_bonus("bulwark_2")   # defense split 2026-07-16
	unit.magic_resist     += Progression.get_bonus("warding") + Progression.get_bonus("warding_2")
	unit.attack_speed     += Progression.get_bonus_float("fleetfoot") + Progression.get_bonus_float("fleetfoot_2")
	unit.hp_regen         += Progression.get_bonus_float("vitality_flow") + Progression.get_bonus_float("vitality_flow_2")
	unit.mana_regen       += Progression.get_bonus_float("mana_flow") + Progression.get_bonus_float("mana_flow_2")
	unit.movement_speed   += Progression.get_bonus("swiftness") + Progression.get_bonus("swiftness_2")
	unit.crit_chance      += float(Progression.get_bonus("lethality") + Progression.get_bonus("lethality_2")) / 100.0
	unit.crit_damage      += float(Progression.get_bonus("killing_blow") + Progression.get_bonus("killing_blow_2")) / 100.0

	# Elemental defensive affinity (2026-08-03, the per-element grids on every
	# spoke). Applied per ATTACKING element rather than as a flat block: buying
	# the fire grid makes the whole team take less damage FROM fire, which is
	# what the per-element dictionary already models. 100 is neutral and higher
	# is tankier (see UnitBase.get_defense_multiplier), so these are +1 steps
	# on that rating, 20 per element at full investment.
	for e in UnitBase.Element.values():
		var aff: int = Progression.get_bonus("def_affinity_%s" % _ELEMENT_KEY[e])
		if aff > 0:
			unit.defensive_affinity[e] = unit.defensive_affinity.get(e, 100.0) + float(aff)

# Element enum -> the lowercase name used in crystal-tree keys.
const _ELEMENT_KEY: Dictionary = {
	UnitBase.Element.NORMAL: "normal", UnitBase.Element.FIRE: "fire",
	UnitBase.Element.WATER: "water", UnitBase.Element.EARTH: "earth",
	UnitBase.Element.AIR: "air", UnitBase.Element.LIGHTNING: "lightning",
}

func _on_hero_chosen(unit_class: UnitBase.UnitClass, element: UnitBase.Element, rolls: Dictionary) -> void:
	var hero_decision := {
		"chosen": {"class": int(unit_class), "element": int(element),
			"rolls": rolls.duplicate(true)},
		"offers": _telemetry_hero_offers(),
		"free_starting_pick": _awaiting_call_to_arms_pick,
	}
	if _awaiting_call_to_arms_pick:
		_awaiting_call_to_arms_pick = false
		_recruit_hero(unit_class, element, rolls)   # free — field is guaranteed empty at run start
		_telemetry_decision("hero_chosen", hero_decision)
		update_ui()
		# Under the map, the run's opening beat is relic → starting hero → map.
		# The map is deliberately held back until here so it can't be clicked
		# through while the picker is still waiting (see _on_relic_chosen).
		if MAP_MODE:
			save_run()
			_open_run_map()
		return
	# HERO_COST was already paid in _on_spawn_hero_pressed when this roll was
	# opened — picking one of the 3 offers is free, nothing to charge here.
	# Either way this roll is now spent — clear it so the next Buy Hero press
	# pays for and generates a genuinely fresh roll instead of re-showing these.
	_hero_shop.clear_offers()
	if not _recruit_hero(unit_class, element, rolls):
		info_label.text = "Field AND bench are full!"
		game_state.add_gold(HeroShop.HERO_COST)   # refund the roll — no hero was actually gained
		return
	_telemetry_decision("hero_chosen", hero_decision)
	update_ui()
	save_run()   # checkpoint: keep prep purchases if the player quits/crashes

# Shared "create + apply bonuses/relics + place on the grid" recruit flow —
# used by the paid hero-shop path above AND the free Call to Arms starting
# hero below (2026-07-10). Gold spend/refund stays with each caller since one
# path pays and the other doesn't. If the field is at cap (or has no free
# cell), the hero goes to the BENCH instead of being refused — returns false
# only when the bench is full too (caller handles its own refund).
func _recruit_hero(unit_class: UnitBase.UnitClass, element: UnitBase.Element, rolls: Dictionary) -> bool:
	var unit := UnitFactory.create_unit(unit_class, element, true)
	UnitFactory.apply_recruit_rolls(unit, rolls)
	_apply_progression_bonuses(unit)
	# Veteran Recruits (2026-08-03): every hero joins above level 1. Applied
	# after the stat bonuses so set_level() scales off the finished base, and
	# clamped by the usual cap so it can't outrun Max Hero Level.
	var start_level: int = 1 + Progression.get_bonus("hero_start_level")
	if start_level > 1:
		unit.set_level(mini(start_level, Progression.hero_level_cap()))
	# Grant every relic picked so far to this new hire (each applies at most once).
	if _relic_inventory:
		_relic_inventory.apply_all_to_unit(unit)
	unit.died.connect(_on_unit_died.bind(unit))
	unit.battle_manager = auto_battle_manager
	unit.damage_text_container = damage_text_container

	var spawn_pos := find_empty_player_slot()
	if spawn_pos == Vector2i(-1, -1):
		# Field full — bench instead (still a scene child so sprites/health bars
		# build once, just hidden and off the grid until deployed).
		if bench_units.size() >= max_bench_slots():
			unit.queue_free()
			return false
		battle_grid_node.add_child(unit)
		unit.visible = false
		unit.can_be_dragged = false
		bench_units.append(unit)
		_rebuild_bench_bar()
		info_label.text = "%s waits on the bench." % unit.unit_name
		return true

	unit.grid_position = spawn_pos
	unit.position = battle_grid.grid_to_world(spawn_pos)
	battle_grid_node.add_child(unit)
	if not battle_grid.place_unit(unit, spawn_pos):
		unit.queue_free()
		return false
	unit.home_position = spawn_pos
	player_units.append(unit)
	_rebuild_synergy_display()
	info_label.text = "Added %s to your team!" % unit.unit_name
	update_team_health_bars()
	return true

# ── Bench drag-to-merge (2026-09-28) ─────────────────────────────────────────
# The button that got the press keeps receiving motion + the release even once
# the cursor leaves it, so the whole gesture is tracked from its gui_input.
# Releasing outside the origin button means `pressed` never fires → no deploy.
var _bench_drag_unit: VisualUnit = null
var _bench_drag_press := Vector2.ZERO
var _bench_drag_active := false
var _bench_drag_layer: CanvasLayer = null
var _bench_drag_hint: Label = null

func _handle_bench_drag(event: InputEvent, idx: int) -> bool:
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:
			_bench_drag_unit = bench_units[idx] if idx >= 0 and idx < bench_units.size() else null
			_bench_drag_press = get_viewport().get_mouse_position()
			_bench_drag_active = false
			return false   # let the button register the press (click = deploy)
		if _bench_drag_active:
			var dragged := _bench_drag_unit
			_end_bench_drag()
			var target := _merge_target_at(get_viewport().get_mouse_position(), dragged)
			if target:
				_try_merge_heroes(dragged, target)
			elif dragged and is_instance_valid(dragged):
				info_label.text = "Drop %s on another copy of itself to merge." % dragged.unit_name
			return true
		_bench_drag_unit = null
		return false
	if event is InputEventMouseMotion and _bench_drag_unit:
		var mouse := get_viewport().get_mouse_position()
		if not _bench_drag_active and mouse.distance_to(_bench_drag_press) > 10.0:
			if game_state.current_state != GameState.State.PLAYER_TURN:
				_bench_drag_unit = null
				return false
			_bench_drag_active = true
			_begin_bench_drag(_bench_drag_unit)
		if _bench_drag_active and _bench_drag_layer:
			var preview: Control = _bench_drag_layer.get_child(0)
			preview.position = mouse - preview.size * 0.5
			var target := _merge_target_at(mouse, _bench_drag_unit)
			var hint := ""
			if target:
				var sv: UnitBase = UnitFactory.merge_survivor(_bench_drag_unit, target)
				var other: UnitBase = target if sv == _bench_drag_unit else _bench_drag_unit
				if UnitFactory.merge_block_reason(sv, other) == "":
					hint = "MERGE → %s" % UnitFactory.next_grade(sv.recruit_grade)
				elif UnitFactory.grade_of(sv) != UnitFactory.grade_of(other):
					hint = "SAME GRADE ONLY"
				else:
					hint = "MAX GRADE"
			_bench_drag_hint.text = hint
			return true
	return false

func _begin_bench_drag(unit: VisualUnit) -> void:
	_bench_drag_layer = CanvasLayer.new()
	_bench_drag_layer.layer = 25
	add_child(_bench_drag_layer)
	var box := Panel.new()
	box.size = Vector2(BENCH_SLOT, BENCH_SLOT) * 1.2
	box.add_theme_stylebox_override("panel", UITheme.slot_box(false))
	box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.modulate = Color(1, 1, 1, 0.85)
	_bench_drag_layer.add_child(box)
	var portrait := HeroPortrait.new()
	portrait.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	portrait.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(portrait)
	portrait.setup(unit.unit_class)
	_bench_drag_hint = Label.new()
	_bench_drag_hint.position = Vector2(-20, box.size.y + 2)
	_bench_drag_hint.size = Vector2(box.size.x + 40, 24)
	_bench_drag_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	UITheme.apply_font(_bench_drag_hint, UITheme.FONT_VALUE)
	_bench_drag_hint.add_theme_color_override("font_color", MergeVFX.GOLD)
	_bench_drag_hint.add_theme_color_override("font_outline_color", MergeVFX.RIM)
	_bench_drag_hint.add_theme_constant_override("outline_size", 6)
	box.add_child(_bench_drag_hint)

func _end_bench_drag() -> void:
	_bench_drag_unit = null
	_bench_drag_active = false
	if _bench_drag_layer:
		_bench_drag_layer.queue_free()
	_bench_drag_layer = null
	_bench_drag_hint = null

# A same-class copy under `pos` that `dragged` could merge with: a fielded hero
# on the board cell, or another bench slot. null otherwise.
func _merge_target_at(pos: Vector2, dragged: VisualUnit) -> VisualUnit:
	if not (dragged and is_instance_valid(dragged)):
		return null
	var cand: VisualUnit = null
	if _bench_grid:
		for i in range(mini(_bench_grid.get_child_count(), bench_units.size())):
			var slot := _bench_grid.get_child(i) as Control
			if slot and slot.get_global_rect().has_point(pos):
				cand = bench_units[i]
	if cand == null and battle_grid:
		# Perspective-aware lookup (cells are trapezoids) — the same mapping the
		# board's own hero drag uses. `pos` is a viewport position; convert it to
		# canvas space so a camera/zoom can't skew it.
		var world: Vector2 = get_viewport().get_canvas_transform().affine_inverse() * pos
		var cell: Vector2i = battle_grid.world_to_grid(world)
		if battle_grid.is_valid_position(cell):
			var u = battle_grid.get_unit_at(cell)
			if u is VisualUnit and u in player_units:
				cand = u
	if cand and cand != dragged and is_instance_valid(cand) and cand.unit_class == dragged.unit_class:
		return cand
	return null

# Right-click a fielded hero during prep → store it on the bench.
func _bench_unit(unit: VisualUnit) -> void:
	if unit not in player_units:
		return
	if bench_units.size() >= max_bench_slots():
		info_label.text = "Bench is full! (%d/%d)" % [bench_units.size(), max_bench_slots()]
		return
	battle_grid.purge_unit(unit)
	player_units.erase(unit)
	unit.visible = false
	unit.can_be_dragged = false
	unit.is_dragging = false
	bench_units.append(unit)
	info_label.text = "%s moved to the bench." % unit.unit_name
	_rebuild_synergy_display()
	_rebuild_bench_bar()
	update_team_health_bars()
	update_ui()

# Click a bench slot during prep → deploy that hero to the first free cell
# (respects the level-driven field cap via find_empty_player_slot).
# Right-click a benched hero to sell it for a partial refund (2026-07-17 economy
# valve + fixes permanently-clogged rosters). Prep phase only.
func _on_bench_slot_input(event: InputEvent, idx: int) -> void:
	# Left-drag a benched hero onto a copy of itself (field or bench) → merge
	# (2026-09-28). A plain click still deploys via the button's `pressed`.
	if _handle_bench_drag(event, idx):
		return
	if not (event is InputEventMouseButton and event.pressed \
			and event.button_index == MOUSE_BUTTON_RIGHT):
		return
	if game_state.current_state != GameState.State.PLAYER_TURN:
		info_label.text = "You can only sell heroes between rounds."
		return
	if idx < 0 or idx >= bench_units.size():
		return
	var unit: VisualUnit = bench_units[idx]
	bench_units.remove_at(idx)
	if unit and is_instance_valid(unit):
		if _equipment_inventory:
			_equipment_inventory.return_all_from_hero(unit)   # loot goes back to the bag, not lost
		var nm := unit.unit_name
		unit.queue_free()
		game_state.add_gold(Balance.SELL_REFUND)
		info_label.text = "Sold %s for %dg." % [nm, Balance.SELL_REFUND]
	_rebuild_bench_bar()
	_rebuild_synergy_display()
	update_ui()
	save_run()

func _deploy_bench_unit(idx: int) -> void:
	if idx < 0 or idx >= bench_units.size():
		return
	if game_state.current_state != GameState.State.PLAYER_TURN:
		info_label.text = "You can only deploy between rounds."
		return
	var unit: VisualUnit = bench_units[idx]
	if not (unit and is_instance_valid(unit)):
		bench_units.remove_at(idx)
		_rebuild_bench_bar()
		return
	var spawn_pos := find_empty_player_slot()
	if spawn_pos == Vector2i(-1, -1):
		info_label.text = "No room on the field! (Team %d/%d)" % [player_units.size(), max_player_units]
		return
	bench_units.remove_at(idx)
	unit.grid_position = spawn_pos
	unit.position = battle_grid.grid_to_world(spawn_pos)
	if not battle_grid.place_unit(unit, spawn_pos):
		bench_units.insert(idx, unit)   # shouldn't happen (slot was free) — put it back
		return
	unit.home_position = spawn_pos
	unit.visible = true
	unit.can_be_dragged = true
	player_units.append(unit)
	info_label.text = "%s takes the field!" % unit.unit_name
	_rebuild_synergy_display()
	_rebuild_bench_bar()
	update_team_health_bars()
	update_ui()

# Call to Arms (2026-07-10 user spec): the crystal-shop tree's root node,
# always active — not a purchasable upgrade, so it's not in Progression.UPGRADES.
# Every run now starts with 1 free recruited hero instead of starting gold
# (Balance.STARTING_GOLD was removed from start_new_game() — see that comment).
# 2026-07-10 follow-up: the grant is now a PICK, not a random roll — it reuses
# the hero-shop card picker in free_mode, opened once the round-1 relic screen
# resolves (_maybe_open_call_to_arms_picker, called from _on_relic_chosen and
# the no-relic-offers branch in _on_battle_round_started).
var _call_to_arms_pending:      bool = false  # set at start_new_game(), consumed once the picker opens
var _awaiting_call_to_arms_pick: bool = false  # true while the free-mode picker is on screen

func _maybe_open_call_to_arms_picker() -> void:
	if not _call_to_arms_pending:
		return
	_call_to_arms_pending = false
	_awaiting_call_to_arms_pick = true
	var shop_slots: int = 3 + (_relic_inventory.shop_slot_bonus() if _relic_inventory else 0)
	_hero_shop.favored_verbs = _relic_inventory.seed_verbs() if _relic_inventory else []
	_hero_shop.owned_classes = []   # starting pick: nothing to merge with, keep it uniform
	_hero_shop.open(0, shop_slots, true)


