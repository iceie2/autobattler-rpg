# Wave spec generation + enemy creation live in WaveDirector (2026-07-04
# refactor) — scene-independent and shared with the arena harness, so the
# simulator can never drift from the live game's waves again.
func _generate_wave_spec(difficulty: int) -> Array:
	# The node being played pins the filler roll, so the fight that opens is the
	# fight the map card showed — the map screen previews through the SAME seed
	# (see _map_node_preview and WaveScaler._filler_rng). Classic mode and any
	# pre-map save have no node and pass 0, which rolls freshly as it always did.
	var spec: Array = _wave_director.generate_wave_spec(
			game_state.battle_round, difficulty, battle_grid.grid_width,
			_hydra_chosen_element, int(_map_node.get("wave_seed", 0)))
	# ── Event-driven wave modifiers (2026-09-19) ─────────────────────────────
	# Until now events could only hand out gold, stats and items — they had no
	# way to touch a FIGHT, which is why the whole "accept a harder wave for a
	# better payout" category didn't exist. Extra bodies are added here, after
	# the director has built its formation, so the modifier rides on top of
	# whatever the round would normally field instead of replacing it.
	var extra: int = int(_next_wave_mods.get("extra_enemies", 0))
	if extra > 0:
		var lvl: int = WaveScaler.enemy_level_for_round(game_state.battle_round, false)
		for _i in range(extra):
			spec.append({"type": "random", "level": lvl})
	return spec

# This round's spec for `difficulty` — generated once, then reused for every
# later preview and for the committed wave. See _wave_specs.
func _wave_spec_for(difficulty: int) -> Array:
	if not _wave_specs.has(difficulty):
		_wave_specs[difficulty] = _generate_wave_spec(difficulty)
	return _wave_specs[difficulty]

func _estimate_wave_power(difficulty: int) -> float:
	# Score the cached spec, so the number on the panel describes the roster the
	# player can actually see on the grid (see _wave_specs).
	return _wave_director.score_spec(_wave_spec_for(difficulty), game_state.battle_round)

# Instantiate a wave spec onto the board. roll_item=false for the difficulty
# preview (so scouting can't free-reroll held-item drops); true for the real
# locked wave.
func _instantiate_wave_from_spec(spec: Array, roll_item: bool = true) -> void:
	clear_enemy_units()
	_clear_middle_row()
	for entry: Dictionary in spec:
		var unit: VisualUnit = _wave_director.create_enemy_for_entry(entry, game_state.battle_round)
		if not unit:
			continue
		var grid_pos: Vector2i = entry.get("pos", Vector2i(-1, -1))
		if grid_pos != Vector2i(-1, -1):
			_place_at(unit, grid_pos, roll_item)
		else:
			_place_enemy(unit, roll_item)
	# Enemy creation happens after the prep sidebar's initial paint. Refresh it
	# once the complete wave is present so its totals/list match the visible board.
	update_team_health_bars()

func spawn_enemies(difficulty: int = WaveScaler.Difficulty.NORMAL) -> void:
	# Difficulty PREVIEW — the SAME cached spec the wave will actually use (so the
	# preview is exact, not a fresh roll), but never rolls held items.
	_instantiate_wave_from_spec(_wave_spec_for(difficulty), false)

# Place any unit at an explicit grid position (respects cell_size for 2×2 units).
# roll_item=false is used by the difficulty PREVIEW so switching difficulty back
# and forth can't be used to free-scout (and re-roll) held-item drops before
# committing — items only ever roll on the real, locked wave instantiation.
func _place_at(unit: VisualUnit, grid_pos: Vector2i, roll_item: bool = true) -> void:
	if not unit.is_player_unit:
		unit.can_be_dragged = false
	unit.grid_position = grid_pos
	var world := battle_grid.grid_to_world(grid_pos)
	# Multi-cell units: offset the visual centre onto the middle of their block.
	# N×N formula (was hardcoded to 2×2) — same result at size 2, correct for the
	# 3×3 Architect. Mirrors AutoBattleManager._world_pos_for.
	if unit.cell_size > 1:
		var off: float = battle_grid.cell_size * (unit.cell_size - 1) * 0.5
		world += Vector2(off, off)
	unit.position = world
	battle_grid_node.add_child(unit)
	if not battle_grid.place_unit(unit, grid_pos):
		# The wave spec's chosen position collided with something already on the
		# real board — stray occupied_cells that outlived their owner (see
		# BattleGrid.purge_unit) are the known cause. Rather than silently
		# dropping the unit (2026-08-07 user report: Hill Giant missing from
		# wave 5), self-heal and retry once, then fall back to any free block
		# elsewhere in the enemy zone so the wave still spawns complete.
		var reclaimed: int = battle_grid.sweep_phantoms()
		push_warning("[_place_at] place_unit failed for %s at %s (cell_size %d); reclaimed %d phantom cell(s), retrying" \
				% [unit.unit_name, grid_pos, unit.cell_size, reclaimed])
		if not battle_grid.place_unit(unit, grid_pos):
			var alt := _find_empty_enemy_block(unit.cell_size)
			if alt != Vector2i(-1, -1) and battle_grid.place_unit(unit, alt):
				unit.grid_position = alt
				var alt_world := battle_grid.grid_to_world(alt)
				if unit.cell_size > 1:
					alt_world += Vector2(battle_grid.cell_size * (unit.cell_size - 1) * 0.5, battle_grid.cell_size * (unit.cell_size - 1) * 0.5)
				unit.position = alt_world
			else:
				push_warning("[_place_at] no free %dx%d block found for %s — dropping it" \
						% [unit.cell_size, unit.cell_size, unit.unit_name])
				unit.queue_free()
				return
	enemy_units.append(unit)
	unit.died.connect(_on_unit_died.bind(unit))
	unit.battle_manager = auto_battle_manager
	unit.damage_text_container = damage_text_container
	if roll_item:
		_roll_held_item(unit)

# Enemies can spawn already wielding a dropped item — stat bonuses apply for the
# whole fight, and the exact same item drops on death (what you see is what you loot).
# Gold interest (2026-08-03): a flat 10% of gold on hand at each round win,
# capped so hoarding has a ceiling. Deep Coffers raises the cap, 5 -> 15.
const INTEREST_RATE := 0.10
const INTEREST_BASE_CAP := 5

# Equipment volume nerf (2026-08-04, BALANCE_PLAN.md §1.7-1.8). Was 0.12 +
# round*0.015, which hit 42% per enemy by round 20 and SATURATED AT 100% by
# round 59 — a normal run banked enough commons to fuse ~4 Epics, and one Epic
# is roughly an 8x DPS multiplier. Base and slope both cut ~3x, and the slope
# specifically so the curve never saturates (round 100 tops out near 55%).
# The base game is now deliberately loot-poor: the Armory spoke's loot nodes are
# what RESTORE equipment volume, which is the whole point — power moves out of
# free drops and into the crystal tree.
const HELD_ITEM_BASE_CHANCE := 0.08
const HELD_ITEM_CHANCE_PER_ROUND := 0.008
func _roll_held_item(unit: VisualUnit) -> void:
	if unit.is_player_unit:
		return
	# Well Stocked (2026-08-03, Armory spoke): +3% per node that an enemy spawns
	# carrying something at all. The rarity of what it carries is a separate
	# pair of upgrades — see EquipmentManager._roll_rarity.
	var chance: float = HELD_ITEM_BASE_CHANCE \
		+ game_state.battle_round * HELD_ITEM_CHANCE_PER_ROUND \
		+ float(Progression.get_bonus("loot_drop_chance")) / 100.0
	chance *= ComponentEquipmentGateway.supply_mult()   # fewer items per tier in the component system
	if randf() >= chance:
		return
	var item := ComponentEquipmentGateway.generate_item(game_state.battle_round, EquipmentItem.Rarity.RARE)
	ComponentEquipmentGateway.apply_to_unit(unit, item)
	unit.held_items.append(item)
	if unit.health_bar:
		unit.health_bar.update_hp(unit.current_hp, unit.max_hp)
		unit.health_bar.update_mp(unit.current_mana, unit.max_mana)
	var tex: Texture2D = GearIcons.icon_for(item)   # legacy art or component composite
	if tex and unit is VisualUnit:
		unit.show_held_item_icon(tex, item.icon_color)

# Slot-fill for procedural rounds (keeps existing behaviour)
func _place_enemy(unit: VisualUnit, roll_item: bool = true) -> void:
	var spawn_pos := find_empty_enemy_slot()
	if spawn_pos == Vector2i(-1, -1):
		unit.queue_free()
		return
	unit.can_be_dragged = false
	_place_at(unit, spawn_pos, roll_item)

# Defensive guarantee (2026-07-06 user report): row 4 — the dividing line
# between the enemy zone (rows 0-3) and the player zone (rows 5-8) — must
# never have anything occupying it when a new wave spawns. The ordinary
# win-flow already empties it (clear_enemy_units/_despawn_summons/
# reset_player_positions all run at the end of the previous round before this
# is ever reached), and normal drag-placement already refuses to drop a hero
# there (_is_valid_placement) — this is a no-cost belt-and-suspenders sweep so
# nothing can ever linger there regardless of how it got left behind.
func _clear_middle_row() -> void:
	var mid_y: int = battle_grid.grid_height / 2
	for x in range(battle_grid.grid_width):
		var pos := Vector2i(x, mid_y)
		var stray = battle_grid.get_unit_at(pos)
		if not (stray and is_instance_valid(stray)):
			continue
		# Put a hero back in its own zone rather than losing it outright. This
		# used to test `stray in player_units or stray in _downed_heroes`, so any
		# hero that had fallen out of BOTH arrays was treated as an enemy stray
		# and queue_free()'d — gone for the rest of the run despite never really
		# dying (2026-09-19; see _on_unit_revived for how that happened).
		# is_player_unit is the property that actually decides whose unit this is,
		# and it cannot go stale the way array membership can. Player summons are
		# still cleaned up, just by _despawn_summons at round end instead.
		if stray.is_player_unit and not stray.is_summoned:
			# Cap-free scan on purpose: find_empty_player_slot refuses once the
			# field is full, which is correct when ADDING a hero and wrong when
			# RELOCATING one that is already on the board — it left the hero
			# stranded on the divider it was supposed to be swept off.
			var slot: Vector2i = _free_player_zone_cell()
			if slot == Vector2i(-1, -1):
				continue
			battle_grid.purge_unit(stray)
			stray.grid_position = slot
			stray.position = battle_grid.grid_to_world(slot)
			battle_grid.place_unit(stray, slot)
			# Repair a home_position that points outside the player zone, or this
			# hero gets slotted straight back onto the divider every round. An
			# existing run can already be carrying one (Doc used to write the
			# revive cell into it), so this is the migration for saves in flight.
			if stray.home_position.y < battle_grid.grid_height - 4:
				stray.home_position = slot
		else:
			battle_grid.purge_unit(stray)
			enemy_units.erase(stray)
			stray.queue_free()

func find_empty_player_slot() -> Vector2i:
	if player_units.size() >= max_player_units:
		return Vector2i(-1, -1)
	return _free_player_zone_cell()

# Any free cell in the player zone, IGNORING the team-size cap. Use this to
# relocate a hero that is already on the board; use find_empty_player_slot when
# adding one, since only that case should be refused by a full field.
func _free_player_zone_cell() -> Vector2i:
	for y in range(battle_grid.grid_height - 4, battle_grid.grid_height):
		for x in range(battle_grid.grid_width):
			var p := Vector2i(x, y)
			if not battle_grid.is_cell_occupied(p):
				return p
	return Vector2i(-1, -1)

func find_empty_enemy_slot() -> Vector2i:
	# Top 4 rows of the grid (rows 0-3)
	for y in range(4):
		for x in range(battle_grid.grid_width):
			var p := Vector2i(x, y)
			if not battle_grid.is_cell_occupied(p):
				return p
	return Vector2i(-1, -1)

# Fallback for _place_at when a multi-cell unit's spec-chosen position collides
# with the real board (see the retry there). Scans the enemy zone (rows 0-3)
# for any fully-clear size×size block, top-left-first.
func _find_empty_enemy_block(size: int) -> Vector2i:
	if size <= 1:
		return find_empty_enemy_slot()
	for y in range(4 - size + 1):
		for x in range(battle_grid.grid_width - size + 1):
			var clear := true
			for dy in range(size):
				for dx in range(size):
					if battle_grid.is_cell_occupied(Vector2i(x + dx, y + dy)):
						clear = false
						break
				if not clear:
					break
			if clear:
				return Vector2i(x, y)
	return Vector2i(-1, -1)

func clear_enemy_units() -> void:
	for unit in enemy_units:
		if unit and is_instance_valid(unit):
			battle_grid.purge_unit(unit)
			unit.queue_free()
	enemy_units.clear()

# Bring every hero that fell this round back at REVIVE_HP_PCT (2026-07-24
# design change: heroes are never permanently lost). Their nodes were parked
# invisible by VisualUnit.die() rather than freed, so this restores the very
# same object — level, XP, recruit rolls and equipment all survive untouched.
# Runs on a WON round only; a lost round ends the run anyway.
func _revive_downed_heroes() -> void:
	_just_revived.clear()
	for unit in _downed_heroes:
		if not (unit and is_instance_valid(unit)):
			continue
		# Already back on their feet mid-fight — don't yank a healthy survivor
		# back down to 10%. They MUST still rejoin the roster, though: a bare
		# `continue` skipped the player_units.append() below, and the
		# _downed_heroes.clear() at the end then dropped the last reference,
		# orphaning a live hero out of both arrays (2026-09-19). _on_unit_revived
		# is the real fix and normally gets there first; this is the backstop for
		# any other route that lifts a corpse above 0 HP — heal() has no death
		# guard, so one could appear.
		# _is_dying distinguishes a hero who was properly stood up (revive()
		# clears it) from a corpse whose HP number merely got topped up: the
		# latter still needs the full revive below to become visible again.
		if unit.current_hp > 0 and not unit._is_dying:
			if unit not in player_units:
				player_units.append(unit)
			continue
		unit.revive(REVIVE_HP_PCT)
		if unit not in player_units:
			player_units.append(unit)
		_just_revived.append(unit)
	_downed_heroes.clear()
	if not _just_revived.is_empty():
		var names: Array[String] = []
		for u in _just_revived:
			names.append(u.unit_name)
		_on_action_logged("Revived at %d%% HP: %s" % [
				int(REVIVE_HP_PCT * 100.0), ", ".join(names)], true)
	_rebuild_synergy_display()

func reset_player_positions() -> void:
	# Clear stale battle-manager path cache
	auto_battle_manager.unit_paths.clear()

	# Remove units from wherever battle left them
	for unit in player_units:
		if unit and is_instance_valid(unit):
			battle_grid.purge_unit(unit)

	# Restore each unit to the exact cell the player chose (home_position).
	# home_position is only written when the player places or drags a unit —
	# it never changes during battle, so this preserves the player's layout.
	for unit in player_units:
		if not (unit and is_instance_valid(unit)):
			continue
		var slot: Vector2i = unit.home_position
		# Fallback: if home_position is still zero (unit placed before this system),
		# find any free slot but don't overwrite home_position.
		if slot == Vector2i.ZERO or battle_grid.is_cell_occupied(slot):
			for y in range(battle_grid.grid_height - 4, battle_grid.grid_height):
				for x in range(battle_grid.grid_width):
					var p := Vector2i(x, y)
					if not battle_grid.is_cell_occupied(p):
						slot = p
						break
				if slot != unit.home_position:
					break
		if slot == Vector2i(-1, -1):
			continue
		# grid_position is only written once the cell actually took us
		# (2026-08-07). Writing it regardless — as this did — is how a hero ends
		# up claiming a cell it isn't registered on, which makes every later
		# position-keyed removal miss and strands cells; see BattleGrid.purge_unit.
		if not battle_grid.place_unit(unit, slot):
			var fallback: Vector2i = find_empty_player_slot()
			if fallback == Vector2i(-1, -1) or not battle_grid.place_unit(unit, fallback):
				continue
			slot = fallback
		unit.grid_position = slot
		unit.position = battle_grid.grid_to_world(slot)
		# Clear leftover movement state from battle
		unit.is_moving = false
		unit.move_progress = 0.0
		unit.move_start_pos = unit.position
		unit.move_target_pos = unit.position


# ── HERO XP NODES (VD-18) ──────────────────────────────────────────────────
# Quick Learner (every hero) and Tutelage (heroes below the team's highest
# level - a late pickup catches up instead of staying dead weight) as ONE
# multiplier, shared by the kill share and the damage share of battle XP.
func _hero_xp_node_mult(hero: UnitBase, top_level: int) -> float:
	var m: float = 1.0 + float(Progression.get_bonus("quick_learner")) / 100.0
	if hero.level < top_level:
		m *= 1.0 + float(Progression.get_bonus("catch_up_xp")) / 100.0
	return m

func _top_hero_level(heroes: Array) -> int:
	var top: int = 1
	for hero in heroes:
		if hero and is_instance_valid(hero):
			top = maxi(top, hero.level)
	return top


# ── BETWEEN-ROUND BONUSES ──────────────────────────────────────────────────
# Row bonuses are MEASURED here, at the end of the round that earned them, off
# the positions the player actually fought in — but they are not applied yet
# (2026-08-02 redesign). The heal and XP sit in _pending_row_bonuses until the
# NEXT round opens, where _play_round_start_ceremony pays them out as a visible
# beat: revives first, then healing numbers, then XP bars filling. Values are
# unchanged from the old instant version; only the timing and staging moved.
#
# Heroes that fell this round are measured too (they're in _downed_heroes, not
# player_units, since revival is deferred as well). They earn their row's XP
# and heal after standing up at REVIVE_HP_PCT.
const ROW_XP_PER_DMG := 8   # 1 hero XP per N damage dealt (also read by _grant_skipped_wave_rewards)

func _snapshot_between_round_bonuses() -> void:
	# Player zone: y=5 (front, closest to middle) to y=8 (back, farthest from middle).
	# Front row: 10% heal, +40% XP.  Back row: 40% heal, +10% XP.
	const PLAYER_Y_FRONT   := 5          # grid row closest to the middle dividing line
	const PLAYER_Y_BACK    := 8          # grid row farthest from the middle
	const HEAL_BACK        := 0.40
	const HEAL_FRONT       := 0.10
	const XP_MULT_BACK     := 1.10
	const XP_MULT_FRONT    := 1.40
	const XP_PER_DMG       := ROW_XP_PER_DMG

	_pending_row_bonuses.clear()

	var measured: Array = []
	for unit in player_units:
		measured.append(unit)
	for unit in _downed_heroes:
		if unit not in measured:
			measured.append(unit)
	var top_level: int = _top_hero_level(measured)

	for unit in measured:
		if not (unit and is_instance_valid(unit)):
			continue
		# Summons don't survive the round (_despawn_summons), so there's nobody
		# left to pay at ceremony time.
		if unit.is_summoned:
			continue

		var row_y: int     = clampi(unit.home_position.y, PLAYER_Y_FRONT, PLAYER_Y_BACK)
		# front_t 1.0 = front row (low heal, high XP), 0.0 = back row (high heal, low XP)
		var front_t: float = float(PLAYER_Y_BACK - row_y) / float(PLAYER_Y_BACK - PLAYER_Y_FRONT)

		var is_downed: bool = unit in _downed_heroes
		var heal_pct: float = lerpf(HEAL_BACK, HEAL_FRONT, front_t)
		var heal_amt: int = int(unit.max_hp * heal_pct)

		# XP from output this battle. The kill share already carries Quick
		# Learner/Tutelage (applied per kill); the damage share - ~96% of hero
		# XP - gets them here (VD-18: it used to get neither).
		var xp_mult: float = lerpf(XP_MULT_BACK, XP_MULT_FRONT, front_t)
		var dmg_xp: float = float(unit.damage_dealt) / float(XP_PER_DMG) \
			* _hero_xp_node_mult(unit, top_level)
		var base_xp: float = dmg_xp + unit.kill_xp
		var xp_gained: float = base_xp * xp_mult

		_pending_row_bonuses.append({
			"unit": unit, "heal": heal_amt, "xp": xp_gained,
			"front_t": front_t, "revive": is_downed,
		})

		# Reset per-battle trackers for next round. damage_dealt is deliberately
		# NOT reset here any more: the damage meter stays readable through the
		# prep phase and is zeroed when the next battle starts
		# (AutoBattleManager._init_unit_timers). Its XP was already read above.
		unit.kill_count   = 0
		unit.kill_xp      = 0

	update_team_health_bars()
	_rebuild_damage_meter()


# ── ROUND-START CEREMONY ───────────────────────────────────────────────────
# The payout beat for last round's row bonuses (2026-08-02). Runs at the top of
# _on_battle_round_started, before the new wave spawns and before any modal, on
# a locked board:
#   1. every hero that fell stands back up at REVIVE_HP_PCT
#   2. row heals tick up with a green "+N" over each hero
#   3. a temporary XP bar under each hero fills with what their row earned,
#      wrapping (and flashing LEVEL UP!) on each level gained
# Any click or key fast-forwards the whole thing to its final values.
const CEREMONY_STAGGER   := 0.10   # delay between heroes starting their payout
const CEREMONY_HEAL_TIME := 0.45
const CEREMONY_XP_TIME   := 0.60
const CEREMONY_HOLD      := 0.45   # how long the filled XP bar lingers
const CEREMONY_XP_BAR_Y  := 86.0   # below the player health bar stack (offset_y 60)

var _ceremony_running: int = 0   # hero payouts still animating

func _play_round_start_ceremony() -> void:
	if _pending_row_bonuses.is_empty() and _downed_heroes.is_empty():
		return

	_ceremony_active = true
	_ceremony_skip   = false
	_ceremony_running = 0
	enable_unit_dragging(false)
	_set_intent_overlay(false)

	# 1 — Revives. Fallen heroes have been down since the fight ended; they get
	# back up here, then reset_player_positions slots them at home_position so
	# they're on the board for their own XP payout below.
	_revive_downed_heroes()
	reset_player_positions()
	update_team_health_bars()
	if not _just_revived.is_empty():
		info_label.text = "%d hero%s back on their feet at %d%% HP." % [
			_just_revived.size(), "" if _just_revived.size() == 1 else "es",
			int(REVIVE_HP_PCT * 100.0)]
		await _ceremony_wait(0.5)

	# 2 + 3 — Heals and XP, staggered across the team so it reads as a sweep
	# rather than one simultaneous blur.
	info_label.text = "Recovering — front rows trained harder, back rows rested better."
	for entry in _pending_row_bonuses:
		var unit = entry.get("unit")
		if not (unit and is_instance_valid(unit)):
			continue
		_animate_hero_payout(unit, int(entry.get("heal", 0)), float(entry.get("xp", 0.0)))
		if not _ceremony_skip:
			await _ceremony_wait(CEREMONY_STAGGER)
	while _ceremony_running > 0:
		await get_tree().process_frame

	for entry in _pending_row_bonuses:
		var u = entry.get("unit")
		if u and is_instance_valid(u):
			_log_between_round(u, int(entry.get("heal", 0)), float(entry.get("xp", 0.0)),
					float(entry.get("front_t", 0.0)))
	_pending_row_bonuses.clear()

	update_team_health_bars()
	_rebuild_synergy_display()
	update_ui()
	_ceremony_active = false
	_ceremony_skip   = false

	# Perk picks for anything that leveled during the ceremony. These used to
	# fire at round end, back when XP was granted there.
	var leveled: Array = player_units.filter(
		func(u): return u and is_instance_valid(u) and u.perk_points > 0)
	if not leveled.is_empty():
		_level_up_screen.present(leveled)
		await _level_up_screen.all_done

	# GameState already flipped to PLAYER_TURN while we were animating; open the
	# prep phase now that the board is settled.
	if _player_turn_deferred:
		_enter_player_turn()


# One hero's heal + XP animation. Started fire-and-forget (no await) by the
# ceremony so heroes overlap, with _ceremony_running as the join counter.
func _animate_hero_payout(unit, heal: int, xp: float) -> void:
	_ceremony_running += 1

	# ── Heal ──
	var applied: int = mini(heal, maxi(0, unit.max_hp - unit.current_hp))
	if applied > 0:
		unit.spawn_heal_text(applied)
		var from_hp: int = unit.current_hp
		var to_hp: int   = from_hp + applied
		var t: float = 0.0
		while t < CEREMONY_HEAL_TIME and not _ceremony_skip:
			t += get_process_delta_time()
			if not is_instance_valid(unit):
				_ceremony_running -= 1
				return
			# current_hp's setter emits health_changed, so the bar follows.
			unit.current_hp = int(lerpf(float(from_hp), float(to_hp),
					clampf(t / CEREMONY_HEAL_TIME, 0.0, 1.0)))
			await get_tree().process_frame
		if is_instance_valid(unit):
			unit.current_hp = to_hp

	if not is_instance_valid(unit):
		_ceremony_running -= 1
		return

	# ── XP ──
	if xp > 0.0:
		var bar := XPGainBar.new()
		bar.position = Vector2(0, CEREMONY_XP_BAR_Y)
		bar.set_label("+%s XP" % _xp_str(xp))
		unit.add_child(bar)

		# The grant is authoritative and immediate; the bar replays it. Simulating
		# the wraps visually (rather than reading unit.current_xp each frame) is
		# what lets multi-level gains show every level-up instead of one jump.
		var shown: float = unit.current_xp
		var need:  float = unit.xp_to_level
		unit.grant_xp(xp)

		bar.set_fill(shown / maxf(1.0, need))
		var t2: float = 0.0
		var levels_shown: int = 0   # so a wrap pops exactly once, not every frame after it
		while t2 < CEREMONY_XP_TIME and not _ceremony_skip:
			t2 += get_process_delta_time()
			var delivered: float = xp * clampf(t2 / CEREMONY_XP_TIME, 0.0, 1.0)
			var cur: float = shown + delivered
			var n: float = need
			var wraps: int = 0
			while cur >= n:
				cur -= n
				n *= 1.5
				wraps += 1
			if not is_instance_valid(bar):
				break
			if wraps > levels_shown:
				levels_shown = wraps
				bar.pop_level()
			bar.set_fill(cur / maxf(1.0, n))
			await get_tree().process_frame

		if is_instance_valid(bar):
			# Land on the hero's real post-grant values — this also covers the
			# hero-level cap, where grant_xp zeroes the leftover XP.
			bar.set_fill(unit.current_xp / maxf(1.0, unit.xp_to_level))
			await _ceremony_wait(CEREMONY_HOLD)
			bar.queue_free()

	_ceremony_running -= 1


# A wait that collapses the moment the player skips the ceremony.
func _ceremony_wait(seconds: float) -> void:
	var t: float = 0.0
	while t < seconds and not _ceremony_skip:
		t += get_process_delta_time()
		await get_tree().process_frame


func _xp_str(xp: float) -> String:
	return ("%.1f" % xp) if xp != float(int(xp)) else str(int(xp))


func _log_between_round(unit: UnitBase, heal: int, xp: float, front_t: float) -> void:
	var row_label := "back" if front_t < 0.35 else ("mid" if front_t < 0.65 else "front")
	var xp_str: String = "%.1f" % xp if xp != int(xp) else str(int(xp))
	_on_action_logged(
		"[%s] %s row → +%d HP healed, +%s XP (Lv.%d)" % [
			unit.unit_name, row_label, heal, xp_str, unit.level],
		true)



# ── UNIT DEATH & SUMMONS ───────────────────────────────────────────────────

# A hero brought back MID-FIGHT (Doc's Field Surgery). The exact counterpart to
# _on_unit_died below: that one takes the unit out of BOTH rosters, this one puts
# it back in ours. AutoBattleManager fixes only its own copy, so before this
# existed main_game never learned the hero was alive again — it stayed out of
# player_units while its node kept standing on the board, which meant no
# reset_player_positions (stranded wherever it was revived), no
# enable_unit_dragging (unclickable), absent from save_run (lost on resume), and
# finally queue_free()'d by _clear_middle_row. That is the 2026-09-19 tester
# report: "they moved toward the center and unclickable", units gone for good.
#
# Note this also takes the hero OFF _downed_heroes, so the round-start ceremony
# treats it as the survivor it is and heals from its remaining HP.
func _on_unit_revived(unit) -> void:
	if not (unit and is_instance_valid(unit)):
		return
	_downed_heroes.erase(unit)
	if unit.is_player_unit:
		if unit not in player_units:
			player_units.append(unit)
	elif unit not in enemy_units:
		enemy_units.append(unit)
	_rebuild_synergy_display()
	update_team_health_bars()

func _on_unit_died(unit) -> void:
	var was_enemy := enemy_units.has(unit)
	if _milestone_battle.active and is_instance_valid(unit):
		_milestone_battle.death(unit, was_enemy, auto_battle_manager.battle_elapsed)
		_record_relic_milestones(_milestone_battle.sample())
	var _dead_level: int = unit.level if (unit and is_instance_valid(unit)) else 1

	# Balance export (2026-08-05): last player death this run, for "died to what".
	# Overwritten on every player death, so a wipe's final entry is the one that
	# actually ended the run rather than the first casualty.
	if not was_enemy and unit and is_instance_valid(unit):
		_run_last_death = {"hero": str(unit.unit_name), "killed_by": str(unit.last_killed_by),
				"wave": game_state.battle_round}

	player_units.erase(unit)
	enemy_units.erase(unit)
	# AutoBattleManager keeps its OWN roster arrays (built in collect_units), so
	# erasing from main_game's alone leaves the unit in the fight. That used to
	# self-correct because the node got freed and check_battle_end filtered on
	# is_instance_valid — but fallen heroes are parked for revival now, so
	# without this the corpse kept acting as an invisible ghost: attacking,
	# being targeted, and keeping player_units non-empty so a wipe never
	# registered as a defeat (2026-07-24). The arena harness already did this,
	# which is exactly why no sim caught it.
	if auto_battle_manager:
		auto_battle_manager.player_units.erase(unit)
		auto_battle_manager.enemy_units.erase(unit)
	_rebuild_synergy_display()
	if unit and is_instance_valid(unit):
		battle_grid.purge_unit(unit)

	# A fallen player hero is NOT lost anymore (2026-07-24 design change): its
	# node is parked invisible by VisualUnit.die() and revived at 10% HP once
	# the round ends (_revive_downed_heroes). So it keeps its gear equipped —
	# the old "return everything to the bag" salvage existed only because death
	# used to be permanent, and stripping a hero that's coming back would just
	# force the player to re-equip it every single round.
	if not was_enemy and unit and is_instance_valid(unit) and not unit.is_summoned:
		if unit not in _downed_heroes:
			_downed_heroes.append(unit)
		info_label.text = "%s fell — they'll be back at 10%% HP after this round." % unit.unit_name

	if was_enemy and unit and is_instance_valid(unit):
		_run_kills += 1
		# Hold a greyed TEAM STATUS row until the death animation finishes.
		# VisualUnit.die() emits `died` FIRST and only frees the node after the
		# death clip + fade, so the panel and the board disagreed for the whole
		# tween — long enough to read "No enemy units" over a visible corpse.
		if unit not in _dying_units:
			_dying_units.append(unit)
			_dying_deadline[unit] = Time.get_ticks_msec() + DYING_ROW_MAX_MSEC
			_combat_ui_dirty = true
		_last_enemy_death_pos = unit.position
		# Economy v3: kills drop physical coins on the field (collected by the
		# round-end vacuum) instead of crediting gold instantly.
		# NOTE: `unit.position` (local to battle_grid_node), not global_position.
		# GoldCoinSystem is battle_grid_node's sibling-under-the-same-parent, so
		# spawn_coins() treats its `world_pos` arg as local-to-battle_grid_node
		# (see spawn_burst()'s use of grid_to_world(), which is local too).
		# Passing global_position here double-counted battle_grid_node's own
		# centering offset (_center_battlefield), flinging every drop off the
		# visible board (2026-07-04 user report).
		_spawn_gold_coins(unit.position,
				WaveScaler.gold_drops_for_unit(unit, game_state.battle_round))
		# Bounty (crystal-shop meta, reworked 2026-07-31): each level is an
		# INDEPENDENT 25% chance to drop one extra gold coin per kill — a single
		# roll against level*25%, not a flat add — so max level (4 => 100%)
		# guarantees exactly +1 coin per kill. Decoupled from the base
		# gold-per-kill drop rate entirely; this is its own roll on top.
		# Clamped: an old save can carry more levels than the current max
		# (e.g. the pre-rework cap of 5) — clamp rather than let the roll
		# exceed 100% chance.
		var bounty_chance: float = clampf(float(Progression.get_bonus("gold_per_kill")) / 100.0, 0.0, 1.0)
		if bounty_chance > 0.0 and randf() < bounty_chance and _coin_system:
			_coin_system.spawn_coins(unit.position, 1, 1)
		# Crystals are physical too (2026-07-21, matches gold coins): tossed on
		# the field, hover-collectible mid-fight, swept up by the round-end
		# vacuum otherwise. Nothing is credited until a drop actually arrives.
		# Crystal Surge (reworked 2026-07-31, mirrors Bounty above): independent
		# 25%-per-level roll for +1 crystal, decoupled from the base per-enemy
		# crystal drop rate (WaveScaler.crystals_for_unit) rather than added
		# into the same roll.
		var surge_chance: float = clampf(float(Progression.get_bonus("crystal_drop")) / 100.0, 0.0, 1.0)
		var surge_bonus: int = 1 if (surge_chance > 0.0 and randf() < surge_chance) else 0
		var crystals: int = WaveScaler.crystals_for_unit(unit) + surge_bonus
		if crystals > 0 and _crystal_drop_system:
			# gem_label.png is a ~250x230 UI label icon (vs. gold's/item's ~64px
			# sources), so it needs a much smaller scale to land at the same
			# on-field size as coins/items — 0.08 puts it at ~20px, matching.
			_crystal_drop_system.spawn(unit.position, crystals, CRYSTAL_DROP_ICON, 0.08)
		update_ui()
		# Kill credit goes to whoever dealt the most damage to this enemy
		var _mdl = unit.most_damage_dealer if is_instance_valid(unit) else null
		if _mdl and is_instance_valid(_mdl) and _mdl.is_player_unit:
			_mdl.kill_count += 1

		# Distribute kill XP equally among all living player heroes
		var living_heroes: int = 0
		for hero in player_units:
			if hero and is_instance_valid(hero):
				living_heroes += 1

		if living_heroes > 0:
			# Quick Learner meta-upgrade (2026-07-10): +25%/level to hero combat
			# XP specifically — deliberately NOT applied to the account-level
			# player_xp pool below, since that curve was hand-tuned to a
			# specific round target (see GameState.player_xp_to_level) and this
			# upgrade shouldn't silently blow through it.
			# 2026-08-03: hero battle XP now rides "quick_learner" (the Mentor
			# spoke). "bonus_xp" was this upgrade's old key and has been
			# repurposed for account XP below, which had no upgrade at all.
			var xp_per_hero: float = float(unit.xp_reward) / float(living_heroes)
			var top_level: int = _top_hero_level(player_units)
			for hero in player_units:
				if hero and is_instance_valid(hero):
					hero.kill_xp += xp_per_hero * _hero_xp_node_mult(hero, top_level)

		# Player/account level (2026-07-04): a SHARE of every kill's total XP also
		# feeds the account-wide pool that grows team size — see game_state.gd.
		# Scholar (2026-08-03) is the only multiplier on the account pool. The
		# curve is hand-tuned to a round target (GameState.player_xp_to_level),
		# so the per-node step is deliberately smaller than hero XP's.
		game_state.add_player_xp(float(unit.xp_reward) * PLAYER_XP_SHARE
			* (1.0 + float(Progression.get_bonus("bonus_xp")) / 100.0))

		# Loot ONLY drops from enemies that were actually wielding an item — the
		# exact item you saw on it mid-fight, no re-roll. Enemies that spawned
		# empty-handed drop nothing (no separate random death-drop roll). Items
		# are physical too (2026-07-21) — tossed on the field like gold/crystals,
		# added to the bag only when a drop actually arrives.
		if not unit.held_items.is_empty():
			for held in unit.held_items:
				var itex: Texture2D = GearIcons.icon_for(held)   # legacy art or component composite
				if itex and _item_drop_system:
					_item_drop_system.spawn(unit.position, held, itex, 0.3, held.icon_color)
				else:
					_equipment_inventory.add_item(held)   # no icon art — fall back to instant credit

	update_team_health_bars()


