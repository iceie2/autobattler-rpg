func _integrate_scene_units() -> void:
	# Move any UnitBase-derived nodes under the runtime battle_grid and normalize them
	for child in battle_grid_node.get_children():
		if child == battle_grid:
			continue
		if child and child is UnitBase:
			var unit = child
			# Normalize element to NORMAL
			unit.current_element = UnitBase.Element.NORMAL
			# Compute grid position from current world position (if possible)
			var grid_pos = battle_grid.world_to_grid(unit.position)
			# Snap units sitting on the dividing row (y=4) into the front player row
			if grid_pos.y == battle_grid.grid_height - 5:
				grid_pos.y = battle_grid.grid_height - 4
			unit.grid_position = grid_pos
			# Bottom 4 rows = player zone; top 4 rows = enemy zone; middle row blocked
			if grid_pos.y >= battle_grid.grid_height - 4:
				unit.is_player_unit = true
			elif grid_pos.y < 4:
				unit.is_player_unit = false
			else:
				unit.queue_free()   # on the dividing row after snap — discard
				continue
			# Reparent under the runtime battle_grid for consistent transforms
			unit.reparent(battle_grid)
			# Place into grid data structure
			if battle_grid.place_unit(unit, grid_pos):
				if unit.is_player_unit:
					unit.home_position = grid_pos
					player_units.append(unit)
					_rebuild_synergy_display()
				else:
					enemy_units.append(unit)
				unit.died.connect(_on_unit_died.bind(unit))
				unit.battle_manager = auto_battle_manager
				unit.damage_text_container = damage_text_container
				unit.update_visuals()


var max_player_units: int = Balance.TEAM_SIZE_BASE   # recomputed from player level

# ── Player level / team-size curve (2026-07-04) ───────────────────────────────
# 2026-07-10 (user report "I'm level 1, I shouldn't be able to buy another hero
# yet"): base dropped 4 → 1 — the field cap IS your player level now. Heroes
# bought past the cap go to the bench (see the bench section below) instead of
# being refused, and get deployed as levels unlock slots.
# 2026-08-07 (user spec, second pass — the first pass mis-modelled this as a
# tier list of level caps). There is no per-level tier table and no level-cap
# node: team size is simply
#     player level  +  hero_slots nodes  +  event bonuses,   clamped to 20.
# Player level is gated by the XP CURVE (Balance.PLAYER_XP_GROWTH), which is
# what makes a fresh account land at ~8 and a fully-invested one at 16-18.
# The clamp is what makes the +6 slot nodes an EARLY-GAME boost rather than a
# permanent +6: at level 16 they buy nothing, because 16+6 still clamps to 20.
func _team_size_for_level(lvl: int) -> int:
	return Balance.TEAM_SIZE_BASE + (lvl - 1)

var _event_team_size_bonus: int = 0   # persistent per-run "Reinforcements" event bonus

# ── Event run-state (2026-09-19, see RUN_MAP_PLAN.md §4) ──────────────────────
# _events_seen  — {def_id: true}, drains the catalog before it repeats and gates
#                 `unique` events. Saved with the run.
# _run_flags    — what the run REMEMBERS about your choices ("refused_duel",
#                 "debt": 40). Callback events read these; without them a pool of
#                 events is just a pool, not a run with a memory.
# The two shop modifiers are set by economy events and consumed by the next
# merchant visit (see _on_battle_round_started / _open_merchant).
var _events_seen: Dictionary = {}
var _run_flags: Dictionary = {}
# ── Run map (2026-09-19) ──────────────────────────────────────────────────────
# MAP_MODE off = the pre-map behaviour, exactly: fixed relic/merchant rounds and
# a per-round difficulty pick. See the RUN MAP section further down.
const MAP_MODE := true
var _run_map: RunMap = null
var _run_map_screen: RunMapScreen = null
var _map_node: Dictionary = {}       # the node being played right now
# Whether the open event/shop modal was entered FROM a map node, which decides
# whether closing it returns to the map or starts the battle (classic flow).
var _event_from_map: bool = false
var _shop_from_map: bool = false
# Modifiers an event laid on the NEXT fight: {"extra_enemies": n, "reward_tier": t}.
# Consumed when that wave is built and when its reward is rolled, then cleared —
# they last exactly one battle, which is what the event text promises.
var _next_wave_mods: Dictionary = {}
# What a scrapped item pays, as a share of its shop price at the current round.
# Mirrors Balance.SELL_REFUND's intent for heroes (buy 10 / sell 5): selling
# back is always a loss, so hoarding-then-dumping can't be an income strategy.
const SALVAGE_RATIO := 0.4
var _shop_discount_pending: float = 0.0
var _shop_sale_slots_pending: int = 0

func _recompute_max_player_units() -> void:
	max_player_units = mini(
			_team_size_for_level(game_state.player_level)
					+ Progression.get_bonus("hero_slots") + _event_team_size_bonus,
			Balance.MAX_TEAM_SIZE)

# ── Bench / sideboard (2026-07-10 user spec) ──────────────────────────────────
# Heroes bought past the field cap wait here instead of being refused. Benched
# units stay alive as hidden scene children (keeping their HP/level/equipment)
# but are NOT in player_units, so battle, between-round bonuses, and drag
# enabling all skip them naturally. Click a bench slot during prep to deploy;
# right-click a fielded hero during prep to bench it.
var bench_units: Array = []

func max_bench_slots() -> int:
	return Balance.BENCH_BASE_SLOTS + Progression.get_bonus("bench_slots")

# Share of a kill's hero-XP that also feeds the player-level pool. Moved to
# Balance 2026-08-07 so the xpcurve harness and the game read one number.
const PLAYER_XP_SHARE := Balance.PLAYER_XP_SHARE

func _on_player_leveled_up(new_level: int) -> void:
	_recompute_max_player_units()
	info_label.text = "Level up! Team size is now %d." % max_player_units
	update_ui()

# Wave locking system
var _current_wave_spec: Array = []  # locked enemy roster for this wave (before instantiation)
var _locked_difficulty: int = -1    # locked difficulty for this wave (-1 = not locked yet)
# Balance-baseline instrumentation (2026-08-03, see BALANCE_PLAN.md). Snapshotted
# at run START (not at death) because the crystal wallet changes mid-run — asking
# Progression at the game-over screen would report the post-run state and make
# every entry self-referential. The difficulty trace records the player's actual
# per-round risk appetite, which is a real input to the power curve here: Easy/
# Normal/Hard is a per-wave choice with escalating round rewards, not a mode.
var _run_start_nodes: int = 0
var _run_start_spent: int = 0
var _run_difficulty_choices: Array = []
# Last roster the player actually FIELDED, captured at round lock-in rather than
# read off survivors at run end — see the snapshot site in the Ready handler.
var _run_team_fielded: Array = []
var _run_team_fielded_levels: Array = []
# Last player death this run (hero/killed_by/wave), for the export's "died to
# what" — set in _on_unit_died, empty on a win.
var _run_last_death: Dictionary = {}
# Passive-pick choices made at the equipment combine dialog this run: one
# entry per fusion, {"cap": int, "picked": Array[String], "available": Array[String]}.
var _run_passive_picks: Array = []
# Local telemetry identity and compact run summary. Detailed events are also
# appended to user://telemetry_v2.jsonl so a crash does not erase the run.
var _telemetry_run_id: String = ""
var _telemetry_seq: int = 0
var _telemetry_battles: Array = []
var _telemetry_decisions: Array = []
var _telemetry_battle_resources: Dictionary = {}
var _telemetry_meta_start: Dictionary = {}
var _telemetry_relic_offers: Array = []
# One spec per difficulty, generated at most once per round (2026-07-27). Same
# reasoning as _rolled_rewards below it: generate_wave_spec() ends in a
# randi()%3 for enemy levels (WaveScaler.enemy_level_for_round), and it used to
# be called fresh on every difficulty preview AND again on READY — so the wave
# you positioned against was never quite the wave you fought (levels drifted by
# up to ±2 after you committed). Caching makes the preview a promise while
# leaving the difficulty CHOICE fully live: flipping difficulty still shows that
# tier's real roster, it just stops re-rolling the one you already saw.
var _wave_specs: Dictionary = {}    # difficulty → spec Array, cleared each round
var _intent_overlay: IntentOverlay = null   # prep-phase enemy intent arrows

func start_new_game() -> void:
	Progression.relic_milestones.begin_run()
	# Economy v3 (2026-07-03): 50 → 10 starting gold, heroes cost 10 — the whole
	# economy moved to coin-drop scale (see GoldCoin / gold_drops_for_unit).
	# 2026-07-10: Call to Arms (the crystal-shop tree's always-active root node)
	# replaces the flat starting-gold baseline — every run now starts with 1
	# free recruited hero instead of gold. Head Start pays after every ROUND
	# now (2026-07-16 economy pair rework). 2026-08-01: the new "Starting Gold"
	# upgrade (key "starting gold", distinct from Head Start's "starting_gold")
	# is a genuine flat run-start bonus, so runs no longer strictly begin at 0.
	game_state.gold = Progression.get_bonus("starting gold")
	game_state.crystals = 0
	_run_kills = 0
	# Balance baseline (2026-08-03): snapshot meta investment before the run can
	# change it. See BALANCE_PLAN.md — death wave is fitted against _run_start_nodes.
	_run_start_nodes = Progression.nodes_owned()
	_run_start_spent = Progression.total_spent()
	_run_difficulty_choices = []
	_run_team_fielded = []
	_run_team_fielded_levels = []
	_run_last_death = {}
	_run_passive_picks = []
	_telemetry_run_id = RunTelemetry.new_run_id()
	_telemetry_seq = 0
	_telemetry_battles = []
	_telemetry_decisions = []
	_telemetry_battle_resources = {}
	_telemetry_meta_start = _telemetry_meta_snapshot()
	_telemetry_event("run_started", {
		"meta": _telemetry_meta_start.duplicate(true),
		"starting_resources": {"gold": game_state.gold, "crystals": game_state.crystals},
	})
	game_state.reset_player_level()
	_event_team_size_bonus = 0
	_events_seen.clear()
	_run_flags.clear()
	_shop_discount_pending = 0.0
	_shop_sale_slots_pending = 0
	_recompute_max_player_units()
	_relic_inventory = RelicInventory.new()
	_relic_waves_done.clear()
	_shop_rounds_done.clear()
	_hydra_chosen_element = -1
	_hydra_element_chosen = false
	_rebuild_relic_bar()
	for b in bench_units:
		if b and is_instance_valid(b):
			b.queue_free()
	bench_units.clear()
	_rebuild_bench_bar()
	# Full grid reset (2026-08-07 fix): battle_grid.occupied_cells/grid_cells are
	# NOT tied to this scene's lifetime the way player/enemy_units are — if this
	# main_game instance survives a prior run (no scene reload) any cells left
	# occupied by that run's units (dead-but-not-purged, or the position-keyed
	# remove_unit() drift documented on BattleGrid.purge_unit) persist as phantom
	# walls. A fresh run's first 2×2 placement (wave 5's Hill Giant) then silently
	# fails place_unit()'s collision check and gets queue_free'd in _place_at,
	# so the elite round spawns with only its escort. initialize_grid() clears
	# both dicts outright — cheaper and more thorough than sweeping phantoms.
	for u in enemy_units:
		if u and is_instance_valid(u):
			u.queue_free()
	enemy_units.clear()
	battle_grid.initialize_grid()
	# Call to Arms now grants a PICKED hero, not a random one (2026-07-10 user
	# request) — the picker opens once the round-1 relic screen resolves (see
	# _maybe_open_call_to_arms_picker, called from both _on_relic_chosen and
	# _on_battle_round_started's relic block for the no-offers edge case).
	_call_to_arms_pending = true
	if MAP_MODE:
		# The opening relic is shown before battle_round_started fires, so select
		# wave 1's biome background explicitly for the opening screen.
		background_layer.set_biome_from_round(1)
		# Opening cadence: relic -> starting hero -> map. The old flow showed a
		# one-choice map whose only purpose was to open this relic screen; that
		# made the run begin with navigation before the player had anything to
		# navigate with. Consume the mandatory start landmark here and present
		# its real three-choice decision immediately.
		_run_map = null
		_map_node = {}
		_ensure_map_for_biome(0)
		var starts: Array = _run_map.available_next()
		if not starts.is_empty() and int(starts[0].get("type", -1)) == RunMap.NodeType.RELIC:
			_map_node = _run_map.advance_to(String(starts[0]["id"]))
		var offers: Array = Relic.roll_offers(1, _relic_inventory.owned_ids(), 3, _relic_offer_ctx(1))
		if not offers.is_empty():
			_relic_screen_wave = 1
			_relic_rerolls_left = Progression.get_bonus("+1 Reroll")
			_telemetry_relic_offers = _telemetry_relic_ids(offers)
			_relic_screen.present(offers, 1, _relic_rerolls_left)
		else:
			_maybe_open_call_to_arms_picker()
		return
	game_state.start_battle_round()
	open_shop()


# ── STATE MACHINE & UI UPDATE ──────────────────────────────────────────────
func update_ui() -> void:
	# Coin/gem art is part of the currency plates (see UITheme) — number only.
	gold_label.text = "%d" % game_state.gold
	crystals_label.text = "%d" % game_state.crystals
	round_label.text = "Round: %d  ·  Team %d/%d" % [
		game_state.battle_round, player_units.size(), max_player_units]

	# state_label's old "PLAYER TURN"/"AUTO BATTLE"/etc text is gone (2026-07-09
	# user request — that slot is now the player-level XP bar instead, see
	# _build_right_panel). It still shows "Lv %d"; the bar tracks progress to
	# the next level, which is what actually gates team size (see
	# _team_size_for_level) — GAME_OVER already gets its own full modal
	# (_game_over_screen), so losing a text cue there costs nothing.
	state_label.text = "Lv %d" % game_state.player_level
	if _player_xp_bar:
		_player_xp_bar.max_value = max(1.0, game_state.player_xp_to_level)
		_player_xp_bar.value = game_state.player_xp

	match game_state.current_state:
		GameState.State.PLAYER_TURN:
			enable_action_buttons(true)
		GameState.State.AUTO_BATTLE:
			enable_action_buttons(false)
		GameState.State.ENEMY_TURN:
			enable_action_buttons(false)
		GameState.State.GAME_OVER:
			enable_action_buttons(false)

func enable_action_buttons(enabled: bool) -> void:
	spawn_hero_btn.disabled = not enabled
	use_items_btn.disabled = not enabled
	if _merge_btn:
		_merge_btn.disabled = not enabled   # merging is prep-phase only
	ready_btn.disabled = not enabled
	# Info buttons always accessible
	classes_btn.disabled = false
	roster_btn.disabled = false

func enable_unit_dragging(enabled: bool) -> void:
	for unit in player_units:
		if unit and is_instance_valid(unit) and unit is VisualUnit:
			unit.can_be_dragged = enabled
	# Enemy units are never player-controlled — always keep them locked,
	# regardless of the requested state.
	for unit in enemy_units:
		if unit and is_instance_valid(unit) and unit is VisualUnit:
			unit.can_be_dragged = false

# Signal handlers
func _on_state_changed(new_state: GameState.State) -> void:
	update_ui()
	
	match new_state:
		GameState.State.PLAYER_TURN:
			# GameState flips to PLAYER_TURN the moment battle_round_started's
			# handler yields, which is while the row-bonus ceremony is still
			# playing. Hold the prep phase back until it's done — otherwise the
			# shop pops over the heals and units are draggable mid-payout.
			if _ceremony_active:
				_player_turn_deferred = true
			else:
				_enter_player_turn()
		GameState.State.AUTO_BATTLE:
			enable_unit_dragging(false)
			background_layer.set_enemy_zone_visible(false)
			_set_intent_overlay(false)
			info_label.text = "The battle is under way — your heroes fight on their own."
			if _battle_controls:
				_battle_controls.visible = true
		GameState.State.ENEMY_TURN:
			enable_unit_dragging(false)
			background_layer.set_enemy_zone_visible(false)
			info_label.text = "The enemy makes its move..."

	# Hide battle controls outside of auto-battle
	if new_state != GameState.State.AUTO_BATTLE and _battle_controls:
		_battle_controls.visible = false


# The prep phase proper. Split out of _on_state_changed so the round-start
# ceremony can hold it back and run it itself once the payout finishes.
func _enter_player_turn() -> void:
	_player_turn_deferred = false
	_ready_nudged = false   # fresh prep phase — re-arm the unspent-gold warning
	# A hero roll shouldn't survive into a new round (stats/economy have
	# moved on) — see reopen()/has_pending_offer() in hero_shop.gd.
	if _hero_shop:
		_hero_shop.clear_offers()
	if not shop_open:
		open_shop()
	enable_unit_dragging(true)
	background_layer.set_enemy_zone_visible(true)
	_set_intent_overlay(true)
	info_label.text = "Your turn! Buy units, drag them to position (bottom 4 rows), and click READY."


# ── BATTLE ROUND LIFECYCLE ─────────────────────────────────────────────────
func _on_battle_round_started(round_number: int) -> void:
	_last_enemy_death_pos = null
	_dying_units.clear()
	_dying_deadline.clear()
	update_ui()
	print("Battle round %d started!" % round_number)
	# Pay out last round's row bonuses first — revives, heals, XP bars — before
	# the new wave spawns and before any modal (relic / shop / hydra) opens.
	# This awaits, so everything below happens once the ceremony is done.
	await _play_round_start_ceremony()
	# ── Who decides the intensity ─────────────────────────────────────────────
	# Map mode: the NODE decided, back on the map, before the board was dealt —
	# so the tier and the reward are both already fixed and the difficulty panel
	# becomes a briefing (see difficulty_panel.set_briefing_only).
	# Classic mode: lock to Normal and let the player pick from the panel.
	var map_battle: bool = MAP_MODE and not _map_node.is_empty()
	var chosen_tier: int = int(_map_node.get("difficulty", WaveScaler.Difficulty.NORMAL)) \
		if map_battle else WaveScaler.Difficulty.NORMAL
	_locked_difficulty = chosen_tier
	current_difficulty = chosen_tier
	_wave_specs.clear()   # fresh rolls for the new round; stable within it
	_current_wave_spec = _wave_spec_for(_locked_difficulty)
	_instantiate_wave_from_spec(_current_wave_spec)
	# Roll this round's reward for ALL 3 difficulties up front and show them in
	# full — the player picks a difficulty knowing exactly what they'd win, not
	# just vague odds. The roll doesn't change no matter how many times you flip
	# between difficulties this round.
	#
	# Under the map, the node did this when the biome was generated: the reward
	# shown on the map card IS the reward, which is what makes pathing toward a
	# visible Epic a real decision rather than a gamble on odds.
	if map_battle:
		var node_reward: Dictionary = _map_node.get("reward", {})
		# An event promised this fight would pay at a better tier (Bounty Board).
		# Re-roll the node's reward on that tier's odds — the upgrade is the whole
		# reason the player took the harder wave.
		if _next_wave_mods.has("reward_tier"):
			node_reward = RoundReward.roll(int(_next_wave_mods["reward_tier"]), round_number)
			info_label.text = "The bounty pays at %s rates." % \
				WaveScaler.Difficulty.keys()[int(_next_wave_mods["reward_tier"])].capitalize()
		_rolled_rewards = {chosen_tier: node_reward}
	else:
		_rolled_rewards = {
			WaveScaler.Difficulty.NORMAL:   RoundReward.roll(WaveScaler.Difficulty.NORMAL, round_number),
			WaveScaler.Difficulty.VETERAN: RoundReward.roll(WaveScaler.Difficulty.VETERAN, round_number),
			WaveScaler.Difficulty.BRUTAL:   RoundReward.roll(WaveScaler.Difficulty.BRUTAL, round_number),
		}
	if difficulty_panel:
		difficulty_panel.set_briefing_only(map_battle)
		difficulty_panel.current_difficulty = current_difficulty
		difficulty_panel.update_display(_all_difficulty_power(), _rolled_rewards)
		difficulty_panel.set_panel_visible(true)
		_refresh_wave_dossier()

	if WaveScaler.is_boss_round(round_number):
		info_label.text = "⚠ BOSS WAVE %d — a towering Hill Giant leads the assault. Prepare!" % round_number

	# Relic pick at the start of waves 1 / 11 / 21 — a modal over the prep phase.
	# Effects apply immediately (retroactively to units on the team, and to any
	# hero recruited afterwards), so there's no strict ordering vs. the shop.
	# Under the map, relics and the merchant are NODES the player walked to, not
	# entries on a timetable — _on_map_node_chosen opens them. These two blocks
	# are the classic schedule and stay for when MAP_MODE is off.
	if not MAP_MODE and round_number in Relic.RELIC_WAVES and not _relic_waves_done.has(round_number):
		_relic_waves_done[round_number] = true
		var offers: Array = Relic.roll_offers(round_number, _relic_inventory.owned_ids(), 3,
				_relic_offer_ctx(round_number))
		if not offers.is_empty():
			_relic_screen_wave = round_number
			_relic_rerolls_left = Progression.get_bonus("+1 Reroll")
			_telemetry_relic_offers = _telemetry_relic_ids(offers)
			_relic_screen.present(offers, round_number, _relic_rerolls_left)
		else:
			_maybe_open_call_to_arms_picker()

	# Event shop at the start of merchant rounds (ShopGenerator.MERCHANT_ROUNDS) —
	# a modal over the prep phase, like the relic screen. Player shops, then
	# positions/preps as normal, then hits READY. One visit per merchant round.
	if not MAP_MODE and ShopGenerator.is_merchant_round(round_number) \
			and not _shop_rounds_done.has(round_number):
		_shop_rounds_done[round_number] = true
		_shop_stock = ShopGenerator.roll_stock(round_number, _relic_inventory.owned_ids())
		_settle_merchant_debt()
		# Consume anything an economy event promised for "the next merchant"
		# (see EventCatalog's _pool_economy). Both are one-visit-only.
		if _shop_discount_pending > 0.0:
			ShopGenerator.apply_discount(_shop_stock, _shop_discount_pending)
			info_label.text = "The merchant honours your favour: %d%% off." \
					% int(round(_shop_discount_pending * 100.0))
			_shop_discount_pending = 0.0
		if _shop_sale_slots_pending > 0:
			ShopGenerator.apply_extra_sales(_shop_stock, _shop_sale_slots_pending)
			_shop_sale_slots_pending = 0
		_shop_screen.open(round_number, game_state.gold, _shop_stock)

	# Hydra element pick at the start of wave 30 (the final boss) — a modal over
	# the prep phase, same shape as the relic screen above. The pick is a
	# matchup/strategy call, not a difficulty toggle: the Hydra hits just as
	# hard whichever element gets chosen (see WaveScaler.boss_code_for).
	if WaveScaler.boss_tier(round_number) == 3 and not _hydra_element_chosen:
		_hydra_element_chosen = true
		_hydra_element_screen.present()

	# Run checkpoint at the start of every prep phase (2026-07-17): a crash or
	# quit from here on costs at most this prep's purchases, never the run.
	save_run()

func _on_hydra_element_chosen(element: int) -> void:
	_hydra_chosen_element = element
	if difficulty_panel:
		difficulty_panel.update_display(_all_difficulty_power(), _rolled_rewards)
	info_label.text = "The Hydra will face you as its %s form." % _element_name(element)

func _element_name(element: int) -> String:
	match element:
		UnitBase.Element.FIRE:      return "Fire"
		UnitBase.Element.WATER:     return "Water"
		UnitBase.Element.EARTH:    return "Earth"
		UnitBase.Element.AIR:       return "Air"
		UnitBase.Element.LIGHTNING: return "Lightning"
		_: return "Normal"

# Consumes one "+1 Reroll" crystal tree charge to reroll this visit's 3 relic
# offers. Charges reset every relic screen (waves 1/11/21/...), not per run.
func _on_relic_reroll() -> void:
	if _relic_rerolls_left <= 0:
		return
	_relic_rerolls_left -= 1
	var offers: Array = Relic.roll_offers(_relic_screen_wave, _relic_inventory.owned_ids(), 3,
			_relic_offer_ctx(_relic_screen_wave))
	_telemetry_relic_offers = _telemetry_relic_ids(offers)
	_telemetry_decision("relic_offers_rerolled", {
		"offers": _telemetry_relic_offers.duplicate(),
		"rerolls_left": _relic_rerolls_left,
	})
	_relic_screen.set_offers(offers, _relic_rerolls_left)

func _on_relic_chosen(relic: Dictionary) -> void:
	_telemetry_decision("relic_chosen", {
		"chosen": String(relic.get("id", relic.get("name", ""))),
		"offers": _telemetry_relic_offers.duplicate(),
	})
	# Close at the entry point, not only in the screen's own card handler — the
	# same rule _on_map_node_chosen follows. A modal that only closes on the UI
	# path stays open for every other caller (debug keys, captures, tests), and
	# a stack of half-closed modals is how the opening beat locked up.
	if _relic_screen:
		_relic_screen.visible = false
	# Store it, then apply retroactively to every hero the player owns: board,
	# bench and downed. Board-only left benched heroes without the relic for the
	# rest of the run (VD-21); the per-unit acquisition guard makes a repeat
	# harmless. Newly recruited heroes pick it up in _recruit_hero.
	var owned_copy: Dictionary = _relic_inventory.add_relic(relic)
	_relic_inventory.apply_relic_to_units(owned_copy, player_units + bench_units + _downed_heroes)
	_rebuild_relic_bar()
	update_ui()
	update_team_health_bars()
	if _details and _details.current_unit and is_instance_valid(_details.current_unit):
		_update_details_panel()
	info_label.text = "Relic acquired: %s" % relic.get("name", "?")
	_maybe_open_call_to_arms_picker()
	save_run()   # checkpoint: relic picks are permanent
	# A relic NODE is the biome's entry stop — take the relic, then choose where
	# to go. (In the classic flow the relic screen opens during prep, so there's
	# nothing to return to.)
	#
	# EXCEPT while the free starting-hero picker is up. Re-showing the map over
	# it let the player choose a battle node with no hero picked; starting that
	# round ran _enter_player_turn, which calls _hero_shop.clear_offers() and
	# wiped the cards out of the still-open picker — leaving an empty panel with
	# no way forward. That was the first-playthrough soft-lock. The map comes
	# back in _on_hero_chosen instead, once a hero actually exists.
	if MAP_MODE and not _awaiting_call_to_arms_pick \
			and int(_map_node.get("type", -1)) == RunMap.NodeType.RELIC:
		_open_run_map()

# The relics picked this run, shown as grade-bordered icons in the left sidebar
# (RELICS section, above the bag). Hover an icon for its name + effect.
const RELIC_SLOT := 34

func _rebuild_relic_bar() -> void:
	if not _relic_grid:
		return
	for c in _relic_grid.get_children():
		c.queue_free()

	# Hide the whole RELICS section (heading + grid) until the first relic drops.
	var has_relics: bool = _relic_inventory != null and not _relic_inventory.is_empty()
	if _relic_heading:
		_relic_heading.visible = has_relics
	_relic_grid.visible = has_relics
	if not has_relics:
		return

	for r in _relic_inventory.owned:
		var grade: String = r.get("grade", "D")
		var col: Color = Relic.grade_color(grade)
		var slot := PanelContainer.new()
		slot.custom_minimum_size = Vector2(RELIC_SLOT, RELIC_SLOT)
		var cs := StyleBoxFlat.new()
		cs.bg_color = col.darkened(0.62)
		cs.border_color = col
		cs.set_border_width_all(2)
		cs.set_corner_radius_all(5)
		slot.add_theme_stylebox_override("panel", cs)
		slot.mouse_filter = Control.MOUSE_FILTER_STOP
		var relic_name: String = r.get("name", "")
		var relic_desc: String = r.get("desc", "")
		var momentum_pct_per_sec := 0.0
		for effect in r.get("effects", []):
			if String(effect.get("type", "")) == "momentum":
				momentum_pct_per_sec = float(effect.get("pct_per_sec", 0.0))
		slot.mouse_entered.connect(func(): _show_relic_tooltip(relic_name, grade, relic_desc,
			momentum_pct_per_sec, get_viewport().get_mouse_position()))
		slot.mouse_exited.connect(func(): _hide_relic_tooltip())

		var icon_path: String = Relic.icon_path(r)
		if icon_path != "":
			var tex := TextureRect.new()
			tex.expand_mode  = TextureRect.EXPAND_IGNORE_SIZE
			tex.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			tex.texture      = load(icon_path) as Texture2D
			tex.mouse_filter = Control.MOUSE_FILTER_IGNORE
			slot.add_child(tex)
		else:
			# Fallback: first letters of the relic name if art is missing.
			var lbl := Label.new()
			lbl.text = str(r.get("name", "?")).substr(0, 2)
			lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
			UITheme.apply_font(lbl, UITheme.FONT_VALUE)
			lbl.add_theme_color_override("font_color", col.lightened(0.4))
			lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
			slot.add_child(lbl)
		_relic_grid.add_child(slot)

# The bench: one slot button per capacity slot (filled slots deploy on click,
# empty slots are inert). Rebuilt on any bench change and on capacity change.
const BENCH_SLOT := 52

func _rebuild_bench_bar() -> void:
	if not _bench_grid:
		return
	for c in _bench_grid.get_children():
		c.queue_free()

	var cap: int = max_bench_slots()
	if _bench_heading:
		_bench_heading.text = "BENCH  %d/%d" % [bench_units.size(), cap]

	for i in range(cap):
		var btn := Button.new()
		btn.custom_minimum_size = Vector2(BENCH_SLOT, BENCH_SLOT)
		btn.add_theme_stylebox_override("normal", UITheme.slot_box(false))
		btn.add_theme_stylebox_override("hover", UITheme.slot_box(false))
		btn.add_theme_stylebox_override("pressed", UITheme.slot_box(false))
		btn.add_theme_stylebox_override("disabled", UITheme.slot_box(true))

		if i < bench_units.size() and is_instance_valid(bench_units[i]):
			var unit: VisualUnit = bench_units[i]
			btn.tooltip_text = "%s  ·  Lv %d  ·  Grade %s\n%d/%d HP\nClick to deploy · Right-click to sell (+%dg)\nDrag onto a copy of this hero to merge" % [
				unit.unit_name, unit.level, unit.recruit_grade if unit.recruit_grade != "" else "B",
				unit.current_hp, unit.max_hp, Balance.SELL_REFUND]
			btn.pressed.connect(_deploy_bench_unit.bind(i))
			btn.gui_input.connect(_on_bench_slot_input.bind(i))
			var icon_path: String = VisualUnit.HERO_SPRITE_PATHS.get(unit.unit_class, "")
			if icon_path != "" and ResourceLoader.exists(icon_path):
				var portrait_anim := HeroPortrait.new()
				portrait_anim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
				portrait_anim.mouse_filter = Control.MOUSE_FILTER_IGNORE
				btn.add_child(portrait_anim)
				portrait_anim.setup(unit.unit_class)
			else:
				# Generic-class heroes have LPC sheets, not flat portraits —
				# fall back to initials tinted by element.
				var lbl := Label.new()
				lbl.text = unit.unit_name.substr(0, 2)
				lbl.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
				lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
				lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
				UITheme.apply_font(lbl, UITheme.FONT_VALUE)
				lbl.add_theme_color_override("font_color", unit.get_element_color())
				lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
				btn.add_child(lbl)
		else:
			btn.disabled = true
			btn.tooltip_text = "Empty bench slot — right-click a fielded hero to store it."
		_bench_grid.add_child(btn)

# ── Drag-to-sell drop zone (2026-07-24) ───────────────────────────────────────
# A bottom-centre target that only appears while you're dragging a fielded hero
# during prep. VisualUnit hit-tests it on drop and calls _sell_fielded_hero.
const SELL_ZONE_SIZE := Vector2(250, 96)

func _build_sell_zone() -> void:
	_sell_zone = Panel.new()
	_sell_zone.name = "SellZone"
	_sell_zone.size = SELL_ZONE_SIZE
	_sell_zone.add_theme_stylebox_override("panel", UITheme.panel_box())
	_sell_zone.visible = false
	# Never eat mouse input — the hero being dragged owns the cursor, and this
	# is polled by rect test, not by clicks.
	_sell_zone.mouse_filter = Control.MOUSE_FILTER_IGNORE
	$UI.add_child(_sell_zone)

	_sell_zone_label = Label.new()
	_sell_zone_label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_sell_zone_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_sell_zone_label.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	UITheme.apply_font(_sell_zone_label, UITheme.body_font(22))
	_sell_zone_label.add_theme_color_override("font_color", Color(1.0, 0.85, 0.35))
	_sell_zone_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_sell_zone_label.text = "SELL  +%dg" % Balance.SELL_REFUND
	_sell_zone.add_child(_sell_zone_label)

	_position_sell_zone()
	# Register with VisualUnit — one shared target for every hero on the board.
	VisualUnit.sell_zone = _sell_zone
	VisualUnit.sell_handler = _sell_fielded_hero
	VisualUnit.merge_handler = _merge_fielded_heroes

func _position_sell_zone() -> void:
	if not _sell_zone:
		return
	var vp := get_viewport_rect().size
	_sell_zone.position = Vector2((SIDEBAR_W - SELL_ZONE_SIZE.x) / 2.0, vp.y - SELL_ZONE_SIZE.y - 24.0)
	_sell_zone.z_index = 100

# Called by VisualUnit when a hero is dropped on the sell zone.
func _sell_fielded_hero(unit: VisualUnit) -> void:
	if _sell_zone:
		_sell_zone.visible = false
	if not (unit and is_instance_valid(unit)):
		return
	# Guard rails: prep phase only, and never sell your last hero — that would
	# be an unrecoverable board (READY refuses an empty team anyway).
	if game_state.current_state != GameState.State.PLAYER_TURN:
		info_label.text = "You can only sell heroes between rounds."
		unit._snap_to_grid_cell()
		return
	if player_units.size() <= 1 and bench_units.is_empty():
		info_label.text = "Can't sell your last hero!"
		unit._snap_to_grid_cell()
		return

	var nm := unit.unit_name
	if _equipment_inventory:
		_equipment_inventory.return_all_from_hero(unit)   # gear returns to the bag, never lost
	battle_grid.purge_unit(unit)
	player_units.erase(unit)
	_downed_heroes.erase(unit)
	unit.queue_free()
	game_state.add_gold(Balance.SELL_REFUND)
	info_label.text = "Sold %s for %dg." % [nm, Balance.SELL_REFUND]
	_rebuild_inventory_grid()
	_rebuild_synergy_display()
	update_team_health_bars()
	update_ui()
	save_run()

func _owned_hero_classes() -> Array:
	var out: Array = []
	for u in player_units + bench_units + _downed_heroes:
		if is_instance_valid(u) and not u.is_summoned and not (u.unit_class in out):
			out.append(u.unit_class)
	return out

# Drag a fielded hero onto another fielded copy of the same hero → merge.
func _merge_fielded_heroes(dragged: VisualUnit, target: VisualUnit) -> void:
	_try_merge_heroes(dragged, target)

# Merge two copies of a hero (2026-09-28). Either copy may be on the field or
# the bench (not downed). The survivor (see merge_survivor) climbs one grade;
# the other is consumed, its gear goes back to the bag and half its current XP
# carries over. Prep phase only. Returns true if the merge happened.
#
# Only two copies of the SAME hero AND the SAME grade merge (owner rule
# 2026-09-30, so each tier costs twice the one below); the survivor is the
# higher level (UnitFactory.merge_survivor).
func _try_merge_heroes(dragged: VisualUnit, target: VisualUnit) -> bool:
	if not (dragged and is_instance_valid(dragged) and target and is_instance_valid(target)):
		return false
	var refuse := func(msg: String) -> bool:
		info_label.text = msg
		if dragged in player_units:
			dragged._snap_to_grid_cell()
		return false
	if game_state.current_state != GameState.State.PLAYER_TURN:
		return refuse.call("You can only merge heroes between rounds.")
	for u in [dragged, target]:
		if u in _downed_heroes or not (u in player_units or u in bench_units):
			return refuse.call("Both heroes must be on your field or bench to merge.")
	var survivor: VisualUnit = UnitFactory.merge_survivor(dragged, target)
	var consumed: VisualUnit = target if survivor == dragged else dragged
	var why := UnitFactory.merge_block_reason(survivor, consumed)
	if why != "":
		return refuse.call(why)
	var old_grade := survivor.recruit_grade
	var before := MergeResultScreen.snapshot(survivor)   # for the before/after screen
	if _equipment_inventory:
		_equipment_inventory.return_all_from_hero(consumed)   # gear back to the bag, never lost
	UnitFactory.merge_heroes(survivor, consumed)
	# Data for the toast, captured NOW: it may play after this hero is merged again.
	var toast_info := MergeResultScreen.info_of(survivor)
	var toast_after := MergeResultScreen.snapshot(survivor)
	var consumed_fielded: bool = consumed in player_units
	if consumed_fielded:
		battle_grid.purge_unit(consumed)
		player_units.erase(consumed)
	bench_units.erase(consumed)
	var survivor_fielded: bool = survivor in player_units
	if survivor_fielded:
		# The dragged node may be the survivor, left hovering where it was dropped.
		survivor._snap_to_grid_cell()
	var fly: bool = consumed_fielded and survivor_fielded
	_play_merge_effect(survivor, consumed, fly)
	# The merge toast joins the queue once the board beat has landed (pull + burst
	# peak). It never blocks input, and back-to-back merges wait in its list.
	var delay: float = (MergeVFX.PULL_TIME if fly else 0.0) + 0.55
	get_tree().create_timer(delay).timeout.connect(func() -> void:
		if _merge_toasts:
			_merge_toasts.enqueue_hero(toast_info, before, toast_after))
	_rebuild_bench_bar()
	info_label.text = "Merged! %s: grade %s → %s." % [survivor.unit_name,
		old_grade if old_grade != "" else "B", survivor.recruit_grade]
	_telemetry_decision("hero_merged", {"class": int(survivor.unit_class),
		"grade": survivor.recruit_grade, "level": survivor.level})
	_rebuild_inventory_grid()
	_rebuild_synergy_display()
	update_team_health_bars()
	update_ui()
	if _details and _details.current_unit == survivor:
		_details.refresh_live()
	save_run()
	if _merge_panel and _merge_panel.visible:
		_merge_panel.refresh(player_units, bench_units)
	return true

# The merge beat: when both copies stood on the field the consumed one is drawn
# into the survivor (shrinks + fades along the way), then a gold burst and the
# new grade pop over the survivor. A benched copy has no board node to fly, so it
# is freed at once and only the burst plays. The effect survivor may itself be
# on the bench (hidden) — then the burst plays on the bench bar instead.
func _play_merge_effect(survivor: VisualUnit, consumed: VisualUnit, fly: bool) -> void:
	var burst_at := func() -> void:
		if not is_instance_valid(survivor):
			return
		var fx := MergeVFX.new()
		fx.grade = survivor.recruit_grade
		if survivor.visible and survivor in player_units:
			fx.position = survivor.position + Vector2(0, -battle_grid.cell_size * 0.35)
			battle_grid_node.add_child(fx)
		elif _bench_grid and _bench_grid.is_inside_tree():
			var idx: int = bench_units.find(survivor)
			var slot: Control = _bench_grid.get_child(idx) if idx >= 0 and idx < _bench_grid.get_child_count() else _bench_grid
			fx.scale = Vector2(0.55, 0.55)
			var layer := CanvasLayer.new()
			layer.layer = 30
			add_child(layer)
			fx.position = slot.get_global_rect().get_center()
			layer.add_child(fx)
			fx.tree_exited.connect(layer.queue_free)
	if not fly:
		consumed.queue_free()
		burst_at.call()
		return
	consumed.can_be_dragged = false
	consumed.z_index = survivor.z_index + 1
	var tw := create_tween().set_parallel(true)
	tw.tween_property(consumed, "position", survivor.position, MergeVFX.PULL_TIME) \
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_IN)
	tw.tween_property(consumed, "scale", consumed.scale * 0.2, MergeVFX.PULL_TIME) \
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.tween_property(consumed, "modulate", Color(1.6, 1.4, 0.8, 0.0), MergeVFX.PULL_TIME)
	tw.chain().tween_callback(func() -> void:
		consumed.queue_free()
		burst_at.call())

func _on_battle_started() -> void:
	if difficulty_panel:
		difficulty_panel.set_panel_visible(false)
