func _show_relic_tooltip(relic_name: String, grade: String, desc: String,
		momentum_pct_per_sec: float, mouse_pos: Vector2) -> void:
	if not _relic_tip:
		return
	_relic_tip_name_lbl.text = "%s  [%s-rank]" % [relic_name, grade]
	_relic_tip_base_desc = desc
	_relic_tip_momentum_pct_per_sec = momentum_pct_per_sec
	_relic_tip_desc_lbl.text = _relic_tooltip_description()
	_relic_tip.visible = true
	_reposition_relic_tooltip(mouse_pos)

func _relic_tooltip_description() -> String:
	if _relic_tip_momentum_pct_per_sec <= 0.0:
		return _relic_tip_base_desc
	var elapsed := float(auto_battle_manager.battle_elapsed) if auto_battle_manager and auto_battle_manager.battle_active else 0.0
	var charge_pct := minf(100.0, elapsed * _relic_tip_momentum_pct_per_sec * 100.0)
	return "%s\nCurrent charge: +%.0f%%" % [_relic_tip_base_desc, charge_pct]

func _hide_relic_tooltip() -> void:
	if _relic_tip:
		_relic_tip.visible = false


func _reposition_relic_tooltip(mouse_pos: Vector2) -> void:
	if not _relic_tip:
		return
	var vp := get_viewport().get_visible_rect().size
	var ts := _relic_tip.size
	if ts == Vector2.ZERO:
		ts = _relic_tip.get_minimum_size()
	var pos := mouse_pos + Vector2(16, -ts.y * 0.5)
	pos.x = clamp(pos.x, 4, vp.x - ts.x - 4)
	pos.y = clamp(pos.y, 4, vp.y - ts.y - 4)
	_relic_tip.position = pos


func _reposition_item_tooltip(mouse_pos: Vector2) -> void:
	if not _item_tip:
		return
	var vp  := get_viewport().get_visible_rect().size
	var ts  := _item_tip.size
	if ts == Vector2.ZERO:
		ts = _item_tip.get_minimum_size()
	var pos := mouse_pos + Vector2(16, -ts.y * 0.5)
	pos.x = clamp(pos.x, 4, vp.x - ts.x - 4)
	pos.y = clamp(pos.y, 4, vp.y - ts.y - 4)
	_item_tip.position = pos


func _create_drag_preview(item: EquipmentItem) -> void:
	_hide_item_tooltip()
	if _drag_layer:
		_drag_layer.queue_free()

	_drag_layer = CanvasLayer.new()
	_drag_layer.layer = 35
	add_child(_drag_layer)

	_drag_panel = Panel.new()
	_drag_panel.size = Vector2(48, 48)
	_drag_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_drag_panel.modulate = Color(1, 1, 1, 0.82)
	var s := StyleBoxFlat.new()
	s.bg_color     = item.icon_color.darkened(0.45)
	s.border_color = item.icon_color
	s.set_border_width_all(2)
	s.corner_radius_top_left = 4; s.corner_radius_top_right = 4
	s.corner_radius_bottom_left = 4; s.corner_radius_bottom_right = 4
	_drag_panel.add_theme_stylebox_override("panel", s)

	var tex: Texture2D = GearIcons.icon_for(item)   # legacy art or component composite
	if tex:
		var tr := TextureRect.new()
		tr.texture = tex
		tr.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		tr.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
		tr.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		tr.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_drag_panel.add_child(tr)

	_drag_layer.add_child(_drag_panel)


func _end_item_drag() -> void:
	var item := _dragged_item
	_dragged_item  = null
	_drag_candidate = null
	if _drag_layer:
		_drag_layer.queue_free()
		_drag_layer = null
		_drag_panel = null

	if not item:
		return

	var bag_target := _bag_item_at(get_viewport().get_mouse_position(), item)
	_combine_target = null
	_hide_item_tooltip()
	if bag_target:
		_drop_combine(item, bag_target)
		return

	var mouse     := get_viewport().get_mouse_position()
	var grid_local := mouse - Vector2(battle_grid_node.global_position)
	var cx := int(grid_local.x / battle_grid.cell_size)
	var cy := int(grid_local.y / battle_grid.cell_size)

	if cx < 0 or cx >= battle_grid.grid_width or cy < 0 or cy >= battle_grid.grid_height:
		return
	var unit = battle_grid.get_unit_at(Vector2i(cx, cy))
	if unit and is_instance_valid(unit) and unit.is_player_unit:
		if not _equipment_inventory.apply_to_hero(item, unit):
			info_label.text = "%s has no free equipment slot (%d)!" % [unit.unit_name, _equipment_inventory.hero_item_cap()]
	else:
		info_label.text = "Drop on a hero to equip."

# ── Drag an item onto another to combine (component equipment) ──────────────
func _bag_item_at(pos: Vector2, exclude: EquipmentItem) -> EquipmentItem:
	for pair in _bag_slots:
		var b = pair[0]
		if pair[1] != exclude and b and is_instance_valid(b) and b.get_global_rect().has_point(pos):
			return pair[1]
	return null

func _update_combine_hover() -> void:
	var mouse := get_viewport().get_mouse_position()
	var target := _bag_item_at(mouse, _dragged_item)
	if target != _combine_target:
		_combine_target = target
		if target == null:
			_hide_item_tooltip()
		else:
			_show_combine_preview(_dragged_item, target, mouse)
	elif target and _item_tip and _item_tip.visible:
		_reposition_item_tooltip(mouse)

# What the merge would make, shown while hovering. A lossless merge previews
# the exact result; one that needs levels removed lists the pooled passives.
# The item dropped ONTO is the first input, so it wins icon-centre ties.
func _show_combine_preview(dragged: EquipmentItem, target: EquipmentItem, pos: Vector2) -> void:
	if not (dragged is ComponentEquipmentItem and target is ComponentEquipmentItem):
		return
	var ca := target as ComponentEquipmentItem
	var cb := dragged as ComponentEquipmentItem
	if not ComponentEquipmentRules.can_combine(ca, cb):
		var why := "Legendary is the top tier" if ca.rarity >= EquipmentItem.Rarity.LEGENDARY \
			else "Only items of the same rarity combine"
		_show_item_tooltip(target, pos, "✕ " + why, true)
		return
	var need := ComponentEquipmentRules.levels_to_remove(ca, cb)
	if need == 0:
		var result := ComponentEquipmentRules.combine(ca, cb, ComponentEquipmentInventory.STAT_KEEP)
		if result:
			_show_item_tooltip(result, pos, "Release to combine", true)
		return
	var preview := ComponentEquipmentItem.new("Choose", ca.rarity + 1)
	preview.passive_levels = ComponentEquipmentRules.pooled_levels(ca, cb)
	preview.name = "%s (you pick)" % preview.get_rarity_name()
	_show_item_tooltip(preview, pos, "Release, then remove %d level%s" % [need, "" if need == 1 else "s"], true)

# The equipment merge toast (two items combine, then the stat count-up). One
# instance per manual merge; it plays itself out and frees itself.
func _on_components_merged(base: ComponentEquipmentItem, other: ComponentEquipmentItem,
		result: ComponentEquipmentItem) -> void:
	if _merge_toasts:
		_merge_toasts.enqueue_equipment(base, other, result)

func _drop_combine(dragged: EquipmentItem, target: EquipmentItem) -> void:
	if not (dragged is ComponentEquipmentItem and target is ComponentEquipmentItem \
			and _equipment_inventory is ComponentEquipmentInventory):
		info_label.text = "Drop on a hero to equip."
		return
	var ca := target as ComponentEquipmentItem
	var cb := dragged as ComponentEquipmentItem
	if not ComponentEquipmentRules.can_combine(ca, cb):
		info_label.text = "Only items of the same rarity combine."
		return
	var sources: Array[EquipmentItem] = [target, dragged]
	if ComponentEquipmentRules.levels_to_remove(ca, cb) > 0:
		# The removal menu lives inside the Equipment panel, so it has to open —
		# but if the player wasn't already in it, close it again when they finish
		# (or cancel) instead of leaving them stranded in the Equipment menu.
		var was_open: bool = _equipment_panel.visible
		_equipment_panel.open(_equipment_inventory, player_units)
		_equipment_panel.open_level_removal(sources, not was_open)
		return
	var merged := (_equipment_inventory as ComponentEquipmentInventory).combine_components(sources)
	if merged:
		info_label.text = "Combined into %s (%s)" % [merged.name, merged.get_rarity_name()]


func _sb_accordion(title: String, body: Control, open: bool = false, title_fn: Callable = Callable()) -> Button:
	body.visible = open
	var btn := Button.new()
	# title_fn: optional live title (SET BONUSES shows how many are active).
	# Kept on the button so the owner can refresh it without a second path.
	if title_fn.is_valid():
		btn.set_meta("title_fn", title_fn)
		title = str(title_fn.call())
	btn.set_meta("accordion_body", body)
	btn.text      = title + ("  ▼" if open else "  ▶")
	btn.alignment = HORIZONTAL_ALIGNMENT_LEFT
	UITheme.apply_font(btn, UITheme.header_font(20))
	btn.add_theme_color_override("font_color", _GOLD_COL)
	# UI theme pass 2026-07-03: dobo header plate for section accordions.
	# NOT flat — flat buttons only draw a stylebox while hovered/pressed/
	# focused, so with `flat=true` the header plate was only ever visible on
	# whichever accordion was last clicked (it keeps focus after the click)
	# and every other header rendered with no background at all (2026-07-04
	# user report: "TeamStatus has the UI but only when it's the last thing
	# you clicked"). focus_mode is also disabled so a click doesn't leave
	# any lingering focus-only visual state.
	btn.focus_mode = Control.FOCUS_NONE
	var s := UITheme.header_box()
	for state in ["normal", "hover", "pressed", "focus"]:
		btn.add_theme_stylebox_override(state, s)
	btn.pressed.connect(func():
		body.visible = not body.visible
		_sb_accordion_refresh(btn, title)
	)
	return btn

# Re-label an accordion from its live title (if it has one) and open state.
func _sb_accordion_refresh(btn: Button, fallback_title: String = "") -> void:
	var body := btn.get_meta("accordion_body", null) as Control
	var t: String = fallback_title
	if btn.has_meta("title_fn"):
		t = str((btn.get_meta("title_fn") as Callable).call())
	btn.text = t + ("  ▼" if (body and body.visible) else "  ▶")
