# ── PROCESS LOOP ───────────────────────────────────────────────────────────
func _process(_delta: float) -> void:
	_update_row_tooltip()
	_update_details_panel()
	_update_bag_drag()
	_update_held_item_tooltip()
	_update_field_drop_hover()
	# Throttled combat-UI refresh (see _on_unit_action perf note): rebuild the
	# heavy lists at most 4x/sec, and each rebuilder skips panels that aren't
	# visible. During battle actions fire constantly, so a panel expanded
	# mid-fight repaints within a quarter second anyway.
	_ui_refresh_accum += _delta
	if _ui_refresh_accum >= COMBAT_UI_REFRESH_INTERVAL:
		_ui_refresh_accum = 0.0
		if _milestone_battle.active:
			_record_relic_milestones(_milestone_battle.sample())
		if _combat_ui_dirty:
			_combat_ui_dirty = false
			update_team_health_bars()
			_rebuild_damage_meter()
		if _eh_dirty:
			_eh_dirty = false
			_render_event_log()
		if _perf_overlay_lbl and _perf_overlay_lbl.visible:
			_perf_overlay_lbl.text = "FPS %d   %.1f ms   nodes %d" % [
				Performance.get_monitor(Performance.TIME_FPS),
				Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0,
				Performance.get_monitor(Performance.OBJECT_NODE_COUNT)]

# Hover-collect (2026-07-21): hovering a gold coin, crystal, or item drop on
# the battlefield picks it up immediately instead of waiting for round end.
func _update_field_drop_hover() -> void:
	var mouse: Vector2 = get_viewport().get_mouse_position()
	if _coin_system:
		_coin_system.check_hover(mouse, gold_label.get_global_rect().get_center())
	if _crystal_drop_system:
		_crystal_drop_system.check_hover(mouse, crystals_label.get_global_rect().get_center())
	if _item_drop_system:
		_item_drop_system.check_hover(mouse, _item_drop_target())

# Hovering an enemy's held-item badge on the battlefield shows the same item
# tooltip (name / rarity / stats / passive) as the Unit Details bag. The badge is
# a Sprite2D (no Control hover), so we hit-test the mouse against it here — the
# codebase already polls the mouse in _process for the row/bag tooltips.
func _update_held_item_tooltip() -> void:
	if not _item_tip or _dragged_item:
		return
	var mouse: Vector2 = get_viewport().get_mouse_position()
	var hovered: EquipmentItem = null
	for u in enemy_units:
		if not (u and is_instance_valid(u) and u is VisualUnit):
			continue
		var badge: Sprite2D = u.held_item_badge
		if not (badge and badge.visible and badge.texture and not u.held_items.is_empty()):
			continue
		var xform := badge.get_global_transform_with_canvas()
		var half: Vector2 = (badge.texture.get_size() * 0.5) * xform.get_scale() * 1.3
		var rect := Rect2(xform.origin - half, half * 2.0)
		if rect.has_point(mouse):
			hovered = u.held_items[0]
			break
	if hovered:
		_show_item_tooltip(hovered, mouse)
		_reposition_item_tooltip(mouse)
		_badge_tip_active = true
	elif _badge_tip_active:
		# Only hide tooltips this poll opened — leave Unit-Details-bag hovers alone.
		_hide_item_tooltip()
		_badge_tip_active = false


func _input(event: InputEvent) -> void:
	# Any click / key during the round-start ceremony fast-forwards it. It plays
	# up to 100 times a run, so sitting through the full stagger every time is a
	# tax on anyone who already knows what their rows pay.
	if _ceremony_active and not _ceremony_skip:
		var pressed_click: bool = event is InputEventMouseButton and event.pressed
		var pressed_key: bool = event is InputEventKey and event.pressed and not event.echo
		if pressed_click or pressed_key:
			_ceremony_skip = true
			get_viewport().set_input_as_handled()
			return

	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and not event.pressed:
		if _dragged_item:
			_end_item_drag()
		else:
			_drag_candidate = null

	# Always end a details-panel drag on mouse-up, wherever the cursor is — the
	# panel's own gui_input never sees a release that lands outside its rect.
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and not event.pressed:
		_panel_dragging = false

	# Click-away-to-close (2026-07-06 user request): any left click that lands
	# outside the details panel's own rect closes it — the panel's title-bar
	# drag and its X button both fire inside that rect, so they're unaffected.
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT \
			and unit_details_panel.visible \
			and not unit_details_panel.get_global_rect().has_point(event.position):
		_details.close()

	# Right-click a fielded hero during prep → store it on the bench
	# (2026-07-10 bench system). Same mouse→grid math as _update_row_tooltip.
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_MIDDLE \
			and game_state.current_state == GameState.State.PLAYER_TURN and battle_grid:
		var m: Vector2 = get_viewport().get_mouse_position()
		var lp: Vector2 = m - Vector2(battle_grid_node.position)
		if lp.x >= 0.0 and lp.y >= 0.0:
			var cell := Vector2i(int(lp.x / battle_grid.cell_size), int(lp.y / battle_grid.cell_size))
			if battle_grid.is_valid_position(cell):
				var u = battle_grid.get_unit_at(cell)
				if u and is_instance_valid(u) and u is VisualUnit and u in player_units:
					_bench_unit(u)

	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_B:
			_on_spawn_hero_pressed()
		elif event.keycode == KEY_ESCAPE:
			_close_top_menu()
		elif event.keycode == KEY_F3:
			_toggle_perf_overlay()
		elif event.keycode == KEY_F6 and OS.has_feature("editor"):
			_debug_warp_rounds(5 if not event.shift_pressed else -5)
		elif event.keycode == KEY_F7 and OS.has_feature("editor"):
			_debug_warp_rounds(1 if not event.shift_pressed else -1)

# ── F6/F7: playtest warp (2026-08-04) ────────────────────────────────────────
# Boss/elite work can only be judged by WATCHING it, and the arena harness is
# headless — it can verify balance but can never show a beat. Reaching round 20
# by playing 19 rounds first made every boss iteration unaffordable, so:
#
#   F6         → jump forward to the next multiple of 5
#   Shift+F6   → back to the previous multiple of 5
#   F7 / Shift+F7 → ±1 round (for the round either side of a boss)
#
# Multiples of 5 because that's exactly where the content is: elites on
# 5/15/25/…, bosses on 10/20/30/…. F6 from round 1 lands on 5, then 10, then 15.
#
# Heroes are scaled to ~0.8x the round, which is the middle of the recorded
# wave-20 arena band (lvl 9 = 25% win, lvl 16 = 100%) — a fair fight, not a
# walkover. Deliberately IGNORES Progression.hero_level_cap() (see the level_up
# loop below for how and why).
#
# ⚠️ Levels only ever go UP. Warping BACKWARDS leaves heroes at the higher level,
# so a backward hop is an easier fight than reaching that round normally. Fine
# for "let me see that beat again", misleading for judging difficulty — restart
# the run if you need an honest read on a lower round.
#
# Debug-only and intentionally not surfaced in the UI. It reuses the same
# battle_round + start_battle_round() pair the save-resume path uses (see
# _restore_run), so the prep phase, wave preview, biome, rails and reward rolls
# all regenerate exactly as they would on a normally-reached round.
const DEBUG_WARP_LEVEL_PER_ROUND := 0.8

func _debug_warp_rounds(delta: int) -> void:
	if not game_state:
		return
	var cur: int = game_state.battle_round
	var target: int
	if absi(delta) == 5:
		# Snap to the next/previous multiple of 5 rather than blindly adding 5,
		# so repeated presses stay locked to the elite/boss cadence even after
		# an odd ±1 nudge with F7.
		target = (int(floor(float(cur) / 5.0)) + (1 if delta > 0 else -1)) * 5
		if delta > 0 and target <= cur:
			target = cur + 5
	else:
		target = cur + delta
	target = clampi(target, 1, VICTORY_ROUND)
	if target == cur:
		return

	var lvl: int = maxi(1, int(round(float(target) * DEBUG_WARP_LEVEL_PER_ROUND)))
	var scaled: int = 0
	for u in player_units + bench_units:
		if not (u and is_instance_valid(u) and u.has_method("level_up")):
			continue
		# level_up() in a loop, NOT set_level(): set_level clamps player heroes to
		# Progression.hero_level_cap() (10 by default), which would quietly field
		# level-10 heroes at round 50 and read as "this boss is impossible"
		# instead of "the warp clamped you". Verified by warp_smoke.
		while u.level < lvl:
			u.level_up(true)   # explicit cap bypass — see UnitBase.level_up()
		u.current_hp = u.max_hp
		scaled += 1

	# Player level drives team size; without this a round-40 warp fields a
	# round-1-sized team and the wave reads as absurdly overtuned.
	game_state.player_level = maxi(game_state.player_level, 1 + int(target / 5))
	_recompute_max_player_units()
	# Enough gold to actually use the shop at the round you land on.
	game_state.gold = maxi(game_state.gold, 50 * target)

	game_state.battle_round = target - 1
	if MAP_MODE:
		# Warping crosses biomes, so the old map is the wrong map. Drop it, build
		# the one for where we landed, and walk it forward to the node matching
		# the target wave — otherwise the map still thinks we're back at wave 1
		# and the next choice would rewind the run.
		_run_map = null
		_map_node = {}
		_ensure_map_for_biome(_biome_of_round(target))
		_warp_map_to_wave((target - 1) % RunMap.WAVES_PER_BIOME + 1)
	game_state.start_battle_round()
	_rebuild_bench_bar()
	_rebuild_synergy_display()
	update_team_health_bars()
	update_ui()
	var msg := "WARP → round %d (heroes lvl %d, %d scaled)" % [target, lvl, scaled]
	if scaled == 0:
		msg += " — no heroes yet, recruit some (B) before fighting"
	info_label.text = msg
	print("[DEBUG] %s" % msg)

