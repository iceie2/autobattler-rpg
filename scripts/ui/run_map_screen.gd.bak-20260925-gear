var _tip_difficulty_badge: PanelContainer
var _tip_kicker: Label
var _tip_wave: Label
var _tip_body:  Label
var _tip_facts: HBoxContainer
var _tip_power: Label
var _tip_formation_text: Label
var _tip_reward: HBoxContainer
var _tip_reward_icon: TextureRect
var _tip_reward_name: Label
var _tip_board: Control              # mini enemy formation, see _draw_mini_board
var _tip_formation: Array = []       # what that control is currently drawing
var _tip_grid_w: int = 9
var _tip_ground: String = ""      # decade ground tile behind the mini board
var _tip_unit_name: PanelContainer
var _tip_unit_name_label: Label

var _map: RunMap = null
var _buttons: Dictionary = {}        # node_id -> Button
var _board_btn:  Button              # step off the map to your formation
var _return_btn: Button              # …and the way back

# Callable(round:int, difficulty:int) -> {name, profile, power}, injected by
# main_game. The screen must not know about WaveDirector: a map has to be
# generatable with no scene at all (that's what --mode=map depends on), so the
# one thing that needs the live game is passed IN rather than reached for.
var preview_probe: Callable = Callable()
# Callable(round:int, node_type:int) -> String sprite path, also from main_game.
# Elite and boss nodes wear the ACTUAL creature that decade fields, drawn as a
# silhouette (owner call, 2026-09-19) — that art already shipped, so the map can
# say "a Gale Warden lives up there" with no icon generation at all.
var sprite_probe: Callable = Callable()
var _sprite_cache: Dictionary = {}
# resource_path -> bool, "is this art a cut-out we can silhouette?" See _is_cutout.
# Keyed by path rather than node, because several nodes share one creature.
var _cutout_cache: Dictionary = {}
var _mask_cache: Dictionary = {}      # sprite path -> white stamp of its shape
# Probing builds a whole wave spec, so each node's answer is cached for the life
# of the screen — hovering back and forth across a row shouldn't rebuild specs.
var _preview_cache: Dictionary = {}

func _ready() -> void:
	_build_ui()
	visible = false

func present(map: RunMap, biome_name: String) -> void:
	_map = map
	_preview_cache.clear()
	_sprite_cache.clear()
	_hover_armed = false
	_hover_origin = get_viewport().get_mouse_position()
	_hover_id = ""
	_clear_selection()
	_lift.clear()
	_travel = {}
	# INK THE MAP IN ONCE PER BIOME, NOT ONCE PER VISIT. present() runs every
	# time the map opens — after every fight, event and shop — and a reveal
	# replaying on each of those would turn a flourish into a toll. Keyed on
	# biome AND seed so a new run's first biome reveals even if it shares an
	# index with the last one. A save restored mid-biome sets the key without
	# revealing: the player has seen this map, they just reloaded it.
	#
	# "Not started" means NO STAGE CROSSED, not current_id == "". The first
	# version tested current_id, and main_game consumes biome 1's start landmark
	# BEFORE the map is ever shown (relic -> hero -> map), so the first biome of
	# every run — the reveal every player sees — silently never played.
	var key: String = "%d:%d" % [map.biome, map.generation_seed]
	if key != _reveal_key:
		_reveal_key = key
		_reveal_start = _clock if map.waves_cleared() == 0 else -1.0
	visible = true
	# A previous VIEW BOARD could have left the panel hidden.
	_panel.visible = true
	_overlay.visible = true
	_return_btn.visible = false
	_title.text = biome_name.to_upper()
	# Progress is the fixed path stage, whether that stage was combat or utility.
	_sub.text = "%d of %d stages crossed  ·  choose your path" % [
		map.waves_cleared(), RunMap.WAVES_PER_BIOME]
	_layout()
	_set_biome_backdrop(map.biome)
	_rebuild()
	_center_panel()

func _input(event: InputEvent) -> void:
	if visible and event is InputEventMouseButton and event.pressed \
			and (event as InputEventMouseButton).button_index == MOUSE_BUTTON_LEFT:
		_maybe_dismiss_dossier((event as InputEventMouseButton).position)
		return
	if not visible or _hover_armed or not (event is InputEventMouseMotion):
		return
	var mouse_event := event as InputEventMouseMotion
	if mouse_event.position.distance_to(_hover_origin) < HOVER_ARM_DISTANCE:
		return
	_hover_armed = true
	# mouse_entered may already have fired while the cone was gated. Light the
	# node currently beneath the newly intentional cursor on this movement,
	# without requiring the player to leave and re-enter the circle.
	for id in _buttons:
		var btn: Button = _buttons[id]
		if is_instance_valid(btn) and btn.get_global_rect().has_point(mouse_event.position):
			var node: Dictionary = _map.node_by_id(String(id))
			if not node.is_empty():
				_on_node_hover(node)
			return

# Size the panel to the viewport and derive node spacing from it. Everything
# here is a function of the real window, so the map fills an ultrawide screen
# and still fits a small one.
# A click that lands on neither a node nor the card closes the dossier.
#
# Hit-tested against the rects rather than leaning on which control consumed
# the event: the node buttons are MOUSE_FILTER_PASS, so their clicks reach this
# handler too, and "was it handled" cannot tell the two cases apart.
func _maybe_dismiss_dossier(at: Vector2) -> void:
	if _selected_id == "":
		return
	if _tip and _tip.visible and _tip.get_global_rect().has_point(at):
		return
	for btn in _buttons.values():
		if (btn as Button).get_global_rect().has_point(at):
			return
	_clear_selection()

func _layout() -> void:
	var vp: Vector2 = get_viewport().get_visible_rect().size if get_viewport() 		else Vector2(PANEL_W, PANEL_H)
	if vp.x < 100.0 or vp.y < 100.0:
		vp = Vector2(PANEL_W, PANEL_H)     # headless / zero-size viewport
	_panel_size = (vp * SCREEN_FILL).floor()
	_panel.size = _panel_size
	_backdrop.size = _panel_size
	_backdrop.position = Vector2.ZERO
	var header_w: float = minf(1100.0, maxf(500.0, _panel_size.x - 300.0))
	_header.position.x = (_panel_size.x - header_w) * 0.5
	_header.size.x = header_w
	_title.size.x = _panel_size.x
	_sub.size.x = _panel_size.x
	_board_btn.position = Vector2(_panel_size.x - _board_btn.size.x - 24.0, 20.0)
	_canvas.size = Vector2(_panel_size.x, _panel_size.y - 100.0)

	# ── WHY THE TRAIL RUNS ACROSS AND NOT UP ─────────────────────────────────
	# A biome is ELEVEN stages deep and at most FOUR lanes wide. Stacked, that
	# shape is tall and narrow (ratio ~1.1) inside a frame that is wide and short
	# (16:9 → ~1.96), so the eleven stages had to share the 980px of height: an
	# 88px pitch under 71px nodes, i.e. SEVENTEEN PIXELS of air between one stage
	# and the next, while the lanes sat 259px apart and barely half the screen
	# width was used at all. The travel axis was squeezed fifteen times harder
	# than the axis across it, and no amount of shrinking nodes fixes that —
	# eleven rows in 980px caps the pitch no matter what you draw in them.
	#
	# Turned on its side the same graph is ~1.93 — near enough the frame's own
	# ratio that the numbers stop fighting: 170px per stage, 66px of air, and
	# nodes half again as big. Nothing about the MAP changed; run_map.gd still
	# emits the same rows, columns and edges. Only this screen reads them
	# differently, which is why --mode=map is untouched by the switch.
	var stages_n: int = maxi(2, _map.rows.size() if _map else 11)
	_stage_gap = (_canvas.size.x - 2.0 * STAGE_MARGIN) / float(stages_n - 1)
	var widest: int = 2
	if _map:
		for row in _map.rows:
			widest = maxi(widest, row.size())
	# VD-14: a map with a 5-wide row draws its nodes at NODE_SCALE_WIDE. Lane
	# spacing is set by the WIDEST row on the map, so one 5-wide row tightens
	# every lane in the biome; shrinking the nodes buys that room back (owner:
	# "im okay with making the nodes like 80-90% size so 5 can fit better").
	# Maps without one keep full-size nodes — big discs are what make the
	# silhouettes readable, so they're only given up where the room is needed.
	_node_scale = (NODE_SCALE_WIDE if widest >= 5 else 1.0) * NODE_SCALE_ALL
	_node_r = clampf(_stage_gap * 0.34, 22.0, 52.0) * _node_scale
	# Reserve the node's own radius at BOTH ends before dividing, plus a little
	# over for the pips that hang below a fight disc. Dividing the raw height (as
	# the vertical version did) put the top lane of a four-wide stage three
	# pixels above the canvas, tucked under the title.
	_lane_gap = minf(
		# One additional virtual lane is deliberate breathing room for generated
		# stage offsets. Without it, the old centred grid used every vertical pixel
		# and any honest asymmetry pushed the outer nodes off-screen.
		(_canvas.size.y - 2.0 * _node_r - 44.0) / float(maxi(1, widest)), 260.0)

# The decade's own painted plate, the same one the arena's side strips use, so
# the map looks like the place you are walking through and changes with it.
