func _process(delta: float) -> void:
	_clock += delta
	_ease_lifts(delta)
	if _reveal_start >= 0.0 and _clock - _reveal_start > _reveal_duration():
		_reveal_start = -1.0
	# The travel beat owns the screen while it runs: it finishes by closing the
	# map and emitting node_chosen, so nothing below may open a card under it.
	if not _travel.is_empty():
		_travel["t"] = float(_travel["t"]) + delta / TRAVEL_SECONDS
		if float(_travel["t"]) >= 1.0:
			var arrived: Dictionary = _travel["node"]
			_travel = {}
			_finish_enter(arrived)
		elif visible:
			_canvas.queue_redraw()
		return
	# Rest on a node and it opens itself. Only while nothing is already open,
	# so the timer can never fight a card that is up.
	if visible and _hover_id != "" and _selected_id == "":
		_dwell += delta
		if _dwell >= DOSSIER_DWELL and _map != null:
			var dwelt: Dictionary = _map.node_by_id(_hover_id)
			if not dwelt.is_empty():
				open_dossier(dwelt, false)
	else:
		_dwell = 0.0
	# The card is CENTRED, not stuck to the cursor (owner call). It carries a
	# board preview now, which makes it far too big to trail a mouse — it ended
	# up half off-screen, and a panel you have to chase is worse than one that
	# always appears in the same place.
	if _tip.visible:
		var vp: Vector2 = get_viewport().get_visible_rect().size
		_tip.global_position = ((vp - _tip.size) * 0.5).floor()
	# The frontier ring pulses, so the canvas redraws while the screen is up.
	if visible and _map != null:
		_canvas.queue_redraw()

# ── Layout ────────────────────────────────────────────────────────────────────
# THE ONE FUNCTION THAT KNOWS WHICH WAY THE MAP FACES. Everything visual —
# the edges, the discs, the invisible hit targets — is placed through here, so
# the orientation is a property of these ten lines and nothing else.
#
# Stage 0 sits at the LEFT and the boss at the right: the run reads as a
# distance travelled across the biome, which is also what the painted backdrop
# behind it depicts.
#
# Lane 0 sits at the TOP (owner call). Difficulty ascends downward — the easy
# road is the high road, the brutal one drops into the valley — and a stage's
# lanes are centred on the canvas, so a 1-node start and a 3-node boss stage
# share a centre line.
func _node_pos(node: Dictionary) -> Vector2:
	var r: int = int(node["row"])
	var rows_total: int = _map.rows.size()
	var x: float = STAGE_MARGIN + float(r) * _stage_gap
	x += float(node.get("layout_stage", 0.0)) * _stage_gap
	var row_nodes: Array = _map.nodes_in_row(r)
	var idx: int = 0
	for i in range(row_nodes.size()):
		if String(row_nodes[i]["id"]) == String(node["id"]):
			idx = i
	var default_lane: float = float(idx) - float(row_nodes.size() - 1) * 0.5
	var lane: float = float(node.get("layout_lane", default_lane))
	var y: float = _canvas.size.y * 0.5 + lane * _lane_gap
	# Pre-asymmetry saves do not carry layout_lane. Preserve their old gentle
	# stage wobble rather than silently rearranging an in-progress run.
	if not node.has("layout_lane"):
		y += sin(float(r) * 1.3) * 16.0
	var safe_y: float = _node_r * 1.65
	y = clampf(y, safe_y, _canvas.size.y - safe_y)
	return Vector2(x, y) if rows_total > 0 else Vector2.ZERO

func _rebuild() -> void:
	for b in _buttons.values():
		b.queue_free()
	_buttons.clear()
	# The buttons that would have fired mouse_exited are gone, so a hover that
	# survived a rebuild would leave one fork glowing with no cursor on it. The
	# open dossier goes with them — it describes a node on the map we just
	# replaced.
	_hover_id = ""
	_clear_selection()
	if _map == null:
		return

	var reachable: Dictionary = {}
	for n in _map.available_next():
		reachable[String(n["id"])] = true

	# Buttons are INVISIBLE hit targets; everything visual is drawn in one pass
	# in _draw_map. Godot's Button theming can't express "dim disc, bright ring,
	# pulsing frontier" without a stylebox per state per grade, and the first
	# version that tried (flat buttons tinted by grade) came back unreadable —
	# every node looked the same shade of grey and you could not tell which ones
	# you were allowed to walk to, which is the only thing this screen must say.
	for row in _map.rows:
		for node in row:
			var id: String = String(node["id"])
			var btn := Button.new()
			btn.flat = true
			btn.focus_mode = Control.FOCUS_NONE
			btn.modulate = Color(1, 1, 1, 0)      # invisible, still hit-tests
			btn.size = Vector2(_node_r * 2.2, _node_r * 2.2)
			btn.position = _node_pos(node) - Vector2(_node_r * 1.1, _node_r * 1.1)
			# NOT disabled on unreachable nodes any more. A click is now the only
			# way to read a fight, so a disabled button would make the whole
			# map beyond the next fork unscoutable.
			btn.mouse_filter = Control.MOUSE_FILTER_PASS
			btn.pressed.connect(_on_node_pressed.bind(node))
			btn.mouse_entered.connect(_on_node_hover.bind(node))
			btn.mouse_exited.connect(func():
				if _hover_id == id:
					_hover_id = "")
			_canvas.add_child(btn)
			_buttons[id] = btn
	_canvas.queue_redraw()

func _draw_map() -> void:
	if _map == null:
		return
	_refresh_cone()
	var reachable: Dictionary = {}
	for n in _map.available_next():
		reachable[String(n["id"])] = true

	# ── Edges first, so nodes sit on top of them ─────────────────────────────
	for row in _map.rows:
		for node in row:
			var from: Vector2 = _node_pos(node)
			var here: bool = String(node["id"]) == _map.current_id
			var walked: bool = _map.cleared.has(String(node["id"]))
			for cid in node["children"]:
				var child: Dictionary = _map.node_by_id(String(cid))
				if child.is_empty():
					continue
				var to: Vector2 = _node_pos(child)
				# THE ROAD IS ONE UNBROKEN GOLD LINE THAT GROWS.
				#
				# Owner call, and it replaces the old three-weight encoding.
				# Gold used to mean "a choice you may take", which put two
				# bright forks in front of you and left the road BEHIND you
				# white — so the eye read the map as a menu, not as a journey.
				# Now gold means TRAVELLED: start -> ... -> the node you stand
				# on, and nothing else. The forks ahead stay hairlines until
				# you hover one, at which point that single edge lights as a
				# preview of the road extending, and lands permanently when
				# you take it.
				#
				# `walked` is `cleared`, and the node you are STANDING on is
				# not cleared (RunMap.advance_to only clears the one you left),
				# so the last leg — previous -> here — has to be spelled out or
				# the gold stops one node short of the player. That gap is
				# exactly what this was reported for.
				var lit: bool = walked and (_map.cleared.has(String(cid))
					or String(cid) == _map.current_id)
				var live: bool = (here and reachable.has(String(cid))
					and String(cid) == _focus_id())
				# An edge is only as bright as its dimmer end, so a fork leading
				# out of the hovered cone fades with the node it leads to
				# instead of staying lit from a bright parent.
				var depth_alpha: float = minf(_stage_visibility(node, reachable),
					_stage_visibility(child, reachable))
				# During the reveal an edge draws itself out of its parent once
				# the parent has half-landed, so the ink visibly flows forward.
				var drawn: float = _reveal_row(int(node["row"]),
					REVEAL_NODE_POP * 0.5, REVEAL_EDGE_DRAW)
				if drawn <= 0.0:
					continue
				# One polyline per stroke rather than a chain of segments: an
				# antialiased strip has no overlapping joints, so a translucent
				# curve doesn't pick up darker beads at every vertex.
				var pts: PackedVector2Array = _edge_points(from, to, drawn)
				_canvas.draw_polyline(pts, Color(0, 0, 0, 0.9 * depth_alpha),
					(6.0 if (lit or live) else 3.0), true)
				# Slightly stronger than it needs to be on a flat panel: these
				# now run over a painted biome plate, and a hairline at 0.28
				# disappeared into the rock. BACKDROP_DIM is the other half of
				# this trade if the plates still read too busy.
				var col := Color(1, 1, 1, 0.42 * depth_alpha)
				var w := 2.0
				if lit:
					col = ROAD_GOLD; w = 3.0
				elif live:
					# The preview is the same gold one step brighter and one
					# pixel fatter, so "about to be road" and "is road" read as
					# the same material rather than two different states.
					col = ROAD_GOLD_HOVER; w = 4.0
				_canvas.draw_polyline(pts, col, w, true)
				# Flow runs only INSIDE the lit cone and never over road already
				# walked. The edge into the hovered node isn't in the cone (the
				# cone starts AT that node), so the gold preview keeps that leg
				# and the dashes carry on from there.
				if not _cone.is_empty() and not lit and drawn >= 1.0 \
						and _cone.has(String(node["id"])) and _cone.has(String(cid)):
					_draw_flow(pts, _clock * FLOW_SPEED, FLOW_COLOR, 2.5)
				# The road growing toward the node just chosen, behind the marker.
				if not _travel.is_empty() and String(node["id"]) == String(_travel["from"]) \
						and String(cid) == String(_travel["to"]):
					_canvas.draw_polyline(_edge_points(from, to, _travel_progress()),
						ROAD_GOLD, 3.5, true)

	# ── The traveller: ON THE PATH, UNDER THE NODES ─────────────────────────
	# A gold token walking the curve toward the node just chosen, at the tip of
	# the road growing behind it. Same easing as the road, so the two never part.
	#
	# Drawn between the edges and the nodes, not after the nodes (owner call,
	# 2026-09-22). It is a thing travelling ALONG the road, so it belongs to the
	# road's layer: as it arrives it slides in under the destination disc rather
	# than landing on top of the creature, and it passes beneath any node the
	# curve happens to skim on the way.
	if not _travel.is_empty():
		var ta: Dictionary = _map.node_by_id(String(_travel["from"]))
		var tb: Dictionary = _map.node_by_id(String(_travel["to"]))
		if not ta.is_empty() and not tb.is_empty():
			var tp: Vector2 = _edge_at(_node_pos(ta), _node_pos(tb), _travel_progress())
			var mr: float = _node_r * 0.24
			_canvas.draw_circle(tp, mr + 7.0,
				Color(ROAD_GOLD.r, ROAD_GOLD.g, ROAD_GOLD.b, 0.22))
			_canvas.draw_circle(tp, mr + 2.5, Color(0, 0, 0, 0.92))
			_canvas.draw_circle(tp, mr, ROAD_GOLD_HOVER)
			_canvas.draw_circle(tp, mr * 0.42, Color(1, 1, 1, 0.95))

	# ── Nodes ────────────────────────────────────────────────────────────────
	var font: Font = ThemeDB.fallback_font
	var pulse: float = 0.5 + 0.5 * sin(Time.get_ticks_msec() * 0.005)
	for row in _map.rows:
		for node in row:
			var id: String = String(node["id"])
			var pos: Vector2 = _node_pos(node)
			var grade_col: Color = UnitFactory.GRADE_COLORS.get(
				String(node["grade"]), Color.WHITE)
			var is_next: bool = reachable.has(id)
			var is_here: bool = id == _map.current_id
			var is_done: bool = _map.cleared.has(id)
			var visibility: float = _stage_visibility(node, reachable)
			var r: float = _node_r
			if int(node["type"]) == RunMap.NodeType.BOSS:
				r = _node_r * 1.25
			elif int(node["type"]) == RunMap.NodeType.ELITE:
				r = _node_r * 1.1
			elif int(node["type"]) == RunMap.NodeType.RELIC:
				# Where the biome BEGINS is a landmark, not another stop on the
				# way — it gets the biggest disc on the map so the eye starts
				# there, and so its biome art has room to be legible at all.
				r = _node_r * 1.45

			# ── Motion: pop in with the reveal, lift under the cursor ────────
			var pop: float = _reveal_row(int(node["row"]))
			if pop <= 0.0:
				continue
			var pop_scale: float = _back_out(pop) if pop < 1.0 else 1.0
			var lift: float = float(_lift.get(id, 0.0))
			r *= (1.0 + HOVER_LIFT * lift) * pop_scale
			var appear: float = clampf(pop * 2.5, 0.0, 1.0)
			# A lifted node casts a soft shadow a few pixels below it. _draw has
			# no blur, so "soft" is three stacked discs of falling alpha — at
			# this size that is indistinguishable from a real feathered shadow.
			# Event, merchant and camp art stands bare on the map — no disc, rim or
			# grade ring. The glyph fallback keeps its disc so it stays legible.
			var node_type: int = int(node["type"])
			var utility_node: bool = node_type in [RunMap.NodeType.EVENT, \
				RunMap.NodeType.MERCHANT, RunMap.NodeType.CAMP]
			# Fight nodes stand bare too (owner, 2026-09-24: "get rid of the black
			# background on the monster camps. just showing the icons like we do
			# for events/camps/shop"). The creature keeps a thin dark outline
			# instead of a disc so it still reads on the painted grass.
			var fight_art: bool = RunMap.is_battle_node(node) \
				and _node_icon(node) != null and _is_silhouette(node)
			var bare: bool = (utility_node and _node_icon(node) != null) or fight_art
			if lift > 0.01 and not bare:
				for i in range(3):
					_canvas.draw_circle(pos + Vector2(0.0, 5.0 * lift),
						r + 7.0 - float(i) * 2.5,
						Color(0, 0, 0, 0.12 * lift * visibility * appear))

			# Fill: bright grade colour where you may GO, muted where you've
			# BEEN, near-black for the rest of the map.
			var fill: Color = Color(0.09, 0.09, 0.12)
			if is_next:
				fill = grade_col.darkened(0.25)
			elif is_here or is_done:
				fill = grade_col.darkened(0.62)
			elif visibility >= 0.6:
				fill = grade_col.darkened(0.72)
			# Applied after the fill is chosen, so a node mid-reveal fades in
			# with its real colour instead of flashing the dim one first.
			visibility *= appear
			fill.a *= visibility
			if not bare:
				_canvas.draw_circle(pos, r + 3.0, Color(0, 0, 0, 0.95 * visibility))   # hard rim
			if bare:
				pass
			elif int(node["type"]) != RunMap.NodeType.RELIC:
				_canvas.draw_circle(pos, r, fill)
			else:
				# ── The start node is a WINDOW INTO THE BIOME ────────────────
				# Owner call: a generic emblem in front, art behind it that
				# changes every biome. The art is the decade's ground tile,
				# brightened while the map behind it is dimmed — so the node
				# that opens a biome is the one place you see that biome
				# properly. Costs no new art, and bespoke per-biome start art
				# drops into start_bg_<slug>.png and takes over.
				#
				# Drawn AFTER the rim disc, not before it. The rim is a filled
				# black circle of radius r+3, so a porthole painted first was
				# simply covered up — which read as "the texture isn't loading"
				# and cost two rounds of brightness tuning before I looked at
				# the draw order.
				#
				# A textured polygon rather than a texture rect because a square
				# plate in a round node shows its corners and _draw has no clip.
				var plate: Texture2D = _start_backplate()
				if plate:
					# The boost is MEASURED from the art, not a constant: the
					# Fire decade's ground averages RGB(47,26,24) against
					# Grassland's (85,125,59), so one hand-picked multiplier
					# leaves half the biomes as black discs.
					var boost: float = _plate_boost(plate)
					var plate_col: Color = Color(boost, boost, boost) \
						if (is_next or is_here) \
						else Color(boost * 0.4, boost * 0.4, boost * 0.42)
					plate_col.a = visibility
					_draw_disc_texture(pos, r, plate, plate_col)
				else:
					_canvas.draw_circle(pos, r, fill)

			# Ring: grade colour, thick and pulsing on the frontier.
			if is_next:
				# The frontier ring carries visibility too. Without it, a sibling
				# fork outside the hovered cone keeps a full-bright pulsing ring
				# on a disc that has already faded, which reads as a rendering
				# fault rather than as "you can't get there from here".
				_canvas.draw_arc(pos, r + 6.0 + pulse * 3.0, 0.0, TAU, 32,
					Color(1, 1, 1, 0.9 * visibility), 2.0)
				# The white pulse stays on a bare event: it is the "you can go
				# here" cue, not part of the button.
				if not bare:
					var next_ring: Color = grade_col
					next_ring.a *= visibility
					_canvas.draw_arc(pos, r, 0.0, TAU, 32, next_ring, 3.5)
			elif not bare:
				var ring_col: Color = grade_col.darkened(0.45 if not (is_here or is_done) else 0.2)
				ring_col.a *= visibility
				_canvas.draw_arc(pos, r, 0.0, TAU, 32, ring_col, 2.0)

			# Where you're standing gets its own marker so "here" never reads as
			# "choosable".
			if is_here:
				_canvas.draw_arc(pos, r + 10.0, 0.0, TAU, 32, Color(1, 1, 1, 0.95), 3.0)

			# Icon if the art exists, letterform glyph until it does. Both take
			# the tier tint, so the three-colour read works before the art lands.
			var gcol: Color = _icon_color(node, is_next or is_here)
			gcol.a *= visibility
			var icon: Texture2D = _node_icon(node)
			if icon:
				if _is_silhouette(node):
					# A creature sprite is a FILLED shape, so it can't be tinted
					# like line art — but it CAN be flooded with one. Owner call
					# (2026-09-22): the CREATURE carries the tier colour and the
					# disc behind it is black, not the other way round. The old
					# way spent the node's whole area on the difficulty and left
					# the creature as a hole punched in it, so a row of fights
					# read as three fields of colour with animals cut out of
					# them — and the silhouette is the thing you are actually
					# trying to recognise. It also lines fights up with the
					# event, shop and camp nodes, which were already a tinted
					# mark on a dark disc.
					#
					# Keeps the sprite's aspect — none are square.
					#
					# CONTAINED BY BOTH AXES, not just height. Fitting by height
					# alone (the original) let a wide plate spill straight out of
					# its disc: every boss sprite is 1408x768, so a 130px boss
					# node drew a 202px-wide creature lying across its neighbours
					# and off the panel edge. It was invisible for a while
					# because the capture harness had no sprite probe and the
					# nodes used to be smaller. The hover card's mini board
					# already solved this — same formula, same reason.
					# draw_texture_rect MULTIPLIES by the modulate, so handing it
					# the painted sprite and a green tint returns sprite-colour
					# x green — which is mud, and is exactly what the first
					# attempt at this flip produced. The shape has to come from
					# a WHITE mask of the sprite's alpha. If one can't be built,
					# fall back to the old reading (black creature on a tier
					# disc) rather than draw the muddy version.
					var mask: Texture2D = _silhouette_mask(icon)
					var aspect: float = icon.get_width() \
						/ maxf(1.0, float(icon.get_height()))
					# Bare creatures fill the old disc's footprint, not its inside.
					var fit_h: float = r * (2.1 if bare else 1.7)
					var fit_w: float = r * (2.3 if bare else 1.8)
					var sh: float = minf(fit_h, fit_w / maxf(0.01, aspect))
					var sw: float = sh * aspect
					var body := Rect2(pos - Vector2(sw, sh) * 0.5, Vector2(sw, sh))
					var tier: Color = gcol if (is_next or is_here) \
						else gcol.darkened(0.35)
					if mask and bare:
						var ink := Color(0.03, 0.03, 0.05, 0.9 * visibility)
						for o in [Vector2(2, 0), Vector2(-2, 0), Vector2(0, 2), Vector2(0, -2)]:
							_canvas.draw_texture_rect(mask, Rect2(body.position + o, body.size),
								false, ink)
						_canvas.draw_texture_rect(mask, body, false, tier)
					elif mask:
						_canvas.draw_circle(pos, r,
							Color(0.05, 0.05, 0.07, 0.95 * visibility))
						_canvas.draw_texture_rect(mask, body, false, tier)
					else:
						_canvas.draw_circle(pos, r, tier)
						_canvas.draw_texture_rect(icon, body, false,
							Color(0.05, 0.05, 0.07, 0.95 * visibility))
				else:
					var utility_icon_scale: float = 1.2 if node_type == RunMap.NodeType.EVENT \
						else (1.3 if node_type in [RunMap.NodeType.MERCHANT, RunMap.NodeType.CAMP] else 1.0)
					var side: float = r * (2.2 if bare else 1.45) * utility_icon_scale
					_canvas.draw_texture_rect(icon,
						Rect2(pos - Vector2(side, side) * 0.5, Vector2(side, side)),
						false, gcol)
			else:
				var glyph: String = String(GLYPHS.get(int(node["type"]), "?"))
				var glyph_type: int = int(node["type"])
				var utility_glyph_scale: float = 1.2 if glyph_type == RunMap.NodeType.EVENT \
					else (1.3 if glyph_type in [RunMap.NodeType.MERCHANT, RunMap.NodeType.CAMP] else 1.0)
				var gsize: int = roundi(UITheme.FONT_HEADER * utility_glyph_scale)
				var gw: float = font.get_string_size(glyph, HORIZONTAL_ALIGNMENT_LEFT,
					-1, gsize).x
				_canvas.draw_string(font, pos + Vector2(-gw * 0.5, gsize * 0.36), glyph,
					HORIZONTAL_ALIGNMENT_LEFT, -1, gsize, gcol)

			# Intensity as PIPS under a fight node: one/two/three marks. Kept off
			# the colour channel, which already carries grade.
			if RunMap.is_battle_node(node):
				var pips: int = int(node["difficulty"]) + 1
				for i in range(pips):
					var px: float = pos.x - float(pips - 1) * 5.0 + float(i) * 10.0
					_canvas.draw_circle(Vector2(px, pos.y + r + 9.0), 2.6,
						gcol if is_next or is_here else Color(0.5, 0.5, 0.55, visibility))
				# WHAT IT PAYS, on the node itself. The grade ring says how rich;
				# this says what KIND — gold, gear, or a stat. Without it the
				# player had to hover every node in a row to tell them apart,
				# which is not a choice, it's an inspection round.
				var rtex: Texture2D = _reward_icon(node.get("reward", {}))
				var k: float = REWARD_BADGE_SCALE * pop_scale * _node_scale
				var badge_r: float = 10.0 * k
				# Pinned to the rim, measured from the badge's OWN size: its
				# centre sits REWARD_BADGE_OUTSET of its radius outside this
				# node's edge. The old fixed offset (0.72r, -0.82r) put the
				# centre ON the rim whatever the badge's size, so growing it
				# grew it inward over the creature; tied to badge_r, a bigger
				# badge moves out instead. Uses this node's own r, so elite and
				# boss discs keep theirs attached too.
				var badge: Vector2 = pos + REWARD_BADGE_DIR * (r + badge_r * REWARD_BADGE_OUTSET)
				if rtex:
					# Grade-coloured disc behind it, so the badge reads against a
					# dark node AND repeats the ring's grade colour. Every size
					# here is a multiple of REWARD_BADGE_SCALE, so the rim, the
					# disc and the icon grow together and it stays one knob.
					_canvas.draw_circle(badge, badge_r, Color(0, 0, 0, 0.9 * visibility))
					var badge_col: Color = grade_col.darkened(0.45 if (is_next or is_here) else 0.7)
					badge_col.a *= visibility
					_canvas.draw_circle(badge, 8.5 * k, badge_col)
					var half: float = 7.0 * k
					_canvas.draw_texture_rect(rtex,
						Rect2(badge - Vector2(half, half), Vector2(half, half) * 2.0), false,
						Color(1, 1, 1, visibility) if (is_next or is_here)
						else Color(0.7, 0.7, 0.75, visibility))

# How far along the path the traveller is, eased in and out so it sets off and
# arrives rather than sliding at one speed.
func _travel_progress() -> float:
	var t: float = clampf(float(_travel.get("t", 0.0)), 0.0, 1.0)
	return t * t * (3.0 - 2.0 * t)


func _on_node_pressed(node: Dictionary) -> void:
	if not _travel.is_empty():
		return                          # already walking; the choice is made
	var id: String = String(node["id"])
	var enterable: bool = _map != null and _map.can_enter(id)
	# Second click on the node whose card is already open is the commit. The
	# first click can never start a fight, which is the whole point of moving
	# the preview off hover.
	if enterable and _selected_id == id and _tip.visible:
		_enter_node(node)
		return
	open_dossier(node)

# Open a node's dossier WITHOUT the second-click commit. Harnesses drive this:
# calling the press handler twice on the same node would enter the fight, which
# is correct for a player and wrong for a capture that just wants the card up.
func open_dossier(node: Dictionary, pinned: bool = true) -> void:
	_selected_id = String(node["id"])
	_dossier_pinned = pinned
	_dwell = 0.0
	_show_dossier(node, _map != null and _map.can_enter(_selected_id))

# Commit to a node. If there is a path to walk — from the node you stand on to
# this one — the marker walks it first (TRAVEL_SECONDS) and the fight opens when
# it arrives; the biome's opening relic has no path into it and opens at once.
func _enter_node(node: Dictionary) -> void:
	if not _travel.is_empty():
		return                          # a second commit can't stack a second walk
	_clear_selection()
	var from_id: String = _map.current_id if _map != null else ""
	var to_id: String = String(node["id"])
	var walkable: bool = from_id != "" and TRAVEL_SECONDS > 0.0 \
		and to_id in _map.node_by_id(from_id).get("children", [])
	if not walkable:
		_finish_enter(node)
		return
	# The cone would otherwise keep describing whatever the cursor last touched
	# while the road grows toward the node actually chosen.
	_hover_id = ""
	_travel = {"from": from_id, "to": to_id, "node": node, "t": 0.0}
	_canvas.queue_redraw()

func _finish_enter(node: Dictionary) -> void:
	visible = false
	node_chosen.emit(node)

func _clear_selection() -> void:
	_selected_id = ""
	_dossier_pinned = false
	_dwell = 0.0
	if _tip:
		_tip.visible = false

# The information rule lives here: `full` is true only for nodes you can step
# onto right now.
# The enemy half of the board, drawn small. Cells are grid positions; colour is
# role (red melee / blue ranged / green support) and a large body draws double
# size, because a 2x2 is the single biggest placement problem a wave can pose.
func _draw_mini_board() -> void:
	if _tip_formation.is_empty():
		return
	var cell: float = minf(_tip_board.size.x / float(maxi(1, _tip_grid_w)),
		_tip_board.size.y / float(BOARD_ROWS))
	var origin := Vector2((_tip_board.size.x - cell * _tip_grid_w) * 0.5, 2.0)
	var board := Rect2(origin, Vector2(cell * _tip_grid_w, cell * BOARD_ROWS))

	# The decade's real ground tile, repeated — the same texture the arena draws
	# under the fight. Falls back to a flat field colour if that decade's art
	# isn't in yet.
	var ground: Texture2D = _tex(_tip_ground)
	if ground:
		_tip_board.draw_texture_rect(ground, board, true)
	else:
		_tip_board.draw_rect(board, Color(0.22, 0.30, 0.18), true)

	# Cell lines, faint: enough to read position, not enough to fight the art.
	for gx in range(1, _tip_grid_w):
		_tip_board.draw_line(origin + Vector2(gx * cell, 0.0),
			origin + Vector2(gx * cell, board.size.y), Color(0, 0, 0, 0.18), 1.0)
	for gy in range(1, BOARD_ROWS):
		_tip_board.draw_line(origin + Vector2(0.0, gy * cell),
			origin + Vector2(board.size.x, gy * cell), Color(0, 0, 0, 0.18), 1.0)
	_tip_board.draw_rect(board, Color(0, 0, 0, 0.85), false, 2.0)

	# The units themselves, drawn at their cells. No health bars and no ENEMY
	# ZONE label: this is a preview of the fight, not a copy of the HUD.
	for e in _tip_formation:
		var tex: Texture2D = _tex(String(e.get("sprite", "")))
		var sprite_rect: Rect2 = _mini_unit_rect(e, cell, origin)
		if tex == null:
			_tip_board.draw_circle(sprite_rect.get_center(), sprite_rect.size.x * 0.5,
				Color(0.72, 0.70, 0.66))
			continue
		# Sized by HEIGHT ONLY, exactly the way the real board does it
		# (visual_unit._setup_plain_sprite: scale = render_h / texture_height).
		#
		# Constraining by WIDTH as well looked tidier and was wrong: it shrinks
		# wide sprites in proportion to how wide they are. The rat's art is
		# 1406x766, so a width cap of 0.9 cells drew it at 0.49 cells tall
		# against the goblin's 0.87 — 57% the height, for no reason except its
		# aspect ratio. In the actual fight they stand the same height. A preview
		# that disagrees with the board about how big things are is worse than no
		# preview, so wide bodies are allowed to overlap their neighbours here
		# exactly as they do in play; the cap below only stops something absurd.
		_tip_board.draw_texture_rect(tex, sprite_rect, false)

func _mini_unit_rect(e: Dictionary, cell: float, origin: Vector2) -> Rect2:
	var span: float = 2.0 if bool(e.get("large", false)) else 1.0
	var gy: int = clampi(int(e["y"]), 0, BOARD_ROWS - int(span))
	var foot := origin + Vector2((float(e["x"]) + span * 0.5) * cell,
		(float(gy) + span) * cell)
	var tex: Texture2D = _tex(String(e.get("sprite", "")))
	if tex == null:
		var radius: float = cell * 0.26 * span
		var fallback_center: Vector2 = foot - Vector2(0, cell * 0.3)
		return Rect2(fallback_center - Vector2.ONE * radius, Vector2.ONE * radius * 2.0)
	var aspect: float = tex.get_width() / maxf(1.0, float(tex.get_height()))
	var height: float = cell * span * 0.94
	var width: float = minf(height * aspect, cell * span * 2.2)
	return Rect2(foot - Vector2(width * 0.5, height), Vector2(width, height))

func _on_mini_board_gui_input(event: InputEvent) -> void:
	if not (event is InputEventMouseMotion):
		return
	var motion := event as InputEventMouseMotion
	var cell: float = minf(_tip_board.size.x / float(maxi(1, _tip_grid_w)),
		_tip_board.size.y / float(BOARD_ROWS))
	var origin := Vector2((_tip_board.size.x - cell * _tip_grid_w) * 0.5, 2.0)
	for i in range(_tip_formation.size() - 1, -1, -1):
		var formation: Dictionary = _tip_formation[i]
		if _mini_unit_rect(formation, cell, origin).has_point(motion.position):
			_tip_unit_name_label.text = String(formation.get("name", "Enemy"))
			_tip_unit_name.reset_size()
			_tip_unit_name.size = _tip_unit_name.get_combined_minimum_size()
			var tip_pos: Vector2 = motion.position + Vector2(10, -_tip_unit_name.size.y - 8)
			tip_pos.x = clampf(tip_pos.x, 0.0, maxf(0.0, _tip_board.size.x - _tip_unit_name.size.x))
			tip_pos.y = clampf(tip_pos.y, 0.0, maxf(0.0, _tip_board.size.y - _tip_unit_name.size.y))
			_tip_unit_name.position = tip_pos
			_tip_unit_name.visible = true
			return
	_clear_mini_board_hover()

func _clear_mini_board_hover() -> void:
	if _tip_unit_name:
		_tip_unit_name.visible = false

# `full` is kept in the signature for call sites but no longer gates anything:
# EVERY node shows its whole card, from anywhere on the map (owner call).
#
# The earlier adjacent-only rule was my idea, not a requirement — the stated
# intent was always "hover a wave and see what you'll fight", and route planning
# is the reason the map exists. Being told "step closer to see what it holds"
# about a fight three rows up is precisely the information you need to decide
# whether to head that way at all.
# Make the dossier's PASSIVE parts transparent to the mouse, every descendant
# of it except the card itself and its BEGIN button.
#
# THE BUG THIS FIXED: the card is centred and big, so it lay under the cursor
# while you hovered a node beneath it. `_tip` was IGNORE, but Godot's containers
# default to STOP — so the fact boxes and rows caught the pointer, the node
# under them fired mouse_exited, the card hid, the node immediately fired
# mouse_entered again, and the card flickered on every pixel of movement.
# Setting the ROOT alone was not enough; it had to be the subtree.
#
# That loop still cannot close — the card no longer hides on mouse_exited — but
# the pass is doing MORE work now, not less: a dwell card opens under the very
# cursor that summoned it, so a STOP row anywhere in it would swallow the single
# click meant for the node underneath, which is the whole point of the dwell.
func _make_tip_click_through(n: Node) -> void:
	if n == _tip_action or n == _tip_board:
		return                      # action button and mini-board hover MUST take input
	if n is Control:
		(n as Control).mouse_filter = Control.MOUSE_FILTER_IGNORE
	for child in n.get_children():
		_make_tip_click_through(child)

# Hover LOOKS. It lights the cone (see _refresh_cone) and nothing else — no
# card, so the paths it just lit stay visible.
func _on_node_hover(node: Dictionary) -> void:
	if not _hover_armed or not _travel.is_empty():
		return
	var id: String = String(node["id"])
	if id == _hover_id:
		return
	_hover_id = id
	_dwell = 0.0
	# Arriving at a DIFFERENT node puts away a card that opened by itself. One
	# you clicked open stays put: every route across the map to its BEGIN button
	# passes over other nodes, and closing on arrival would make that button
	# impossible to reach.
	if not _dossier_pinned and _selected_id != "" and _selected_id != id:
		_clear_selection()

# Click ASKS. Opens the dossier for any node and pins the cone to it; `can_enter`
# decides whether BEGIN is offered.
func _show_dossier(node: Dictionary, can_enter: bool) -> void:
	_tip_title.text = _node_headline(node).to_upper()
	_tip_title.add_theme_color_override("font_color", Color(1.0, 0.92, 0.84))

	var is_fight: bool = RunMap.is_battle_node(node)
	var badge_col: Color
	if RunMap.is_battle_node(node):
		badge_col = TIER_COLORS[clampi(int(node.get("difficulty", 0)), 0, 2)]
	else:
		badge_col = {
			RunMap.NodeType.EVENT: Color(0.62, 0.35, 0.84),
			RunMap.NodeType.MERCHANT: Color(0.30, 0.70, 0.42),
			RunMap.NodeType.CAMP: Color(0.32, 0.58, 0.82),
		}.get(int(node["type"]), TIP_GOLD)
	var badge := StyleBoxFlat.new()
	badge.bg_color = badge_col.darkened(0.55)
	badge.border_color = badge_col
	badge.set_border_width_all(1)
	badge.set_corner_radius_all(3)
	badge.content_margin_left = 12
	badge.content_margin_right = 12
	badge.content_margin_top = 4
	badge.content_margin_bottom = 4
	_tip_difficulty_badge.add_theme_stylebox_override("panel", badge)
	_tip_facts.visible = is_fight
	_tip_reward.visible = is_fight
	(_tip_reward.get_parent() as Control).visible = is_fight
	_tip_kicker.visible = is_fight
	_tip_wave.visible = is_fight
	_tip_body.visible = not is_fight
	if is_fight:
		var pv: Dictionary = _node_preview(node)
		_tip_kicker.visible = false
		_tip_wave.visible = false
		_tip_power.text = "%d" % int(round(float(pv.get("power", 0.0))))
		var profile: Dictionary = pv.get("profile", {})
		var ranks: Array[String] = []
		var melee_count: int = int(profile.get("melee", 0))
		var ranged_count: int = int(profile.get("ranged", 0)) + int(profile.get("support", 0))
		if melee_count > 0:
			ranks.append("%d Melee" % melee_count)
		if ranged_count > 0:
			ranks.append("%d Ranged" % ranged_count)
		_tip_formation_text.text = "  •  ".join(ranks) if not ranks.is_empty() else "Unknown"
		var reward: Dictionary = node.get("reward", {})
		_tip_reward_icon.texture = _reward_icon(reward)
		_tip_reward_icon.visible = _tip_reward_icon.texture != null
		_tip_reward_name.text = RoundReward.describe(reward)
		_tip_body.text = ""
	else:
		_tip_kicker.text = ""
		_tip_wave.text = ""
		_tip_body.text = _node_detail(node)
	# The formation, for any fight anywhere on the map — scouting the route is
	# the point.
	_tip_formation = []
	if RunMap.is_battle_node(node):
		var pv: Dictionary = _node_preview(node)
		_tip_formation = pv.get("formation", [])
		_tip_grid_w = int(pv.get("grid_w", 9))
		_tip_ground = String(pv.get("ground", ""))
	_tip_board.visible = not _tip_formation.is_empty()
	_tip_board.queue_redraw()
	# BEGIN only exists on a node you may actually step onto. On a scouted node
	# further up the map the card is pure information, and offering a button
	# that would be refused is worse than offering none.
	_tip_action.visible = can_enter
	# Re-applied on every show, not just at build: the card's rows are rebuilt as
	# its content changes, and one freshly-created row defaulting to STOP is
	# enough to bring the flicker back.
	_make_tip_click_through(_tip)
	_tip.visible = true
	# Visibility changes which VBox children contribute to minimum size. Reset
	# AFTER showing it; doing this while hidden retained the previous large rect
	# and left a blank block beneath an otherwise complete mini-board.
	_tip.reset_size()
	_settle_tip_size()

func _settle_tip_size() -> void:
	# Visibility changes are queued through Godot's container sort. Let that
	# settle before measuring or the first dossier inherits the all-rows-visible
	# construction height; subsequent dossiers happen to look correct only
	# because the first pass has already completed.
	await get_tree().process_frame
	await get_tree().process_frame
	if not _tip or not _tip.visible:
		return
	# Containers happily expand their children into an old rect, but reset_size
	# alone does not always reclaim that expansion on the first-ever show. Force
	# the content back to its measured minimum, then fit the frame around it.
	if _tip_box:
		_tip_box.size = _tip_box.get_combined_minimum_size()
	_tip.size = _tip.get_combined_minimum_size()

# ── Texture loaders (cached; _draw runs every frame for the pulse) ───────────
var _tex_cache: Dictionary = {}

func _tex(path: String) -> Texture2D:
	if path == "":
		return null
	if _tex_cache.has(path):
		return _tex_cache[path]
	var tex: Texture2D = null
	if ResourceLoader.exists(path):
		tex = load(path) as Texture2D
	_tex_cache[path] = tex
	return tex

# The biome art behind the start node.
#
# NOT the painted backdrop, which was the first attempt: those are tall
# atmospheric side-strips whose interesting half is sky, and cropping a 60px
# disc out of one gave a near-black hole on the Fire biome (and mud elsewhere).
# The decade's GROUND TILE is the better source — flat, bright, high-contrast,
# designed to read at small size, and instantly identifiable as *that place*
# (grass, lava rock, sand). It is the same texture the fight preview stands its
# enemies on, so the start node and the preview agree about where you are.
#
# A bespoke start plate, if one is ever drawn, overrides both.
func _start_backplate() -> Texture2D:
	if _map == null:
		return null
	var slug: String = BACKDROP_ORDER[maxi(0, _map.biome) % BACKDROP_ORDER.size()]
	var bespoke: Texture2D = _tex("%sstart_bg_%s.png" % [ICON_DIR, slug])
	if bespoke:
		return bespoke
	var lo: int = maxi(0, _map.biome) * RunMap.WAVES_PER_BIOME + 1
	var ground: Texture2D = _tex("res://assets/UI/arena/%d-%d/ready/tile.png"
		% [lo, lo + RunMap.WAVES_PER_BIOME - 1])
	return ground if ground else _tex("%s%s_backdrop.png" % [BACKDROP_DIR, slug])

# How much to brighten a backing plate so every biome's start node reads about
# equally. Samples the texture once (an 8x8 grid is plenty for an average) and
# solves for the multiplier that lands its mean luminance on TARGET, clamped so
# a bright biome is never dimmed and a black one never blows out to white.
const START_PLATE_TARGET := 0.62
var _boost_cache: Dictionary = {}

func _plate_boost(tex: Texture2D) -> float:
	var key: String = tex.resource_path
	if _boost_cache.has(key):
		return _boost_cache[key]
	var boost := 1.0
	var img: Image = tex.get_image()
	if img:
		var total := 0.0
		var n := 0
		for gy in range(8):
			for gx in range(8):
				var c: Color = img.get_pixel(
					int(img.get_width() * (gx + 0.5) / 8.0),
					int(img.get_height() * (gy + 0.5) / 8.0))
				total += c.get_luminance()
				n += 1
		var mean: float = total / maxf(1.0, float(n))
		boost = clampf(START_PLATE_TARGET / maxf(0.02, mean), 1.0, 4.0)
	_boost_cache[key] = boost
	return boost

# Fill a circle with a texture. draw_circle can't take one and _draw has no
# clipping, so the disc is a polygon with UVs — which also lets us pick WHICH
# part of a tall backdrop shows (the middle band, where the art actually is,
# rather than the sky).
func _draw_disc_texture(centre: Vector2, radius: float, tex: Texture2D,
		tint: Color) -> void:
	var pts := PackedVector2Array()
	var uvs := PackedVector2Array()
	var ts: Vector2 = tex.get_size()
	# Square source window from the centre, as wide as the source is narrow so
	# the art is never stretched. Ground tiles are uniform, so which part shows
	# doesn't matter — what matters is that it isn't stretched.
	var side: float = minf(ts.x, ts.y)
	var src := Rect2(Vector2((ts.x - side) * 0.5, (ts.y - side) * 0.5),
		Vector2(side, side))
	for i in range(24):
		var a: float = TAU * float(i) / 24.0
		var dir := Vector2(cos(a), sin(a))
		pts.append(centre + dir * radius)
		uvs.append((src.position + (dir * 0.5 + Vector2(0.5, 0.5)) * src.size) / ts)
	_canvas.draw_colored_polygon(pts, tint, uvs, tex)

func _node_icon(node: Dictionary) -> Texture2D:
	# A hand-drawn icon wins if one has been dropped in; otherwise a fight node
	# falls back to the silhouette of the creature it actually is.
	var slug: String = String(ICON_SLUGS.get(int(node["type"]), ""))
	# ── THE START NODE MAY BE PER-BIOME (owner call, 2026-09-22) ─────────────
	# It is already the one node that changes with the decade — its backplate is
	# that biome's own ground (see _start_backplate) — so the emblem standing on
	# it gets the same treatment: node_start_<slug>.png wins if it exists, and
	# the generic node_start.png is the fallback for every biome that hasn't had
	# one drawn yet. Same "drop the art in and it lights up" contract the rest of
	# this set uses, so the six can land one at a time.
	if slug == "node_start" and _map != null:
		var biome_slug: String = BACKDROP_ORDER[maxi(0, _map.biome) % BACKDROP_ORDER.size()]
		var bespoke: Texture2D = _tex("%s%s_%s.png" % [ICON_DIR, slug, biome_slug])
		if bespoke:
			return bespoke
	var drawn: Texture2D = _tex("%s%s.png" % [ICON_DIR, slug]) if slug != "" else null
	if drawn:
		return drawn
	return _creature_silhouette(node)

# ── WHAT A MAP NODE IS A PICTURE OF ───────────────────────────────────────────
# The sprite a node wears, for nodes that stand for one specific creature. The
# map draws it as a black silhouette, so every decade's elite and boss node shows
# the actual thing you'll fight there rather than a generic emblem — and it costs
# no art at all, because that art already shipped.
#
# STATIC, and living here rather than in main_game, so the capture harness can
# call it too. It used to be a private method on main_game; the standalone
# harness therefore couldn't reach it, quietly fell through to the ⚔ glyph, and
# produced screenshots that looked like the game and weren't.
#
# chosen_element is the Hydra's player-picked element, the one thing here that
# depends on live run state; -1 (the default) means "not chosen yet", which is
# what a harness or a pre-Hydra run wants anyway.
static func sprite_path_for(round_no: int, node_type: int,
		chosen_element: int = -1, battle_code: String = "") -> String:
	if round_no <= 0:
		return ""
	var code: String = ""
	match node_type:
		RunMap.NodeType.ELITE:
			code = WaveScaler.elite_code_for(round_no)
		RunMap.NodeType.BOSS:
			code = WaveScaler.boss_code_for(round_no, chosen_element)
		RunMap.NodeType.BATTLE:
			# The caller resolves this, because answering it means generating and
			# PRICING the node's real wave — WaveDirector's job, not a UI static's
			# (see WaveDirector.lead_code). An empty string means the caller had no
			# director to ask, and the node falls back to its emblem rather than
			# drawing a body that might not be in the fight.
			code = battle_code
		_:
			return ""
	return sprite_for_type(String(EnemyFactory.CODE_TO_TYPE.get(code, "")))

# A unit type's sprite, with the MULTI-PHASE FALLBACK.
#
# Multi-phase bosses are keyed per PHASE, not by their base type: Khagan is
# "khagan_phase1"/"khagan_phase2" and there is no plain "khagan" entry, so a
# straight MONSTER_SPRITE_PATHS lookup returns "". Take the first phase — it's
# the form you actually meet.
#
# EXTRACTED 2026-09-19 because the fallback existed here but NOT in
# main_game._preview_formation, so the node silhouette drew Khagan correctly
# while the hover card's mini-board drew him as a blank grey disc — the boss was
# missing from the preview of his own boss fight. Anything resolving a unit
# sprite by type name goes through this, so there is one place to fix next time.
static func sprite_for_type(type_name: String) -> String:
	if type_name == "":
		return ""
	var path: String = String(VisualUnit.MONSTER_SPRITE_PATHS.get(type_name, ""))
	if path != "":
		return path
	for key in VisualUnit.MONSTER_SPRITE_PATHS:
		if String(key).begins_with(type_name):
			return String(VisualUnit.MONSTER_SPRITE_PATHS[key])
	return ""

# The real sprite behind a fight node.
#
# Cached per (round, type, DIFFICULTY, SEED): the last two are part of the answer
# now, not decoration. A Veteran wave is the Normal one plus whatever the budget
# bought, so its strongest body — the thing the silhouette draws — genuinely
# differs from the Normal node beside it, and the seed decides what that body is.
# Keying on round and type alone made the first node of a row answer for all
# three tiers.
func _creature_silhouette(node: Dictionary) -> Texture2D:
	if not sprite_probe.is_valid() or not RunMap.is_battle_node(node):
		return null
	var key: String = "%d:%d:%d:%d" % [int(node.get("round", 0)), int(node["type"]),
		int(node.get("difficulty", 0)), int(node.get("wave_seed", 0))]
	if _sprite_cache.has(key):
		return _sprite_cache[key]
	var tex: Texture2D = _tex(String(sprite_probe.call(
		int(node.get("round", 0)), int(node["type"]),
		int(node.get("difficulty", 0)), int(node.get("wave_seed", 0)))))
	# A sprite can only BE a silhouette if it's a cut-out. Seven of the eight
	# boss plates are full-bleed paintings with no alpha at all, so drawing one
	# near-black produced a solid dark bar across the node — which is what the
	# Earth, Water, Fire, Lightning and endgame boss nodes had been doing.
	if tex != null and not _is_cutout(tex):
		tex = null
	_sprite_cache[key] = tex
	return tex

# A WHITE stamp of a sprite's shape, so modulate can flood it with a tier
# colour instead of multiplying into the sprite's own paint.
#
# SHRUNK FIRST, and that is the whole reason this is affordable. Every boss
# plate is 1408x768 — a million get_pixel/set_pixel calls in GDScript — to
# produce something that is then drawn at about ninety pixels. Resizing to
# MASK_MAX_PX first costs a native bilinear pass and leaves a few thousand
# pixels for the loop, and the result is still drawn at or above 1:1.
#
# Cached by resource path like the cut-out test beside it, so a biome pays for
# each distinct creature once.
const MASK_MAX_PX := 128

func _silhouette_mask(tex: Texture2D) -> Texture2D:
	var key: String = tex.resource_path
	if key != "" and _mask_cache.has(key):
		return _mask_cache[key]
	var out: Texture2D = null
	var src: Image = tex.get_image()
	if src != null:
		# Never mutate the texture's own image — decompress and resize below
		# would otherwise edit the sprite every other screen is drawing from.
		var img := Image.new()
		img.copy_from(src)
		if not img.is_compressed() or img.decompress() == OK:
			var longest: int = maxi(img.get_width(), img.get_height())
			if longest > MASK_MAX_PX:
				var k: float = float(MASK_MAX_PX) / float(longest)
				img.resize(maxi(1, int(img.get_width() * k)),
					maxi(1, int(img.get_height() * k)), Image.INTERPOLATE_BILINEAR)
			img.convert(Image.FORMAT_RGBA8)
			for y in range(img.get_height()):
				for x in range(img.get_width()):
					img.set_pixel(x, y, Color(1, 1, 1, img.get_pixel(x, y).a))
			out = ImageTexture.create_from_image(img)
	if key != "":
		_mask_cache[key] = out
	return out

# Is this texture a cut-out creature, or a full-bleed painted plate?
#
# Tested rather than listed, so the answer stays true on its own: the moment a
# boss gets a cut-out version dropped in, its node starts wearing it with no code
# change — the same "drop the art in and it lights up" contract the event panel
# and the node icons already use. A hand-maintained denylist would have gone
# stale the first time someone re-exported a plate.
#
# The test is the FOUR CORNERS. Every cut-out in the project reads alpha 0 at all
# four (goblin, khagan, the elites); a full-bleed plate is opaque everywhere. A
# creature would have to reach into all four corners at once to fool it, which
# no sprite drawn on a transparent canvas does.
func _is_cutout(tex: Texture2D) -> bool:
	var key: String = tex.resource_path
	if key != "" and _cutout_cache.has(key):
		return bool(_cutout_cache[key])
	var ok: bool = true
	var img: Image = tex.get_image()
	if img == null:
		ok = false
	else:
		# Imported textures usually arrive VRAM-compressed, and get_pixel on a
		# compressed Image is garbage. Decompress a copy or decline to guess.
		if img.is_compressed() and img.decompress() != OK:
			ok = false
		else:
			var w: int = img.get_width()
			var h: int = img.get_height()
			for p: Vector2i in [Vector2i(0, 0), Vector2i(w - 1, 0),
					Vector2i(0, h - 1), Vector2i(w - 1, h - 1)]:
				if img.get_pixelv(p).a > 0.06:
					ok = false
					break
	if key != "":
		_cutout_cache[key] = ok
	return ok

# Is this node drawing a creature sprite rather than an emblem? A silhouette is
# a filled shape, so it's drawn dark on a lit disc rather than tinted like the
# line-art emblems.
func _is_silhouette(node: Dictionary) -> bool:
	var slug2: String = String(ICON_SLUGS.get(int(node["type"]), ""))
	if slug2 != "" and _tex("%s%s.png" % [ICON_DIR, slug2]):
		return false
	return _creature_silhouette(node) != null

# What colour to draw a node's emblem in. Every FIGHT — skirmish, elite, boss —
# is tinted by its tier, so "how hard" reads identically everywhere on the map.
# Everything else stays neutral; its type is carried by the emblem itself.
# ── Motion helpers ────────────────────────────────────────────────────────────
# A point on the curved edge from -> to at parameter t (see MOTION: horizontal
# tangents at both ends, both control points on the vertical halfway between).
static func _edge_at(from: Vector2, to: Vector2, t: float) -> Vector2:
	var mid_x: float = (from.x + to.x) * 0.5
	var u: float = 1.0 - t
	return u * u * u * from \
		+ 3.0 * u * u * t * Vector2(mid_x, from.y) \
		+ 3.0 * u * t * t * Vector2(mid_x, to.y) \
		+ t * t * t * to

# The edge as a polyline, from its start up to parameter `upto` — the whole edge
# by default, part of it while the reveal inks it in or the road grows along it.
static func _edge_points(from: Vector2, to: Vector2, upto: float = 1.0) -> PackedVector2Array:
	var pts := PackedVector2Array()
	var steps: int = maxi(1, int(ceil(PATH_SEGMENTS * clampf(upto, 0.0, 1.0))))
	for i in range(steps + 1):
		pts.append(_edge_at(from, to, upto * float(i) / float(steps)))
	return pts

# Dashes marching along a polyline, measured by ARC LENGTH so their spacing is
# even however the curve bends. `phase` slides the pattern forward from the
# polyline's start toward its end.
func _draw_flow(pts: PackedVector2Array, phase: float, col: Color, width: float) -> void:
	var period: float = FLOW_DASH + FLOW_GAP
	var s: float = 0.0
	for i in range(pts.size() - 1):
		var a: Vector2 = pts[i]
		var b: Vector2 = pts[i + 1]
		var seg: float = a.distance_to(b)
		if seg <= 0.001:
			continue
		var d: float = 0.0
		while d < seg:
			var local: float = fposmod(s + d - phase, period)
			var dashing: bool = local < FLOW_DASH
			var step: float = maxf(0.01, (FLOW_DASH - local) if dashing else (period - local))
			var d2: float = minf(seg, d + step)
			if dashing:
				_canvas.draw_line(a.lerp(b, d / seg), a.lerp(b, d2 / seg), col, width, true)
			d = d2
		s += seg

# Ease every lift toward its goal: up for the node under the cursor and the node
# whose card is open, down for everything else. Exponential, so it is smooth at
# any frame rate and never overshoots.
func _ease_lifts(delta: float) -> void:
	var k: float = 1.0 - exp(-LIFT_EASE * delta)
	var ids: Array = _lift.keys()
	for id in [_hover_id, _selected_id]:
		if id != "" and not ids.has(id):
			ids.append(id)
	for id in ids:
		var goal: float = 1.0 if (id == _hover_id or id == _selected_id) else 0.0
		var v: float = lerpf(float(_lift.get(id, 0.0)), goal, k)
		if goal == 0.0 and v < 0.002:
			_lift.erase(id)
		else:
			_lift[id] = v

func _reveal_duration() -> float:
	var rows: int = _map.rows.size() if _map != null else 0
	return (float(maxi(0, rows - 1)) * REVEAL_ROW_DELAY + REVEAL_NODE_POP
		+ REVEAL_EDGE_DRAW) / REVEAL_RATE

# How far through its entrance row r is: <0 not started, 0..1 popping in, 1 done.
# Returns 1 when no reveal is running, so every caller can multiply by it freely.
func _reveal_row(r: int, lag: float = 0.0, span: float = REVEAL_NODE_POP) -> float:
	if _reveal_start < 0.0:
		return 1.0
	# Reveal-time, not wall time: scaled once here, so every row, pop and edge
	# slows together and the three timings keep meaning what they say.
	var elapsed: float = (_clock - _reveal_start) * REVEAL_RATE
	return clampf((elapsed - float(r) * REVEAL_ROW_DELAY - lag) / span, 0.0, 1.0)

# Ease-out with a small overshoot: a node lands a touch larger than its size and
# settles, which is what makes a pop read as placed rather than faded in.
static func _back_out(t: float) -> float:
	var c1 := 1.70158
	var c3 := c1 + 1.0
	return 1.0 + c3 * pow(t - 1.0, 3.0) + c1 * pow(t - 1.0, 2.0)

# Forward closure from the hovered node, recomputed only when the hover moves.
# Thirty-one nodes at most, but _draw_map runs every frame for the frontier
# pulse, so it is not walked every frame.
func _refresh_cone() -> void:
	var focus: String = _focus_id()
	if _cone_id == focus:
		return
	_cone_id = focus
	_cone.clear()
	if focus == "" or _map == null:
		return
	var frontier: Array = [focus]
	_cone[focus] = true
	while not frontier.is_empty():
		var id: String = String(frontier.pop_back())
		for cid in _map.node_by_id(id).get("children", []):
			if not _cone.has(String(cid)):
				_cone[String(cid)] = true
				frontier.append(String(cid))

func _cone_factor(id: String) -> float:
	if _cone.is_empty():
		return 1.0
	if _cone.has(id):
		return 1.0
	# The road behind you stays lit. It is where you have been, not a claim
	# about where this fork goes, and fading it would make the map look like it
	# had forgotten the run.
	if _map != null and (id == _map.current_id or _map.cleared.has(id)):
		return 1.0
	return CONE_DIM

# How visible a node is: how far ahead it lies, times whether the node under the
# cursor can get there at all.
func _stage_visibility(node: Dictionary, reachable: Dictionary) -> float:
	if _cone.is_empty():
		return _depth_visibility(node, reachable)
	return CONE_LIT if _cone_factor(String(node.get("id", ""))) >= 1.0 else CONE_DIM

func _depth_visibility(node: Dictionary, reachable: Dictionary) -> float:
	var id := String(node.get("id", ""))
	if reachable.has(id) or id == _map.current_id or _map.cleared.has(id):
		return 1.0
	var current_row := -1
	if _map.current_id != "":
		current_row = int(_map.node_by_id(_map.current_id).get("row", -1))
	var distance: int = int(node.get("row", 0)) - current_row
	if distance <= 2:
		return 0.65
	# Landmarks remain identifiable without competing with the live decision.
	if int(node.get("type", -1)) in [RunMap.NodeType.ELITE, RunMap.NodeType.MERCHANT, RunMap.NodeType.BOSS]:
		return 0.52
	return 0.36

func _icon_color(node: Dictionary, lit: bool) -> Color:
	# The start node is the one emblem drawn on BRIGHT ground (its biome-art
	# porthole), so it reads as a dark silhouette — the same way the Slay the
	# Spire start marker sits black on parchment. A pale emblem there washed
	# straight out on the grass biome.
	if int(node["type"]) == RunMap.NodeType.RELIC:
		return Color(0.08, 0.07, 0.09) if lit else Color(0.20, 0.19, 0.22)
	var col := Color(1, 1, 1, 1)
	if RunMap.is_battle_node(node):
		col = TIER_COLORS[clampi(int(node["difficulty"]), 0, 2)]
	return col if lit else col.darkened(0.45)

# The reward's OWN icon, from wherever the game already keeps it.
func _reward_icon(reward: Dictionary) -> Texture2D:
	match int(reward.get("type", RoundReward.Type.NOTHING)):
		RoundReward.Type.GOLD:
			return _tex(COIN_ICON)
		RoundReward.Type.ITEM:
			var item: EquipmentItem = reward.get("item")
			if item == null:
				return null
			return _tex(String(EquipmentManager.ITEM_ICONS.get(item.name, "")))
		RoundReward.Type.STAT_BONUS:
			var perk: Dictionary = reward.get("perk", {})
			var key: String = String(LevelUpScreen.PERK_ICON_KEY.get(
				String(perk.get("id", "")), ""))
			return _tex(String(UnitFactory.STAT_ICONS.get(key, "")))
	return null

func _node_headline(node: Dictionary) -> String:
	var t: int = int(node["type"])
	if t == RunMap.NodeType.BATTLE:
		return TIER_NAMES[clampi(int(node["difficulty"]), 0, 2)]
	if t == RunMap.NodeType.ELITE or t == RunMap.NodeType.BOSS:
		return "%s — %s" % [RunMap.type_name(t), TIER_NAMES[clampi(int(node["difficulty"]), 0, 2)]]
	return RunMap.type_name(t)

func _node_preview(node: Dictionary) -> Dictionary:
	var id: String = String(node["id"])
	if _preview_cache.has(id):
		return _preview_cache[id]
	if not preview_probe.is_valid():
		return {}
	var data: Dictionary = preview_probe.call(
		int(node.get("round", 0)), int(node.get("difficulty", 0)),
		int(node.get("wave_seed", 0)))
	_preview_cache[id] = data
	return data

func _node_detail(node: Dictionary) -> String:
	var lines: Array[String] = []
	match int(node["type"]):
		RunMap.NodeType.BATTLE, RunMap.NodeType.ELITE, RunMap.NodeType.BOSS:
			var pv: Dictionary = _node_preview(node)
			var wave_name: String = String(pv.get("name", ""))
			lines.append("Wave %d%s" % [int(node["round"]),
				"  ·  %s" % wave_name if wave_name != "" else ""])
			# What you would actually be placing against, and how heavy it is on
			# the same power scale the difficulty panel prints.
			var profile: Dictionary = pv.get("profile", {})
			var parts: Array[String] = []
			for key in ["melee", "ranged", "support", "large"]:
				if int(profile.get(key, 0)) > 0:
					parts.append("%d %s" % [int(profile[key]), key])
			if not parts.is_empty():
				lines.append("Facing: %s" % " · ".join(parts))
			if pv.has("power"):
				lines.append("Power %d" % int(round(float(pv["power"]))))
			lines.append("Reward: %s" % RoundReward.describe(node.get("reward", {})))
		RunMap.NodeType.EVENT:
			lines.append("An encounter on the road. What's inside is worth about a %s."
				% String(node["grade"]))
		RunMap.NodeType.MERCHANT:
			lines.append("The merchant. Spend gold on heroes, items, relics and upgrades.")
		RunMap.NodeType.CAMP:
			lines.append("Make camp: train a hero, work an item, or scout the road ahead.")
		RunMap.NodeType.RELIC:
			lines.append("Choose one relic. It lasts the rest of the run.")
	if int(node.get("slot_wave", 0)) > 0 and not RunMap.is_battle_node(node):
		lines.append("An alternate route for this stage; no battle reward.")
	return "\n".join(lines)

# Hide the map without closing it: the board is the live scene underneath, so
# this is pure visibility. Nothing about the run's state moves.
# True only when the MAP ITSELF is covering the board. VIEW BOARD leaves this
# CanvasLayer visible (it still owns the BACK TO MAP button) while hiding the
# panel, and in that state the board's own hover tooltips must keep working —
# inspecting your formation is the entire point of being there.
func is_covering_board() -> bool:
	return visible and _panel != null and _panel.visible

func _on_view_board() -> void:
	_tip.visible = false
	_panel.visible = false
	_overlay.visible = false
	_return_btn.visible = true
	var vp: Vector2 = get_viewport().get_visible_rect().size if get_viewport() 		else Vector2(1920, 1080)
	_return_btn.position = Vector2(vp.x * 0.5 - _return_btn.size.x * 0.5, 16)

func _on_return_to_map() -> void:
	_return_btn.visible = false
	_panel.visible = true
	_overlay.visible = true

func _center_panel() -> void:
	var vp: Vector2 = get_viewport().get_visible_rect().size if get_viewport() \
		else Vector2(1920, 1080)
	_panel.position = ((vp - _panel_size) / 2.0).floor()

func _lbl(parent: Node, text: String, sz: int, col: Color, pos: Vector2, size: Vector2) -> Label:
	var l := Label.new()
	l.text = text
	l.position = pos
	l.size = size
	UITheme.apply_font(l, sz)
	l.add_theme_color_override("font_color", col)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	parent.add_child(l)
	return l
