extends CanvasLayer
class_name RunMapScreen
# ══════════════════════════════════════════════════════════════════════════════
# RUN MAP SCREEN (2026-09-19) — the biome's branching path, and the one place
# the player chooses where to go next. Design: RUN_MAP_PLAN.md §3.
#
# Modal, in the relic_screen / shop_screen family (CanvasLayer + present() + a
# chosen signal), rather than drawn into the side rail: the rail strip is
# ~180px wide and three columns of hoverable node cards don't fit there without
# eating the board. The rail keeps showing WHERE YOU ARE; this screen is where
# you decide where you're going.
#
# ── EVERY NODE SHOWS EVERYTHING ───────────────────────────────────────────────
# Hover any node, anywhere on the map, and you get its whole card: the wave, its
# power, what it fields and what it pays. An earlier version showed full detail
# only for nodes you could step onto and a "step closer to see what it holds"
# teaser beyond that — my invention, and backwards. Planning a ROUTE is what the
# map is for, and you cannot plan toward a Brutal wave 8 you are not allowed to
# look at.
#
# ── WHICH WAY IS FORWARD, AND WHY IT DISAGREES WITH THE RAILS ─────────────────
# Stages read LEFT TO RIGHT here; lanes run top (easy) to bottom (brutal).
# progression_rails reads bottom to top and will keep doing so — it lives in the
# arena's 285px side strips, where a horizontal trail cannot fit at all.
#
# That looks like an inconsistency and isn't, because the two views answer
# different questions. The rails are an ALTIMETER: one axis, no choices, how far
# up the hundred rounds you have climbed. This screen is a ROUTE: it has to show
# eleven stages AND up to four parallel lanes at once, and that graph only fits a
# 16:9 frame lying down (see _layout for the measurements). Forcing them to share
# an axis costs the map its legibility to buy a consistency the player never
# looks at both halves of simultaneously.
# ══════════════════════════════════════════════════════════════════════════════

signal node_chosen(node: Dictionary)

# The map fills the screen (owner call, 2026-09-19): it is the run's planning
# view, not a dialog, and at 880px it read as a small box floating on the board.
# Sizes are computed per present() from the viewport — PANEL_* are only the
# fallbacks for a headless/zero-size viewport.
const SCREEN_FILL := 1.0        # the map IS the screen — no framing border
const PANEL_W := 880.0
const PANEL_H := 940.0
const NODE_R  := 26.0           # node radius
# STAGE = along the direction of travel (X, left to right).
# LANE  = across it (Y, easy lane on top). Both are recomputed per present().
const STAGE_GAP := 170.0
const LANE_GAP  := 232.0
# Gutter reserved at the left and right ends of the trail, so the start disc and
# the boss disc don't graze the panel edge.
const STAGE_MARGIN := 110.0

# ── Biome backdrop ────────────────────────────────────────────────────────────
# Each decade already has a painted plate (the one the arena's side strips use).
# Reusing it here means the map LOOKS like the place you're walking through, and
# it changes as the run moves biome — for free, with art that already exists.
# Dimmed hard behind the nodes: the plates are deliberately rich (see the biome
# backdrop work), and an undimmed one would swallow a thin white trail.
const BACKDROP_DIR := "res://assets/terrain/biomes/"
const BACKDROP_ORDER := ["normal", "air", "water", "earth", "fire", "lightning"]
const BACKDROP_DIM := Color(0.34, 0.34, 0.40)

# ── Node art ──────────────────────────────────────────────────────────────────
# Each node type looks for its icon at assets/icons/map_nodes/<slug>.png and
# falls back to the letterform glyph below when the file isn't there — the same
# "drop the art in and it lights up, no code change" contract the event panel
# uses for its scenes. Prompts for the set live in
# tools/sprite_pipeline/gemini_prompts/GEMINI_MAP_NODE_PROMPTS.md.
const ICON_DIR := "res://assets/icons/map_nodes/"
# ── FIGHT NODES HAVE NO ICON SLOT, ON PURPOSE (owner call, 2026-09-20) ────────
# BATTLE, ELITE and BOSS are deliberately absent. A drawn icon WINS over the
# creature silhouette in _node_icon, so a node_battle.png dropped into ICON_DIR
# would silently mask every fight node's real creature — the thing those nodes
# now exist to show. Two generations of a drawn "enemy line" (one emblem at three
# stages of menace) were tried and dropped in favour of the actual monster, so
# the slot is closed rather than left open for a file to fall into.
const ICON_SLUGS := {
	RunMap.NodeType.RELIC:    "node_start",
	RunMap.NodeType.EVENT:    "node_event",
	RunMap.NodeType.MERCHANT: "node_merchant",
	RunMap.NodeType.CAMP:     "node_rest",
}
