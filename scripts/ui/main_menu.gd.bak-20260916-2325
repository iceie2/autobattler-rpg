extends Node2D
class_name MainMenu

const GAME_SCENE := "res://scenes/main_game.tscn"

# ── Menu art (drop real PNGs here; each falls back to procedural if missing) ──
# NOTE: exact case ("UI") — the exported .pck filesystem is case-sensitive, so a
# lowercase "ui" here loads fine from source on Windows but drops the art in a build.
const BG_PATH     := "res://assets/UI/menu/background.png"
const CIRCLE_PATH := "res://assets/UI/menu/summon_circle.png"
const LOGO_PATH   := "res://assets/UI/menu/logo.png"
const HERO_DIR    := "res://assets/UI/menu/heroes"   # curated menu-pose cutouts

const CENTER := Vector2(960, 540)          # design-space center (1920×1080)
const CIRCLE_CENTER := Vector2(960, 250)   # biased up so its bright core backs the logo
const PARALLAX_BG := 14.0                   # px the bg drifts with the cursor
const PARALLAX_CIRCLE := 7.0

enum WinMode { WINDOWED, BORDERLESS, FULLSCREEN }
var _win_mode := WinMode.WINDOWED

var _options_panel: Control
var _class_browser: ClassBrowser
var _crystal_shop: CrystalShop
var _run_history: RunHistoryScreen

# 3-click "are you sure" for wiping save data — one click too many to trigger
# by accident, since there's no undo (2026-08-05 user request, after a manual
# +100k crystal test grant needed removing).
var _wipe_btn: Button
var _wipe_stage := 0

# animated layers
var _bg_layer: Node2D
var _bg_sprite: Sprite2D
var _circle: Sprite2D
var _has_bg_tex := false
var _has_circle_tex := false
var _menu_buttons: Array = []
var _anim_t := 0.0
var _parallax := Vector2.ZERO

# featured hero showcase (activates only if HERO_DIR has textures)
var _hero_sprite: Sprite2D
var _hero_glow: Sprite2D
var _hero_name_lbl: Label
var _hero_el_lbl: Label
var _hero_files: Array = []
var _hero_index := 0
var _hero_timer := 0.0
const HERO_CYCLE := 15.0

func _ready() -> void:
	_apply_window_mode(WinMode.WINDOWED)
	_load_settings()   # overrides with the saved window mode, if any

	_build_background()
	_build_circle()
	_build_particles()
	_build_hero_showcase()

	var canvas := CanvasLayer.new()
	add_child(canvas)
	_build_main(canvas)
	_build_options(canvas)
	if _hero_name_lbl:
		canvas.add_child(_hero_name_lbl)
		canvas.add_child(_hero_el_lbl)

	var cb_scene := load("res://scenes/class_browser.tscn") as PackedScene
	_class_browser = cb_scene.instantiate() as ClassBrowser
	add_child(_class_browser)

	var cs_scene := load("res://scenes/crystal_shop.tscn") as PackedScene
	_crystal_shop = cs_scene.instantiate() as CrystalShop
	add_child(_crystal_shop)

	_run_history = RunHistoryScreen.new()
	add_child(_run_history)

func _process(delta: float) -> void:
	_anim_t += delta

	# eased parallax toward the cursor's offset from centre
	var mp := get_viewport().get_mouse_position()
	var target := (mp - CENTER) / CENTER
	_parallax = _parallax.lerp(target, clampf(delta * 3.0, 0.0, 1.0))

	if _bg_sprite:
		_bg_sprite.position = CENTER - _parallax * PARALLAX_BG
	if _circle:
		_circle.rotation += delta * 0.12
		_circle.position = CIRCLE_CENTER - _parallax * PARALLAX_CIRCLE
		var p: float = 0.52 + 0.15 * sin(_anim_t * 1.1)   # gentle breathing glow (dim = backdrop)
		_circle.self_modulate.a = p
	elif not _has_circle_tex:
		queue_redraw()   # procedural fallback ring needs repainting

	_animate_hero(delta)

# ── Background ────────────────────────────────────────────────────────────────
func _build_background() -> void:
	_bg_layer = Node2D.new()
	_bg_layer.z_index = -20
	add_child(_bg_layer)

	var tex := _try_load(BG_PATH)
	if tex:
		_has_bg_tex = true
		_bg_sprite = Sprite2D.new()
		_bg_sprite.texture = tex
		_bg_sprite.centered = true
		_bg_sprite.position = CENTER
		# scale to COVER 1920×1080 plus parallax headroom, keep aspect
		var ts := tex.get_size()
		var s: float = max((1920.0 + PARALLAX_BG * 4) / ts.x, (1080.0 + PARALLAX_BG * 4) / ts.y)
		_bg_sprite.scale = Vector2(s, s)
		_bg_layer.add_child(_bg_sprite)

func _build_circle() -> void:
	var tex := _try_load(CIRCLE_PATH)
	if not tex:
		return
	_has_circle_tex = true
	_circle = Sprite2D.new()
	_circle.texture = tex
	_circle.centered = true
	_circle.position = CIRCLE_CENTER
	_circle.z_index = -10
	# additive blend → the pure-black export vanishes for free, glow composites
	var mat := CanvasItemMaterial.new()
	mat.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	_circle.material = mat
	var target_h := 600.0
	var s := target_h / tex.get_size().y
	_circle.scale = Vector2(s, s)
	_circle.modulate = Color(0.75, 0.85, 1.0)   # cool the glow slightly
	add_child(_circle)

func _build_particles() -> void:
	var p := CPUParticles2D.new()
	p.z_index = -5
	p.amount = 60
	p.lifetime = 9.0
	p.preprocess = 6.0
	p.position = Vector2(960, 1120)
	p.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	p.emission_rect_extents = Vector2(1000, 40)
	p.direction = Vector2(0, -1)
	p.spread = 18.0
	p.gravity = Vector2(0, -6)
	p.initial_velocity_min = 10.0
	p.initial_velocity_max = 28.0
	p.scale_amount_min = 1.0
	p.scale_amount_max = 3.0
	p.color = Color(0.63, 0.82, 1.0, 0.5)
	# fade in and out over life
	var grad := Gradient.new()
	grad.set_color(0, Color(0.63, 0.82, 1.0, 0.0))
	grad.set_color(1, Color(0.75, 0.88, 1.0, 0.0))
	grad.add_point(0.5, Color(0.7, 0.85, 1.0, 0.55))
	p.color_ramp = grad
	p.emitting = true
	add_child(p)

# ── Featured hero showcase ────────────────────────────────────────────────────
func _build_hero_showcase() -> void:
	_hero_files = _scan_dir(HERO_DIR, [".png"])
	if _hero_files.is_empty():
		return   # no curated art yet — showcase stays off

	var hero_pos := Vector2(1500, 560)

	_hero_glow = Sprite2D.new()
	_hero_glow.texture = _radial_glow_tex()
	_hero_glow.position = hero_pos
	_hero_glow.scale = Vector2(3.2, 3.2)
	_hero_glow.modulate = Color(0.6, 0.82, 1.0, 0.5)
	_hero_glow.z_index = -6
	var gmat := CanvasItemMaterial.new()
	gmat.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	_hero_glow.material = gmat
	add_child(_hero_glow)

	_hero_sprite = Sprite2D.new()
	_hero_sprite.position = hero_pos
	_hero_sprite.z_index = -4
	add_child(_hero_sprite)

	_hero_name_lbl = Label.new()
	_hero_name_lbl.position = Vector2(1300, 760)
	_hero_name_lbl.size = Vector2(400, 40)
	_hero_name_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	UITheme.apply_font(_hero_name_lbl, UITheme.body_font(26))
	_hero_name_lbl.add_theme_color_override("font_color", Color(0.87, 0.92, 1.0))

	_hero_el_lbl = Label.new()
	_hero_el_lbl.position = Vector2(1300, 800)
	_hero_el_lbl.size = Vector2(400, 28)
	_hero_el_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	UITheme.apply_font(_hero_el_lbl, UITheme.body_font(16))
	_hero_el_lbl.add_theme_color_override("font_color", Color(0.62, 0.78, 1.0))

	_hero_index = 0
	_show_hero(_hero_files[0])

func _show_hero(path: String) -> void:
	var tex := _try_load(path)
	if not tex:
		return
	_hero_sprite.texture = tex
	var target_h := 460.0
	var s: float = target_h / tex.get_size().y
	_hero_sprite.scale = Vector2(s, s)
	var nm := path.get_file().get_basename().capitalize()
	if _hero_name_lbl:
		_hero_name_lbl.text = nm

func _animate_hero(delta: float) -> void:
	if not _hero_sprite:
		return
	var bob := sin(_anim_t * 1.35) * 12.0
	_hero_sprite.position.y = 560 + bob
	if _hero_glow:
		var b: float = 0.85 + 0.15 * sin(_anim_t * 1.35)
		_hero_glow.scale = Vector2(3.2 * b, 3.2 * b)
		_hero_glow.position.y = 560 + bob * 0.5

	_hero_timer += delta
	if _hero_timer >= HERO_CYCLE and _hero_files.size() > 1:
		_hero_timer = 0.0
		_hero_index = (_hero_index + 1) % _hero_files.size()
		_show_hero(_hero_files[_hero_index])

# ── Fallback background paint (only used when the real art is absent) ─────────
func _draw() -> void:
	# When the real background sprite is present it sits at z=-20 and covers the
	# screen — painting anything here (at z=0) would draw OVER it, so bail out.
	if _has_bg_tex:
		return
	var sz := get_viewport_rect().size
	draw_rect(Rect2(Vector2.ZERO, sz), Color(0.045, 0.055, 0.10))
	# soft radial darkening toward the edges so it isn't a flat slab
	var layers := 5
	for i in range(layers):
		var t := float(i) / layers
		var r := (1.0 - t) * sz.x * 0.7
		draw_circle(Vector2(sz.x * 0.5, sz.y * 0.35), r,
			Color(0.10, 0.12, 0.22, 0.10))
	if not _has_circle_tex:
		# procedural rune-ring stand-in, rotating via _anim_t
		var c := CIRCLE_CENTER
		for i in range(4):
			draw_arc(c, 70.0 + i * 30, 0, TAU, 48,
				Color(0.4, 0.55, 1.0, 0.10 + 0.02 * sin(_anim_t + i)), 2)

# ── Main panel ────────────────────────────────────────────────────────────────
func _build_main(canvas: CanvasLayer) -> void:
	var root := _panel(canvas, Rect2(0, 0, 0, 0), false)
	root.set_anchors_preset(Control.PRESET_FULL_RECT)

	var cx := 960.0
	# real logo if present, else the styled text title
	var logo := _try_load(LOGO_PATH)
	var subtitle_y := 205.0
	if logo:
		var tr := TextureRect.new()
		tr.texture = logo
		# IGNORE_SIZE = respect the box we set (default KEEP_SIZE draws at native res)
		tr.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		tr.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		tr.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var aspect := float(logo.get_size().x) / float(logo.get_size().y)
		var lh := 230.0
		var lw := lh * aspect
		if lw > 940.0:          # clamp very wide logos to fit the header band
			lw = 940.0
			lh = lw / aspect
		tr.position = Vector2(cx - lw / 2, 46)
		tr.size = Vector2(lw, lh)
		root.add_child(tr)
		# logo.png has an opaque (non-transparent) background fill baked into the
		# art, not a tight alpha crop — a subtitle sitting only 4px below its
		# bottom edge visually smeared into that plate and read as garbled
		# illegible text (2026-09 fix: give it real breathing room instead).
		subtitle_y = 46.0 + lh + 24.0
	else:
		_lbl(root, "AUTO HEROES", 60, Color(0.82, 0.88, 1.0),
			Vector2(cx - 300, 80), Vector2(600, 80), true)
	# Sits over the animated rune circle, which has no clear backdrop of its
	# own — a flat color read as smeared/illegible against the glyph rings
	# (2026-09 fix, part 2: the gap-only fix wasn't enough on its own since the
	# circle spans well past the logo's bottom edge). A dark shadow gives it
	# the contrast the background can't.
	var subtitle := _lbl(root, "an autobattler rpg", 16, Color(0.82, 0.87, 1.0, 0.95),
		Vector2(cx - 200, subtitle_y), Vector2(400, 30), true)
	subtitle.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.05, 0.95))
	subtitle.add_theme_constant_override("shadow_offset_x", 1)
	subtitle.add_theme_constant_override("shadow_offset_y", 1)
	subtitle.add_theme_constant_override("shadow_outline_size", 3)

	# ── Button hierarchy (2026-09 pass, user spec) ────────────────────────────
	# START GAME gets sole top billing; Classes/Crystal Shop/Run History are a
	# real but visibly secondary tier; Options/Quit are plain text links; Arena
	# (a dev/debug sandbox) only appears in a debug build. The whole stack is
	# shifted down and to the left of screen-center so it stops sitting on top
	# of the summoning-circle's bright core (CIRCLE_CENTER = (960, 250)).
	var stack_x := 480.0
	var stack_w := 360.0
	var by := 430.0

	if RunSave.exists():
		# A saved run gets top billing (2026-07-17 mid-run save) — it takes the
		# primary slot, START GAME drops to the secondary tier right under it.
		var cont := _btn_primary("CONTINUE RUN", Vector2(stack_x, by), Vector2(stack_w, 72))
		cont.pressed.connect(_on_continue)
		root.add_child(cont)
		by += 88.0
		var start_sec := _btn_secondary("START GAME (NEW)", Vector2(stack_x + 30, by), Vector2(stack_w - 60, 50))
		start_sec.pressed.connect(_on_start)
		root.add_child(start_sec)
		by += 64.0
	else:
		var start := _btn_primary("START GAME", Vector2(stack_x, by), Vector2(stack_w, 72))
		start.pressed.connect(_on_start)
		root.add_child(start)
		by += 88.0

	by += 12.0
	var secondary := [
		["CLASSES",      _on_classes],
		["CRYSTAL SHOP", _on_crystal_shop],
		["RUN HISTORY",  _on_run_history],
	]
	for e in secondary:
		var b := _btn_secondary(e[0], Vector2(stack_x + 30, by), Vector2(stack_w - 60, 50))
		b.pressed.connect(e[1])
		root.add_child(b)
		by += 60.0

	# Dev/debug-only sandbox — never shown in a real build (no existing debug
	# flag/autoload in the project to reuse, so this is the minimal built-in
	# check: OS.is_debug_build()).
	if OS.is_debug_build():
		var arena := _btn_secondary("ARENA (DEBUG)", Vector2(stack_x + 30, by), Vector2(stack_w - 60, 50))
		arena.pressed.connect(_on_arena)
		root.add_child(arena)
		by += 60.0

	by += 16.0
	var opt := _btn_link("Options", Vector2(stack_x + 60, by), Vector2(120, 30))
	opt.pressed.connect(_on_options)
	root.add_child(opt)
	var quit := _btn_link("Quit", Vector2(stack_x + 200, by), Vector2(120, 30))
	quit.pressed.connect(_on_quit)
	root.add_child(quit)
	by += 40.0

	_lbl(root, "v0.4.1.0 – early development", 12, Color(0.3, 0.3, 0.4),
		Vector2(stack_x + stack_w / 2.0 - 150, by + 14), Vector2(300, 24), true)

# ── Options panel ─────────────────────────────────────────────────────────────
func _build_options(canvas: CanvasLayer) -> void:
	_options_panel = _panel(canvas, Rect2(660, 160, 600, 460))
	_options_panel.visible = false

	_lbl(_options_panel, "OPTIONS", 22, UITheme.TEXT_HEADER,
		Vector2(0, 20), Vector2(600, 40), true)
	var sep := HSeparator.new()
	sep.position = Vector2(0, 68); sep.size = Vector2(600, 4)
	_options_panel.add_child(sep)

	_lbl(_options_panel, "Window Mode", 15, UITheme.TEXT_BODY,
		Vector2(30, 86), Vector2(240, 28))

	var modes := [
		["Windowed",          WinMode.WINDOWED],
		["Borderless Windowed", WinMode.BORDERLESS],
		["Fullscreen",        WinMode.FULLSCREEN],
	]
	var my := 122.0
	for m in modes:
		var b := _btn_secondary(m[0], Vector2(30, my), Vector2(260, 44))
		b.pressed.connect(_on_window_mode.bind(m[1]))
		_options_panel.add_child(b)
		my += 54

	var sep2 := HSeparator.new()
	sep2.position = Vector2(0, my + 6); sep2.size = Vector2(600, 4)
	_options_panel.add_child(sep2)

	_lbl(_options_panel, "Danger Zone", 15, Color(0.62, 0.16, 0.1),
		Vector2(30, my + 22), Vector2(300, 28))

	_wipe_btn = _btn_secondary("Reset Save Data", Vector2(30, my + 56), Vector2(260, 44))
	_wipe_btn.pressed.connect(_on_wipe_pressed)
	_options_panel.add_child(_wipe_btn)

	var close := _btn_link("✕  Close", Vector2(220, my + 122), Vector2(160, 40))
	close.pressed.connect(func(): _options_panel.visible = false)
	_options_panel.add_child(close)

# ── Handlers ──────────────────────────────────────────────────────────────────
func _on_start() -> void:
	RunSave.resume_on_start = false
	get_tree().change_scene_to_file(GAME_SCENE)

func _on_continue() -> void:
	RunSave.resume_on_start = true
	get_tree().change_scene_to_file(GAME_SCENE)

func _on_classes() -> void:
	_options_panel.visible = false
	_class_browser.open(0)

func _on_crystal_shop() -> void:
	_options_panel.visible = false
	_crystal_shop.open()

func _on_arena() -> void:
	# Test sandbox — arena_main.gd defaults to interactive sandbox mode when
	# there's a window (headless CLI runs keep probe as their default).
	get_tree().change_scene_to_file("res://scenes/arena.tscn")

func _on_options() -> void:
	_options_panel.visible = not _options_panel.visible

func _on_run_history() -> void:
	_options_panel.visible = false
	_run_history.open()

func _on_quit() -> void:
	get_tree().quit()

# 3 clicks to actually wipe: two escalating warnings, then the real thing.
# Wipes crystals/upgrades (Progression), the in-progress run checkpoint
# (RunSave), and the run history log (RunHistory) — everything that survives
# between sessions except the window-mode setting. Reloads the menu afterward
# so every panel/button (e.g. CONTINUE RUN's visibility) reflects the wipe
# instead of showing stale cached state.
func _on_wipe_pressed() -> void:
	if _wipe_stage == 0:
		_wipe_stage = 1
		_wipe_btn.text = "Sure? This is permanent"
		get_tree().create_timer(4.0).timeout.connect(_disarm_wipe)
		return
	if _wipe_stage == 1:
		_wipe_stage = 2
		_wipe_btn.text = "Really sure? Click once more"
		get_tree().create_timer(4.0).timeout.connect(_disarm_wipe)
		return
	Progression.wipe_all()
	RunSave.clear()
	RunHistory.clear()
	_wipe_stage = 0
	get_tree().reload_current_scene()

func _disarm_wipe() -> void:
	_wipe_stage = 0
	if is_instance_valid(_wipe_btn):
		_wipe_btn.text = "Reset Save Data"

# ── Settings persistence (2026-07-17): window mode survives restarts ──────────
const SETTINGS_PATH := "user://settings.json"

func _load_settings() -> void:
	if not FileAccess.file_exists(SETTINGS_PATH):
		return
	var f := FileAccess.open(SETTINGS_PATH, FileAccess.READ)
	if not f:
		return
	var parsed = JSON.parse_string(f.get_as_text())
	if parsed is Dictionary and parsed.has("win_mode"):
		_win_mode = clampi(int(parsed["win_mode"]), 0, WinMode.size() - 1)
		_apply_window_mode(_win_mode)

func _save_settings() -> void:
	# Read-modify-write: main_game.gd stores its own keys in this file (e.g.
	# "intent_arrows"), and a blind overwrite here would silently wipe them.
	var d: Dictionary = {}
	if FileAccess.file_exists(SETTINGS_PATH):
		var rf := FileAccess.open(SETTINGS_PATH, FileAccess.READ)
		if rf:
			var parsed = JSON.parse_string(rf.get_as_text())
			if parsed is Dictionary:
				d = parsed
	d["win_mode"] = _win_mode
	var f := FileAccess.open(SETTINGS_PATH, FileAccess.WRITE)
	if f:
		f.store_string(JSON.stringify(d))

func _on_window_mode(mode: WinMode) -> void:
	_win_mode = mode
	_apply_window_mode(mode)
	_save_settings()

func _apply_window_mode(mode: WinMode) -> void:
	match mode:
		WinMode.WINDOWED:
			DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
			DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_BORDERLESS, false)
		WinMode.BORDERLESS:
			DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
			DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_BORDERLESS, true)
		WinMode.FULLSCREEN:
			DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)

# ── UI helpers ────────────────────────────────────────────────────────────────
# themed=false gives a fully transparent full-rect backing (the root layer,
# which just hosts the logo/buttons over the animated background) — every
# real popup panel (Options) goes through UITheme.panel_box() instead of a
# hand-rolled navy StyleBoxFlat (2026-09 UITheme migration pass).
func _panel(parent: Node, rect: Rect2, themed: bool = true) -> Panel:
	var p := Panel.new()
	if rect.size != Vector2.ZERO:
		p.position = rect.position; p.size = rect.size
	if themed:
		p.add_theme_stylebox_override("panel", UITheme.panel_box())
	else:
		p.add_theme_stylebox_override("panel", _flat(Color(0, 0, 0, 0)))
	parent.add_child(p)
	return p

# ── Button hierarchy (2026-09 pass) ────────────────────────────────────────────
# Primary = the one big call-to-action (START GAME / CONTINUE RUN). Secondary =
# real buttons one rung down (Classes/Crystal Shop/Run History/Arena-debug).
# Link = plain text, no plate (Options/Quit). All three route through UITheme
# so this screen stops hand-rolling its own navy button boxes.
func _btn_primary(text: String, pos: Vector2, size: Vector2) -> Button:
	var b := Button.new()
	b.text = text
	b.position = pos
	b.size = size
	UITheme.style_button(b)
	UITheme.apply_font(b, UITheme.header_font(20))
	_wire_hover_scale(b, 1.04)
	return b

func _btn_secondary(text: String, pos: Vector2, size: Vector2) -> Button:
	var b := Button.new()
	b.text = text
	b.position = pos
	b.size = size
	UITheme.style_button_secondary(b)
	UITheme.apply_font(b, UITheme.body_font(16))
	_wire_hover_scale(b, 1.03)
	return b

func _btn_link(text: String, pos: Vector2, size: Vector2) -> Button:
	var b := Button.new()
	b.text = text
	b.position = pos
	b.size = size
	UITheme.style_text_link(b)
	UITheme.apply_font(b, UITheme.body_font(15))
	return b

func _wire_hover_scale(b: Button, hover_scale: float) -> void:
	b.pivot_offset = b.size * 0.5
	var enter := func():
		var t := create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		t.tween_property(b, "scale", Vector2(hover_scale, hover_scale), 0.14)
	var leave := func():
		var t := create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		t.tween_property(b, "scale", Vector2.ONE, 0.14)
	b.mouse_entered.connect(enter)
	b.mouse_exited.connect(leave)
	b.focus_entered.connect(enter)
	b.focus_exited.connect(leave)

func _lbl(parent: Node, text: String, sz: int, col: Color,
		pos: Vector2, size: Vector2, center: bool = false) -> Label:
	var l := Label.new()
	l.text = text; l.position = pos; l.size = size
	UITheme.apply_font(l, UITheme.body_font(sz))
	l.add_theme_color_override("font_color", col)
	if center: l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	parent.add_child(l)
	return l

func _flat(bg: Color, border: Color = Color.TRANSPARENT,
		bw: int = 0, radius: int = 0) -> StyleBoxFlat:
	var s := StyleBoxFlat.new()
	s.bg_color = bg; s.border_color = border
	s.border_width_left = bw; s.border_width_right = bw
	s.border_width_top = bw;  s.border_width_bottom = bw
	s.corner_radius_top_left = radius; s.corner_radius_top_right = radius
	s.corner_radius_bottom_left = radius; s.corner_radius_bottom_right = radius
	return s

# ── Asset utilities ───────────────────────────────────────────────────────────
func _try_load(path: String) -> Texture2D:
	if ResourceLoader.exists(path):
		return load(path) as Texture2D
	return null

func _scan_dir(dir_path: String, exts: Array) -> Array:
	var out: Array = []
	var d := DirAccess.open(dir_path)
	if not d:
		return out
	d.list_dir_begin()
	var name := d.get_next()
	while name != "":
		if not d.current_is_dir():
			var lower := name.to_lower()
			for e in exts:
				if lower.ends_with(e):
					out.append(dir_path + "/" + name)
					break
		name = d.get_next()
	d.list_dir_end()
	out.sort()
	return out

func _radial_glow_tex() -> Texture2D:
	var size := 128
	var img := Image.create(size, size, false, Image.FORMAT_RGBA8)
	var c := size * 0.5
	for y in range(size):
		for x in range(size):
			var dist := Vector2(x - c, y - c).length() / c
			var a := clampf(1.0 - dist, 0.0, 1.0)
			a = a * a
			img.set_pixel(x, y, Color(1, 1, 1, a))
	return ImageTexture.create_from_image(img)
