	if afterimage_time > 0.0:
		afterimage_time -= dt
		# If the actor died mid-cast, end the freeze immediately so nobody stalls.
		if afterimage_time <= 0.0 or not (afterimage_actor and is_instance_valid(afterimage_actor)):
			afterimage_time = 0.0
