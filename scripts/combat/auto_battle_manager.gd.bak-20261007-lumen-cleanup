func _clear_phoenix_actions() -> void:
	for cast in _phoenix_lances:
		if cast.get("effect") and is_instance_valid(cast["effect"]):
			cast["effect"].queue_free()
	_phoenix_lances.clear()
	for fx in _rekindle_vfx.values():
