; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="rpg autobattler"
run/main_scene="res://scenes/main_game.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1800
window/size/viewport_height=1200
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="rpg autobattler"

[editor]

"plugins/LPC Animated Sprite"={
"enabled": true,
"path": "res://addons/LPCAnimatedSprite/plugin.cfg"
}

[editor_plugins]

enabled=PackedStringArray("res://addons/addons/LPCAnimatedSprite/plugin.cfg")
